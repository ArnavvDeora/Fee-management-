<UserControl x:Class="SchoolFeeSystem.Presentation.Views.PayrollReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8F9FA">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <Button Command="{Binding GoBackCommand}" Content="⬅ Back to Payroll Dashboard" HorizontalAlignment="Left" Background="Transparent" Foreground="#7F8C8D" BorderThickness="0" FontWeight="Bold"/>
            <TextBlock Text="HR &amp; Payroll Reports" FontSize="28" FontWeight="Bold" Foreground="#2C3E50"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Select Month" FontSize="12" Foreground="#7F8C8D"/>
                    <DatePicker SelectedDate="{Binding SelectedMonth}" Width="140" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Filter Employee" FontSize="12" Foreground="#7F8C8D"/>
                    <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}" DisplayMemberPath="FullName" Width="200"/>
                </StackPanel>

                <Button Content="Generate Reports" Command="{Binding GenerateReportsCommand}" Background="#8E44AD" Foreground="White" BorderThickness="0" FontWeight="Bold" Height="30" Padding="20,0" VerticalAlignment="Bottom">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Padding" Value="15,8"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
            </TabControl.Resources>

            <TabItem Header="Attendance Logs">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Content="📥 Export CSV" Command="{Binding ExportAttendanceCsvCommand}" HorizontalAlignment="Right" Background="#27AE60" Foreground="White" BorderThickness="0" Padding="15,5" Margin="0,0,0,10"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding AttendanceList}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Employee" Binding="{Binding EmployeeName}" Width="*"/>
                            <DataGridTextColumn Header="Present" Binding="{Binding PresentDays}" Width="*"/>
                            <DataGridTextColumn Header="Absent" Binding="{Binding AbsentDays}" Width="*"/>
                            <DataGridTextColumn Header="Holidays" Binding="{Binding Holidays}" Width="*"/>
                            <DataGridTextColumn Header="Total Payable" Binding="{Binding TotalPayable}" Width="*" FontWeight="Bold"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Salary Sheets">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Content="📥 Export CSV" Command="{Binding ExportSalaryCsvCommand}" HorizontalAlignment="Right" Background="#27AE60" Foreground="White" BorderThickness="0" Padding="15,5" Margin="0,0,0,10"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding SalaryList}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Employee" Binding="{Binding EmployeeName}" Width="*"/>
                            <DataGridTextColumn Header="Base Salary" Binding="{Binding BaseSalary, StringFormat=C}" Width="*"/>
                            <DataGridTextColumn Header="Allowances" Binding="{Binding TotalAllowances, StringFormat=C}" Width="*" Foreground="Green"/>
                            <DataGridTextColumn Header="Deductions" Binding="{Binding TotalDeductions, StringFormat=C}" Width="*" Foreground="Red"/>
                            <DataGridTextColumn Header="Net Salary" Binding="{Binding NetSalary, StringFormat=C}" Width="*" FontWeight="Bold"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>