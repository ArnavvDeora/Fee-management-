<UserControl x:Class="SchoolFeeSystem.Presentation.Views.StaffDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1100" Background="#F8F9FA">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,5,0,20"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditMode}" Value="False">
                    <Setter Property="Background" Value="#F9F9F9"/>
                    <Setter Property="IsReadOnly" Value="True"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="IsReadOnly" Value="False"/>
                    <Setter Property="BorderBrush" Value="#3498DB"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="70" Height="70" CornerRadius="35" Background="#2C3E50" Margin="0,0,20,0">
                    <TextBlock Text="{Binding SelectedEmployee.FirstName[0]}" FontSize="32" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedEmployee.FullName}" FontSize="24" FontWeight="Bold" Foreground="#2C3E50"/>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#E8F6F3" CornerRadius="4" Padding="8,4" Margin="0,5,10,0">
                            <TextBlock Text="Active" Foreground="#27AE60" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <TextBlock Text="{Binding SelectedEmployee.Designation}" Foreground="#7F8C8D" FontSize="14" VerticalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⬅ Back" Command="{Binding GoBackCommand}" Background="Transparent" Foreground="#7F8C8D" FontWeight="Bold" BorderThickness="0" Margin="0,0,15,0"/>

                    <Button Command="{Binding ToggleEditModeCommand}" Height="40" Padding="20,0" BorderThickness="0" FontWeight="Bold">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#3498DB"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Content" Value="✏ Edit Profile"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                        <Setter Property="Background" Value="#27AE60"/>
                                        <Setter Property="Content" Value="💾 Save Changes"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,30,0">

                    <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="👤 Personal Information" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="First Name" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding SelectedEmployee.FirstName}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Last Name" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding SelectedEmployee.LastName}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="📞 Contact Details" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Email Address" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding SelectedEmployee.Email}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Phone Number" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding SelectedEmployee.PhoneNumber}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="10" Padding="20">
                        <StackPanel>
                            <TextBlock Text="💼 Employment Information" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Designation" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding SelectedEmployee.Designation}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Department" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding SelectedEmployee.Department}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1">

                    <Border Background="#2C3E50" CornerRadius="10" Padding="25" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Current Base Salary" Foreground="White" Opacity="0.7" FontSize="14"/>
                            <TextBlock Text="{Binding SelectedEmployee.BaseSalary, StringFormat={}{0:C0}}" Foreground="White" FontWeight="Bold" FontSize="32" Margin="0,5,0,20"/>

                            <Button Command="{Binding ShowIncrementCommand}" Content="⚡ Increment Salary" 
                                    Background="#F39C12" Foreground="White" FontWeight="Bold" BorderThickness="0" Height="40">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="5"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="10" Padding="20" BorderBrush="#F39C12" BorderThickness="2"
                            Visibility="{Binding IsIncrementVisible, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Apply Salary Increment" FontWeight="Bold" Foreground="#F39C12" Margin="0,0,0,10"/>
                            <TextBlock Text="Enter amount to add (₹):" Foreground="#7F8C8D" Margin="0,0,0,5"/>

                            <TextBox Text="{Binding IncrementAmount}" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" IsReadOnly="False" Padding="10"/>

                            <Button Command="{Binding ApplyIncrementCommand}" Content="Confirm Increment" 
                                    Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0" Height="35" Margin="0,10,0,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="5"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>