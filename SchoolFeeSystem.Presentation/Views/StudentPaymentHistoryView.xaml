<UserControl x:Class="SchoolFeeSystem.Presentation.Views.StudentPaymentHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2196F3" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="← Back" 
                        Command="{Binding GoBackCommand}"
                        Background="Transparent" Foreground="White"
                        BorderThickness="0" FontSize="14" FontWeight="Bold"
                        Padding="15,8" Cursor="Hand"/>

                <TextBlock Grid.Column="1" Text="📜 Student Payment History" 
                          FontSize="24" FontWeight="Bold" Foreground="White"
                          VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Filters Section -->
        <Border Grid.Row="1" Background="White" Padding="20" 
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Student Selection -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="👤 Select Student:" 
                              VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"/>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Search box -->
                        <TextBox Grid.Row="0" 
                                 Text="{Binding StudentSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,5" FontSize="12"
                                 BorderBrush="#BDBDBD" BorderThickness="1"
                                 Margin="0,0,0,2">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <VisualBrush Stretch="None" AlignmentX="Left">
                                                        <VisualBrush.Visual>
                                                            <TextBlock Text="🔍 Search students..." 
                                                                      Foreground="#9E9E9E" 
                                                                      Margin="5,0,0,0"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- Student dropdown -->
                        <ComboBox Grid.Row="1"
                                  ItemsSource="{Binding FilteredStudentNames}"
                                  SelectedItem="{Binding SelectedStudent}"
                                  Padding="8,5" FontSize="14"
                                  BorderBrush="#2196F3" BorderThickness="2"/>
                    </Grid>

                    <!-- Date Range -->
                    <TextBlock Grid.Column="3" Text="📅 Start Date:" 
                              VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"/>
                    <DatePicker Grid.Column="4" 
                               SelectedDate="{Binding StartDate}"
                               Padding="8,5" FontSize="14"
                               BorderBrush="#2196F3" BorderThickness="2"/>

                    <TextBlock Grid.Column="6" Text="📅 End Date:" 
                              VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"/>
                    <DatePicker Grid.Column="7" 
                               SelectedDate="{Binding EndDate}"
                               Padding="8,5" FontSize="14"
                               BorderBrush="#2196F3" BorderThickness="2"/>
                </Grid>

                <!-- Statistics -->
                <Border Grid.Row="2" Background="#E3F2FD" Padding="15" CornerRadius="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Student" FontSize="11" Foreground="#757575"/>
                            <TextBlock Text="{Binding SelectedStudent}" 
                                      FontSize="16" FontWeight="Bold" 
                                      Foreground="#2196F3"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Total Transactions" FontSize="11" Foreground="#757575"/>
                            <TextBlock Text="{Binding TotalTransactions}" 
                                      FontSize="16" FontWeight="Bold" 
                                      Foreground="#4CAF50"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Total Amount Paid" FontSize="11" Foreground="#757575"/>
                            <TextBlock FontSize="16" FontWeight="Bold" Foreground="#4CAF50">
                                <Run Text="₹"/>
                                <Run Text="{Binding TotalAmountPaid, StringFormat=N2}"/>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Current Balance" FontSize="11" Foreground="#757575"/>
                            <TextBlock FontSize="16" FontWeight="Bold" Foreground="#F44336">
                                <Run Text="₹"/>
                                <Run Text="{Binding CurrentBalance, StringFormat=N2}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="2" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Transaction List -->
            <Border Grid.Row="0" Background="White" CornerRadius="8" 
                   BorderBrush="#E0E0E0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#2196F3" Padding="15,10">
                        <TextBlock Text="💳 Payment Transactions" 
                                  FontSize="16" FontWeight="Bold" Foreground="White"/>
                    </Border>

                    <DataGrid Grid.Row="1" 
                             ItemsSource="{Binding PaymentHistory}"
                             SelectedItem="{Binding SelectedTransaction}"
                             AutoGenerateColumns="True"
                             IsReadOnly="True"
                             SelectionMode="Single"
                             GridLinesVisibility="Horizontal"
                             HeadersVisibility="Column"
                             CanUserAddRows="False"
                             CanUserDeleteRows="False"
                             CanUserResizeRows="False"
                             AlternationCount="2"
                             Margin="0">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="AlternationIndex" Value="1">
                                        <Setter Property="Background" Value="#F5F5F5"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E3F2FD"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#BBDEFB"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" 
                       HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="🖨️ Print Receipt" 
                       Command="{Binding PrintReceiptCommand}"
                       Background="#FF9800" Foreground="White"
                       Padding="20,10" FontSize="14" FontWeight="Bold"
                       BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>

                <Button Content="📄 Generate Receipt" 
                       Command="{Binding GenerateReceiptCommand}"
                       Background="#4CAF50" Foreground="White"
                       Padding="20,10" FontSize="14" FontWeight="Bold"
                       BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>

                <Button Content="📊 Export History" 
                       Command="{Binding ExportHistoryCommand}"
                       Background="#2196F3" Foreground="White"
                       Padding="20,10" FontSize="14" FontWeight="Bold"
                       BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
