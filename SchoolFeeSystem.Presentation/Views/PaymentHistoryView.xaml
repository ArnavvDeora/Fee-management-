<UserControl x:Class="SchoolFeeSystem.Presentation.Views.PaymentHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="#F5F5F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2196F3" CornerRadius="8" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="💳 Payment History" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="White"/>
                    <TextBlock Text="View and track all payment transactions" 
                               FontSize="14" 
                               Foreground="#E3F2FD" 
                               Margin="0,5,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" 
                        Content="← Back to Dashboard" 
                        Command="{Binding GoBackCommand}"
                        Background="#1976D2"
                        Foreground="White"
                        Padding="20,10"
                        FontSize="14"
                        BorderThickness="0"
                        Cursor="Hand"
                        VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="6" 
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1565C0"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Summary Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Paid -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,10,0"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="💰 Total Paid" FontSize="14" Foreground="#666"/>
                    <TextBlock Text="{Binding TotalPaidAmount, FallbackValue='₹0.00'}" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="#4CAF50" 
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Total Fines -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20" Margin="5,0"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="⚠️ Total Fines" FontSize="14" Foreground="#666"/>
                    <TextBlock Text="{Binding TotalFineAmount, FallbackValue='₹0.00'}" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="#FF9800" 
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Pending Amount -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="20" Margin="10,0,0,0"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="📊 Pending Amount" FontSize="14" Foreground="#666"/>
                    <TextBlock Text="{Binding PendingAmount, FallbackValue='₹0.00'}" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="#F44336" 
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Filter Section -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Text="🔍 Filter Options" 
                           FontSize="18" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,15"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Student ID Filter -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Student ID" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding StudentIdFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10"
                                 FontSize="14"
                                 BorderBrush="#BDBDBD"
                                 BorderThickness="1"/>
                    </StackPanel>

                    <!-- Student Name Filter -->
                    <StackPanel Grid.Column="1" Margin="5,0">
                        <TextBlock Text="Student Name" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding StudentNameFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10"
                                 FontSize="14"
                                 BorderBrush="#BDBDBD"
                                 BorderThickness="1"/>
                    </StackPanel>

                    <!-- Start Date -->
                    <StackPanel Grid.Column="2" Margin="5,0">
                        <TextBlock Text="Start Date" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding StartDate}"
                                   Padding="10"
                                   FontSize="14"
                                   BorderBrush="#BDBDBD"
                                   BorderThickness="1"/>
                    </StackPanel>

                    <!-- End Date -->
                    <StackPanel Grid.Column="3" Margin="10,0,0,0">
                        <TextBlock Text="End Date" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding EndDate}"
                                   Padding="10"
                                   FontSize="14"
                                   BorderBrush="#BDBDBD"
                                   BorderThickness="1"/>
                    </StackPanel>

                    <!-- Payment Type Filter -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,10,0">
                        <TextBlock Text="Payment Type" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding PaymentTypes}"
                                 SelectedItem="{Binding SelectedPaymentType}"
                                 Padding="10"
                                 FontSize="14"
                                 BorderBrush="#BDBDBD"
                                 BorderThickness="1"/>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" 
                               Orientation="Horizontal" 
                               HorizontalAlignment="Right"
                               Margin="5,10,0,0">
                        <Button Content="🔍 Search" 
                                Command="{Binding SearchByStudentCommand}"
                                Background="#2196F3"
                                Foreground="White"
                                Padding="20,10"
                                Margin="0,0,10,0"
                                FontSize="14"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="6" 
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                    VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1976D2"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="🗑️ Clear Filters" 
                                Command="{Binding ClearFiltersCommand}"
                                Background="#9E9E9E"
                                Foreground="White"
                                Padding="20,10"
                                Margin="0,0,10,0"
                                FontSize="14"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="6" 
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                    VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#757575"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="🔄 Refresh" 
                                Command="{Binding RefreshDataCommand}"
                                Background="#4CAF50"
                                Foreground="White"
                                Padding="20,10"
                                FontSize="14"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="6" 
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                    VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#388E3C"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Data Grid -->
        <TabControl Grid.Row="3">
            <!-- Payment History Tab -->
            <TabItem Header="📜 Payment History" FontSize="14" FontWeight="SemiBold">
                <Border Background="White" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1">
                    <DataGrid ItemsSource="{Binding PaymentHistoryView}"
                             AutoGenerateColumns="True"
                             IsReadOnly="True"
                             AlternatingRowBackground="#F5F5F5"
                             GridLinesVisibility="Horizontal"
                             HeadersVisibility="Column"
                             CanUserAddRows="False"
                             CanUserDeleteRows="False"
                             SelectionMode="Single"
                             FontSize="13"
                             Margin="10">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#2196F3"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="10"/>
                                <Setter Property="BorderBrush" Value="#1976D2"/>
                                <Setter Property="BorderThickness" Value="0,0,1,0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                    </DataGrid>
                </Border>
            </TabItem>

            <!-- Financial Summary Tab -->
            <TabItem Header="📊 Financial Summary" FontSize="14" FontWeight="SemiBold">
                <Border Background="White" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1">
                    <Grid>
                        <DataGrid ItemsSource="{Binding FinancialSummaryView}"
                                 AutoGenerateColumns="True"
                                 IsReadOnly="True"
                                 AlternatingRowBackground="#F5F5F5"
                                 GridLinesVisibility="Horizontal"
                                 HeadersVisibility="Column"
                                 CanUserAddRows="False"
                                 CanUserDeleteRows="False"
                                 SelectionMode="Single"
                                 FontSize="14"
                                 Margin="10">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#4CAF50"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="10"/>
                                    <Setter Property="BorderBrush" Value="#388E3C"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                        </DataGrid>

                        <TextBlock Text="Select a student to view financial summary" 
                                  FontSize="16"
                                  Foreground="#9E9E9E"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Export Button -->
        <Button Grid.Row="4" 
                Content="📥 Export to Excel" 
                Command="{Binding ExportToExcelCommand}"
                Background="#FF9800"
                Foreground="White"
                Padding="30,15"
                Margin="0,20,0,0"
                FontSize="16"
                FontWeight="SemiBold"
                BorderThickness="0"
                Cursor="Hand"
                HorizontalAlignment="Center">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        CornerRadius="8" 
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" 
                                                    VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F57C00"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="#BDBDBD"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</UserControl>