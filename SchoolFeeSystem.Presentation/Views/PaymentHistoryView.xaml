<UserControl x:Class="SchoolFeeSystem.Presentation.Views.PaymentHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="#F5F5F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2196F3" CornerRadius="8" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="💳 Payment History" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="White"/>
                    <TextBlock Text="View and track all payment transactions" 
                               FontSize="14" 
                               Foreground="#E3F2FD" 
                               Margin="0,5,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" 
                        Content="← Back to Dashboard" 
                        Command="{Binding GoBackCommand}"
                        Background="#1976D2"
                        Foreground="White"
                        Padding="20,10"
                        FontSize="14"
                        BorderThickness="0"
                        Cursor="Hand"
                        VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="6" 
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1565C0"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Summary Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Paid -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,10,0"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="💰 Total Paid" FontSize="14" Foreground="#666"/>
                    <TextBlock Text="{Binding TotalPaidAmount, FallbackValue='₹0.00'}" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="#4CAF50" 
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Total Fines -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20" Margin="5,0"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="⚠️ Total Fines" FontSize="14" Foreground="#666"/>
                    <TextBlock Text="{Binding TotalFineAmount, FallbackValue='₹0.00'}" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="#FF9800" 
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Pending Amount -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="20" Margin="10,0,0,0"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="📊 Pending Amount" FontSize="14" Foreground="#666"/>
                    <TextBlock Text="{Binding PendingAmount, FallbackValue='₹0.00'}" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="#F44336" 
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Filter Section -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Text="🔍 Filter Options" 
                           FontSize="18" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,15"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Student ID Filter -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Student ID" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding StudentIdFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10"
                                 FontSize="14"
                                 BorderBrush="#BDBDBD"
                                 BorderThickness="1"/>
                    </StackPanel>

                    <!-- Student Name Filter -->
                    <StackPanel Grid.Column="1" Margin="5,0">
                        <TextBlock Text="Student Name" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding StudentNameFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10"
                                 FontSize="14"
                                 BorderBrush="#BDBDBD"
                                 BorderThickness="1"/>
                    </StackPanel>

                    <!-- Start Date -->
                    <StackPanel Grid.Column="2" Margin="5,0">
                        <TextBlock Text="Start Date" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding StartDate}"
                                   Padding="10"
                                   FontSize="14"
                                   BorderBrush="#BDBDBD"
                                   BorderThickness="1"/>
                    </StackPanel>

                    <!-- End Date -->
                    <StackPanel Grid.Column="3" Margin="10,0,0,0">
                        <TextBlock Text="End Date" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding EndDate}"
                                   Padding="10"
                                   FontSize="14"
                                   BorderBrush="#BDBDBD"
                                   BorderThickness="1"/>
                    </StackPanel>

                    <!-- Payment Type Filter -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,10,0">
                        <TextBlock Text="Payment Type" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding PaymentTypes}"
                                 SelectedItem="{Binding SelectedPaymentType}"
                                 Padding="10"
                                 FontSize="14"
                                 BorderBrush="#BDBDBD"
                                 BorderThickness="1"/>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" 
                               Orientation="Horizontal" 
                               HorizontalAlignment="Right"
                               Margin="5,10,0,0">
                        <Button Content="🔍 Search" 
                                Command="{Binding SearchByStudentCommand}"
                                Background="#2196F3"
                                Foreground="White"
                                Padding="20,10"
                                Margin="0,0,10,0"
                                FontSize="14"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="6" 
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                    VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1976D2"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="🗑️ Clear Filters" 
                                Command="{Binding ClearFiltersCommand}"
                                Background="#9E9E9E"
                                Foreground="White"
                                Padding="20,10"
                                Margin="0,0,10,0"
                                FontSize="14"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="6" 
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                    VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#757575"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="🔄 Refresh" 
                                Command="{Binding RefreshDataCommand}"
                                Background="#4CAF50"
                                Foreground="White"
                                Padding="20,10"
                                FontSize="14"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="6" 
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                    VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#388E3C"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Data Grid — TabControl REMOVED.
             TabControl with hardcoded TabItem children + DataGrid.ItemsSource bindings
             causes "Items collection must be empty before using ItemsSource" because
             WPF's ConvertBackHelper tries to push the DataView back up through
             ItemCollection which already has children.
             Replaced with a plain Grid + ToggleButton tab bar + Visibility toggling. -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── Custom Tab Header Bar ── -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,0">

                <ToggleButton x:Name="BtnTabHistory"
                              Content="📜  Payment History"
                              IsChecked="True"
                              FontSize="14" FontWeight="SemiBold"
                              Padding="20,10"
                              Cursor="Hand"
                              BorderThickness="0">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Background"  Value="#E3F2FD"/>
                            <Setter Property="Foreground"  Value="#2196F3"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="8,8,0,0"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#2196F3"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#BBDEFB"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>

                <ToggleButton x:Name="BtnTabSummary"
                              Content="📊  Financial Summary"
                              IsChecked="False"
                              FontSize="14" FontWeight="SemiBold"
                              Padding="20,10"
                              Margin="4,0,0,0"
                              Cursor="Hand"
                              BorderThickness="0">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Background"  Value="#E8F5E9"/>
                            <Setter Property="Foreground"  Value="#4CAF50"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="8,8,0,0"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#4CAF50"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#C8E6C9"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>

            </StackPanel>

            <!-- ── Tab Content Area ── -->
            <Grid Grid.Row="1">

                <!-- ═══ PANEL 1: Payment History ═══ -->
                <Border Background="White" CornerRadius="0,8,8,8"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=BtnTabHistory}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <!-- DataGrid must NOT be wrapped in an outer ScrollViewer.
                         Doing so breaks the internal VirtualizingPanel viewport measurement,
                         which causes "Items collection must be empty before using ItemsSource"
                         whenever ItemsSource is rebound. The DataGrid has its own built-in scroll. -->
                    <DataGrid x:Name="PaymentHistoryGrid"
                                 SelectedItem="{Binding SelectedPaymentRow, Mode=TwoWay}"
                                 AutoGenerateColumns="False"
                                 IsReadOnly="True"
                                 AlternatingRowBackground="#F0F7FF"
                                 GridLinesVisibility="Horizontal"
                                 HeadersVisibility="Column"
                                 CanUserAddRows="False"
                                 CanUserDeleteRows="False"
                                 SelectionMode="Single"
                                 EnableRowVirtualization="False"
                                 EnableColumnVirtualization="False"
                                 VirtualizingPanel.IsVirtualizing="False"
                                 FontSize="13"
                                 Margin="10"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background"      Value="#2196F3"/>
                                <Setter Property="Foreground"      Value="White"/>
                                <Setter Property="FontWeight"      Value="Bold"/>
                                <Setter Property="Padding"         Value="10,8"/>
                                <Setter Property="BorderBrush"     Value="#1976D2"/>
                                <Setter Property="BorderThickness" Value="0,0,1,0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E3F2FD"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#BBDEFB"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <!-- ══ EXPLICIT COLUMNS ══════════════════════════════════════ -->

                        <DataGridTextColumn Header="👤 Student Name"
                                                Binding="{Binding [Student Name]}"
                                                Width="180"
                                                FontWeight="SemiBold">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#1565C0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="6,4"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="🪪 Student ID"
                                                Binding="{Binding [Student ID]}"
                                                Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="6,4"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="📅 Date"
                                                Binding="{Binding [Payment Date]}"
                                                Width="160">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="6,4"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="💰 Amount"
                                                Binding="{Binding [Amount]}"
                                                Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground"       Value="#2E7D32"/>
                                    <Setter Property="FontWeight"       Value="Bold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="6,4"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="💳 Mode"
                                                Binding="{Binding [Payment Mode]}"
                                                Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="6,4"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="📆 Quarter"
                                                Binding="{Binding [Quarter]}"
                                                Width="160">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="6,4"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="👨‍👧 Guardian"
                                                Binding="{Binding [Guardian]}"
                                                Width="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="6,4"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="📝 Remarks"
                                                Binding="{Binding [Remarks]}"
                                                Width="220">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextTrimming"      Value="CharacterEllipsis"/>
                                    <Setter Property="Padding" Value="6,4"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="Receipt" Width="110" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🖨️ Receipt"
                                                Tag="{Binding}"
                                                Command="{Binding DataContext.PrintReceiptForRowCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Background="#E8F5E9"
                                                Foreground="#2E7D32"
                                                BorderBrush="#A5D6A7"
                                                BorderThickness="1"
                                                Padding="6,4"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Cursor="Hand"
                                                Margin="4,2"
                                                HorizontalAlignment="Center">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="4"
                                                                        Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#C8E6C9"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid>
                </Border>

                <!-- ═══ PANEL 2: Financial Summary ═══ -->
                <Border Background="White" CornerRadius="0,8,8,8"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=BtnTabSummary}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <!-- DataGrid must NOT be wrapped in an outer ScrollViewer - it has built-in scrolling. -->
                        <DataGrid x:Name="FinancialSummaryGrid"
                                     AutoGenerateColumns="True"
                                     IsReadOnly="True"
                                     AlternatingRowBackground="#F1F8E9"
                                     GridLinesVisibility="Horizontal"
                                     HeadersVisibility="Column"
                                     CanUserAddRows="False"
                                     CanUserDeleteRows="False"
                                     SelectionMode="Single"
                                     EnableRowVirtualization="False"
                                     EnableColumnVirtualization="False"
                                     VirtualizingPanel.IsVirtualizing="False"
                                     FontSize="14"
                                     Margin="10"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.CanContentScroll="True">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background"      Value="#4CAF50"/>
                                    <Setter Property="Foreground"      Value="White"/>
                                    <Setter Property="FontWeight"      Value="Bold"/>
                                    <Setter Property="Padding"         Value="10"/>
                                    <Setter Property="BorderBrush"     Value="#388E3C"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                        </DataGrid>
                        <TextBlock Text="🔍  Type a student name or ID and click Search"
                                  FontSize="15"
                                  Foreground="#9E9E9E"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding FinancialSummaryEmptyVisibility}"/>
                    </Grid>
                </Border>

            </Grid>
        </Grid>

        <!-- Receipt Preview + Action Buttons -->
        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Receipt Preview — visible only when a payment row is selected -->
            <Border Grid.Row="0"
                    Background="White"
                    CornerRadius="8"
                    BorderBrush="#4CAF50"
                    BorderThickness="2"
                    Padding="24,18"
                    Margin="0,0,0,14"
                    Visibility="{Binding ReceiptPanelVisibility}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Receipt details -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="🧾  PAYMENT RECEIPT"
                                   FontSize="17" FontWeight="Bold"
                                   Foreground="#2196F3" Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Receipt No:"
                                       FontSize="12" Foreground="#666" Margin="0,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding ReceiptNumber}"
                                       FontSize="12" FontWeight="SemiBold" Margin="0,2"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Date:"
                                       FontSize="12" Foreground="#666" Margin="0,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="3"
                                       Text="{Binding ReceiptDate}"
                                       FontSize="12" FontWeight="SemiBold" Margin="0,2"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Student:"
                                       FontSize="12" Foreground="#666" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{Binding ReceiptStudentName}"
                                       FontSize="12" FontWeight="SemiBold" Margin="0,2"/>

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Student ID:"
                                       FontSize="12" Foreground="#666" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="3"
                                       Text="{Binding ReceiptStudentId}"
                                       FontSize="12" FontWeight="SemiBold" Margin="0,2"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Payment Mode:"
                                       FontSize="12" Foreground="#666" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Text="{Binding ReceiptPaymentMode}"
                                       FontSize="12" FontWeight="SemiBold" Margin="0,2"/>

                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Amount Paid:"
                                       FontSize="12" Foreground="#666" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="3"
                                       Text="{Binding ReceiptAmount}"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="#4CAF50" Margin="0,2"/>
                        </Grid>

                        <TextBlock Text="{Binding ReceiptRemarks}"
                                   FontSize="11" Foreground="#888"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Print button inside receipt panel -->
                    <Button Grid.Column="1"
                            Content="🖨️ Print Receipt"
                            Command="{Binding PrintReceiptCommand}"
                            Background="#4CAF50"
                            Foreground="White"
                            Padding="18,10"
                            FontSize="13"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"
                            VerticalAlignment="Center"
                            Margin="20,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#388E3C"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Bottom action buttons -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="📥 Export to Excel"
                        Command="{Binding ExportToExcelCommand}"
                        Background="#FF9800"
                        Foreground="White"
                        Padding="30,15"
                        Margin="0,0,12,0"
                        FontSize="16"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F57C00"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#BDBDBD"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="🖨️ Print Selected Receipt"
                        Command="{Binding PrintReceiptCommand}"
                        Background="#4CAF50"
                        Foreground="White"
                        Padding="30,15"
                        FontSize="16"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#388E3C"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#BDBDBD"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>