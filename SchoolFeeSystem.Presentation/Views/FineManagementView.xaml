<UserControl x:Class="SchoolFeeSystem.Presentation.Views.FineManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:SchoolFeeSystem.Presentation.Converters"
             mc:Ignorable="d" d:DesignHeight="900" d:DesignWidth="1400"
             Background="#F5F5F5">

    <UserControl.Resources>

        <!-- Rounded button template shared across all buttons -->
        <ControlTemplate x:Key="RoundBtn" TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>

        <!-- ✅ ROOT FIX: Declare converter LOCALLY inside this UserControl.
             The XamlParseException "Provide value on StaticResourceExtension" at line 221
             was caused by {StaticResource NullToVisibilityConverter} trying to resolve
             against App.xaml before the Application resources were available at
             InitializeComponent() time. Declaring it here makes it self-contained. -->
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

    </UserControl.Resources>

    <!-- Outer ScrollViewer so all content is reachable on smaller screens -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- header             -->
                <RowDefinition Height="Auto"/>
                <!-- summary cards      -->
                <RowDefinition Height="Auto"/>
                <!-- filter + calc      -->
                <RowDefinition Height="Auto"/>
                <!-- live status banner -->
                <RowDefinition Height="500"/>
                <!-- data grid          -->
                <RowDefinition Height="Auto"/>
                <!-- action buttons     -->
            </Grid.RowDefinitions>

            <!-- ══════════════ HEADER ══════════════ -->
            <Border Grid.Row="0" Background="#FF9800" CornerRadius="8"
                    Padding="20" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="⚠️ Fine Management"
                                   FontSize="28" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Track, manage, and calculate late payment fines"
                                   FontSize="14" Foreground="#FFF3E0" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="← Back to Dashboard"
                            Command="{Binding GoBackCommand}"
                            Background="#F57C00" Foreground="White"
                            Padding="20,10" FontSize="14" BorderThickness="0" Cursor="Hand"
                            Template="{StaticResource RoundBtn}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ══════════════ SUMMARY CARDS ══════════════ -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="20"
                        Margin="0,0,10,0" BorderBrush="#E0E0E0" BorderThickness="2">
                    <StackPanel>
                        <TextBlock Text="💰 Total Fines" FontSize="14" Foreground="#666"/>
                        <TextBlock Text="{Binding TotalFinesAmount}" FontSize="24"
                                   FontWeight="Bold" Foreground="#FF9800" Margin="0,5,0,0"/>
                        <TextBlock Text="All time" FontSize="11" Foreground="#999" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20"
                        Margin="5,0" BorderBrush="#E0E0E0" BorderThickness="2">
                    <StackPanel>
                        <TextBlock Text="⏳ Pending Fines" FontSize="14" Foreground="#666"/>
                        <TextBlock Text="{Binding PendingFinesAmount}" FontSize="24"
                                   FontWeight="Bold" Foreground="#F44336" Margin="0,5,0,0"/>
                        <TextBlock FontSize="11" Foreground="#999" Margin="0,2,0,0">
                            <Run Text="{Binding PendingFinesCount}"/>
                            <Run Text=" students"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="20"
                        Margin="5,0" BorderBrush="#E0E0E0" BorderThickness="2">
                    <StackPanel>
                        <TextBlock Text="✅ Paid / Waived" FontSize="14" Foreground="#666"/>
                        <TextBlock Text="{Binding PaidFinesAmount}" FontSize="24"
                                   FontWeight="Bold" Foreground="#4CAF50" Margin="0,5,0,0"/>
                        <TextBlock Text="Collected" FontSize="11" Foreground="#999" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="White" CornerRadius="8" Padding="20"
                        Margin="10,0,0,0" BorderBrush="#E0E0E0" BorderThickness="2">
                    <StackPanel>
                        <TextBlock Text="👥 Students" FontSize="14" Foreground="#666"/>
                        <TextBlock Text="{Binding TotalStudentsWithFines}" FontSize="24"
                                   FontWeight="Bold" Foreground="#2196F3" Margin="0,5,0,0"/>
                        <TextBlock Text="with fines" FontSize="11" Foreground="#999" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══════════════ FILTER  +  CALCULATOR ══════════════ -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Filter panel -->
                <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="20"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="🔍 Filter Fines" FontSize="18"
                                   FontWeight="SemiBold" Margin="0,0,0,15"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Student ID / Name" FontSize="12"
                                           Foreground="#666" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding StudentSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8" FontSize="13"
                                         BorderBrush="#BDBDBD" BorderThickness="1"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="5,0">
                                <TextBlock Text="Department / Class" FontSize="12"
                                           Foreground="#666" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding Departments}"
                                          SelectedItem="{Binding DepartmentFilter}"
                                          Padding="10,8" FontSize="13"
                                          BorderBrush="#BDBDBD" BorderThickness="1"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="5,0,0,0">
                                <TextBlock Text="Fine Status" FontSize="12"
                                           Foreground="#666" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding FineStatusOptions}"
                                          SelectedItem="{Binding SelectedFineStatus}"
                                          Padding="10,8" FontSize="13"
                                          BorderBrush="#BDBDBD" BorderThickness="1"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                            <Button Content="🔍 Apply Filters"
                                    Command="{Binding ApplyFiltersCommand}"
                                    Background="#2196F3" Foreground="White"
                                    Padding="20,10" FontSize="14" BorderThickness="0" Cursor="Hand"
                                    Template="{StaticResource RoundBtn}" Margin="0,0,10,0"/>
                            <Button Content="🗑 Clear"
                                    Command="{Binding ClearFiltersCommand}"
                                    Background="#9E9E9E" Foreground="White"
                                    Padding="20,10" FontSize="14" BorderThickness="0" Cursor="Hand"
                                    Template="{StaticResource RoundBtn}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Fine Calculator -->
                <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="20"
                        BorderBrush="#FF9800" BorderThickness="2">
                    <StackPanel>
                        <TextBlock Text="🧮 Fine Calculator" FontSize="16"
                                   FontWeight="Bold" Foreground="#E65100" Margin="0,0,0,12"/>

                        <Border Background="#FFF3E0" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                            <TextBlock FontSize="11" Foreground="#BF360C" TextWrapping="Wrap">
                                <Run FontWeight="Bold">Fine Rules:</Run>
                                <Run Text=" Days 1–15: No fine. Days 16–end of Month 1: Rs 10/day. Month 2: Rs 20/day. Month 3+: Rs 750 flat/month."/>
                            </TextBlock>
                        </Border>

                        <TextBlock Text="Quarter Start Date" FontSize="12"
                                   Foreground="#666" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding QuarterStartDate}"
                                    Padding="8" FontSize="13" Margin="0,0,0,10"
                                    BorderBrush="#FF9800" BorderThickness="1"/>

                        <TextBlock Text="Calculate As Of (leave blank = today)"
                                   FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding CustomAsOfDate}"
                                    Padding="8" FontSize="13" Margin="0,0,0,12"
                                    BorderBrush="#BDBDBD" BorderThickness="1"/>

                        <Button Content="🧮 Calculate Fine"
                                Command="{Binding CalculateFineCommand}"
                                Background="#FF9800" Foreground="White"
                                Padding="15,10" FontSize="14" FontWeight="Bold"
                                BorderThickness="0" Cursor="Hand"
                                Template="{StaticResource RoundBtn}" Margin="0,0,0,10"/>

                        <!-- Result panel: hidden until CalculatedFine is non-empty.
                             Uses the LOCALLY declared converter — no App.xaml dependency. -->
                        <Border Background="#FFF8E1" CornerRadius="4" Padding="12"
                                Visibility="{Binding CalculatedFine,
                                             Converter={StaticResource NullToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Calculated Fine:" FontSize="12"
                                           Foreground="#666" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding CalculatedFine}"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="#FF9800" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding FineBreakdownText}"
                                           FontSize="11" Foreground="#5D4037"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══════════════ LIVE FINE STATUS BANNER ══════════════ -->
            <Border Grid.Row="3" Background="#FFF3E0" CornerRadius="6"
                    BorderBrush="#FF9800" BorderThickness="1"
                    Padding="16,10" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📅 Live Fine Status — " FontSize="13"
                                   FontWeight="Bold" Foreground="#E65100" VerticalAlignment="Center"/>
                        <TextBlock FontSize="13" Foreground="#5D4037"
                                   VerticalAlignment="Center" TextWrapping="Wrap">
                            <Run Text="Fines are calculated automatically every time a sheet loads."/>
                            <Run Text=" Grace period: first 15 days of each quarter."/>
                            <Run Text=" Month 1 (day 16–end): Rs 10/day · Month 2: Rs 20/day · Month 3+: Rs 750 flat."/>
                            <Run Text=" Only students with outstanding fees are charged."/>
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="1" Content="🔄 Refresh"
                            Command="{Binding RefreshDataCommand}"
                            Background="#FF9800" Foreground="White"
                            Padding="14,8" FontSize="13" BorderThickness="0" Cursor="Hand"
                            Template="{StaticResource RoundBtn}" VerticalAlignment="Center"
                            Margin="12,0,0,0"/>
                </Grid>
            </Border>

            <!-- ══════════════ DATA GRID ══════════════ -->
            <Border Grid.Row="4" Background="White" CornerRadius="8"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="📋 Fine Report — Live from Fee Collection Data"
                               FontSize="16" FontWeight="SemiBold"
                               Margin="20,16,20,8" Foreground="#333"/>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding FineReportView}"
                              AutoGenerateColumns="True"
                              IsReadOnly="True"
                              AlternatingRowBackground="#FFF3E0"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              EnableRowVirtualization="False"
                              EnableColumnVirtualization="False"
                              VirtualizingPanel.IsVirtualizing="False"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              FontSize="13" Margin="10,0,10,10">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background"      Value="#FF9800"/>
                                <Setter Property="Foreground"      Value="White"/>
                                <Setter Property="FontWeight"      Value="Bold"/>
                                <Setter Property="Padding"         Value="10"/>
                                <Setter Property="BorderBrush"     Value="#F57C00"/>
                                <Setter Property="BorderThickness" Value="0,0,1,0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding [Status]}" Value="Fine Applicable">
                                        <Setter Property="Background" Value="#FFEBEE"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding [Status]}" Value="No Fine">
                                        <Setter Property="Background" Value="#E8F5E9"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ══════════════ ACTION BUTTONS ══════════════ -->
            <StackPanel Grid.Row="5" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,20,0,20">
                <Button Content="📥 Export Report"
                        Command="{Binding ExportFineReportCommand}"
                        Background="#4CAF50" Foreground="White"
                        Padding="25,12" Margin="0,0,12,0"
                        FontSize="15" FontWeight="SemiBold"
                        BorderThickness="0" Cursor="Hand"
                        Template="{StaticResource RoundBtn}"/>
                <Button Content="📧 Send Reminders"
                        Command="{Binding SendFineRemindersCommand}"
                        Background="#9C27B0" Foreground="White"
                        Padding="25,12" Margin="0,0,12,0"
                        FontSize="15" FontWeight="SemiBold"
                        BorderThickness="0" Cursor="Hand"
                        Template="{StaticResource RoundBtn}"/>
                <Button Content="🔄 Refresh Data"
                        Command="{Binding RefreshDataCommand}"
                        Background="#2196F3" Foreground="White"
                        Padding="25,12" FontSize="15" FontWeight="SemiBold"
                        BorderThickness="0" Cursor="Hand"
                        Template="{StaticResource RoundBtn}"/>
            </StackPanel>

        </Grid>
    </ScrollViewer>
</UserControl>
