<UserControl x:Class="SchoolFeeSystem.Presentation.Views.AddStaffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1100" Background="#F8F9FA">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="⬅ Back" Command="{Binding GoBackCommand}" 
                    Background="Transparent" Foreground="#7F8C8D" FontWeight="Bold" BorderThickness="0" 
                    FontSize="18" Margin="0,0,15,0" VerticalAlignment="Center"/>
            <TextBlock Text="Staff Registration" FontSize="28" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
        </StackPanel>

        <TabControl Grid.Row="1" BorderThickness="0" Background="Transparent" Margin="0,10,0,0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="20,10"/>
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
            </TabControl.Resources>

            <TabItem Header="📝 Manual Entry">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <Border Background="White" CornerRadius="10" Padding="30">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" Color="#DDD" ShadowDepth="2" Opacity="0.3"/>
                        </Border.Effect>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,30,0">

                                <TextBlock Text="Personal Details" FontSize="18" FontWeight="Bold" Foreground="#3498DB" Margin="0,0,0,15" TextDecorations="Underline"/>
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="First Name *" FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding FirstName}" Padding="8" Margin="0,5,0,15"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="Last Name" FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding LastName}" Padding="8" Margin="0,5,0,15"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="4">
                                        <TextBlock Text="Father / Husband Name" FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding FatherName}" Padding="8" Margin="0,5,0,15"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0">
                                        <TextBlock Text="Date of Birth" FontWeight="SemiBold"/>
                                        <DatePicker SelectedDate="{Binding DateOfBirth}" Padding="8" Margin="0,5,0,15"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2">
                                        <TextBlock Text="Category" FontWeight="SemiBold"/>
                                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" Padding="8" Margin="0,5,0,15"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="4">
                                        <TextBlock Text="Marital Status" FontWeight="SemiBold"/>
                                        <ComboBox ItemsSource="{Binding MaritalStatuses}" SelectedItem="{Binding MaritalStatus}" Padding="8" Margin="0,5,0,15"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Text="Qualification" FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding Qualification}" Padding="8" Margin="0,5,0,15"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <TextBlock Text="Mobile No *" FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding Phone}" Padding="8" Margin="0,5,0,15"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="4">
                                        <TextBlock Text="Email" FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding Email}" Padding="8" Margin="0,5,0,15"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Address" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding Address}" Padding="8" Height="50" TextWrapping="Wrap" Margin="0,5,0,20"/>

                                <TextBlock Text="Official &amp; Government IDs" FontSize="18" FontWeight="Bold" Foreground="#3498DB" Margin="0,0,0,15" TextDecorations="Underline"/>
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="Designation" FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding Designation}" Padding="8" Margin="0,5,0,15"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="Department" FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding Department}" Padding="8" Margin="0,5,0,15"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="4">
                                        <TextBlock Text="Date of Joining" FontWeight="SemiBold"/>
                                        <DatePicker SelectedDate="{Binding JoiningDate}" Padding="8" Margin="0,5,0,15"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0">
                                        <TextBlock Text="Aadhar No" FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding AadharNumber}" Padding="8" Margin="0,5,0,15"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2">
                                        <TextBlock Text="PAN No" FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding PanNumber}" Padding="8" Margin="0,5,0,15"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Banking &amp; Salary" FontSize="18" FontWeight="Bold" Foreground="#3498DB" Margin="0,0,0,15" TextDecorations="Underline"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Basic Salary (₹)" FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding BaseSalary}" FontWeight="Bold" Padding="8" Margin="0,5,0,15"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Bank A/C No" FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding BankAccountNo}" Padding="8" Margin="0,5,0,15"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="IFSC Code" FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding IfscCode}" Padding="8" Margin="0,5,0,15"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="UAN / ESIC" FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding UanNumber}" Padding="8" Margin="0,5,0,15"/>
                                    </StackPanel>
                                </Grid>

                                <Button Content="💾 Save Staff Record" Command="{Binding SaveStaffCommand}" 
                                        Background="#27AE60" Foreground="White" FontWeight="Bold" Padding="15" Margin="0,20,0,0" BorderThickness="0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,20,0,0">
                                <Border Width="180" Height="200" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="4" Background="#F2F3F4">
                                    <Image Source="{Binding PhotoPreview}" Stretch="UniformToFill"/>
                                </Border>
                                <Button Content="📷 Upload Photo" Command="{Binding BrowsePhotoCommand}" 
                                        Width="180" Margin="0,10,0,0" Padding="10" Background="#3498DB" Foreground="White" FontWeight="Bold" BorderThickness="0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <TextBlock Text="Passport Size" HorizontalAlignment="Center" Foreground="Gray" FontSize="11" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="📂 Bulk Import via Excel">
                <Border Background="White" CornerRadius="10" Padding="40" Margin="0,10,0,0">
                    <StackPanel MaxWidth="700">
                        <TextBlock Text="Upload Excel File" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,10"/>
                        <TextBlock Text="Import multiple staff members at once using a CSV or Excel file." Foreground="#7F8C8D" Margin="0,0,0,20"/>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding FileName}" IsReadOnly="True" Padding="10" Background="#F9F9F9" BorderBrush="#E0E0E0"/>
                            <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseFileCommand}" 
                                    Padding="20,0" Margin="10,0,0,0" Background="#3498DB" Foreground="White" BorderThickness="0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <Button Content="📥 Import Data" Command="{Binding ImportExcelCommand}" 
                                Height="50" Background="#2C3E50" Foreground="White" FontWeight="Bold" FontSize="16" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Border Background="#ECF0F1" CornerRadius="6" Padding="15" Margin="0,30,0,0">
                            <StackPanel>
                                <TextBlock Text="ℹ Required Excel Column Format (Order Matters):" FontWeight="Bold" Margin="0,0,0,10"/>
                                <TextBlock Text="1. Name | 2. Father Name | 3. DOB | 4. Aadhar | 5. PAN" FontFamily="Consolas"/>
                                <TextBlock Text="6. Address | 7. Mobile | 8. Category | 9. Qualification" FontFamily="Consolas"/>
                                <TextBlock Text="10. Designation | 11. Department | 12. Basic Salary" FontFamily="Consolas"/>
                                <TextBlock Text="13. Bank A/C | 14. IFSC | 15. UAN | 16. Date of Joining" FontFamily="Consolas"/>
                                <TextBlock Text="17. Marital Status" FontFamily="Consolas"/>
                                <TextBlock Text="* Row 1 should be headers. Data starts from Row 2." FontSize="11" Foreground="Red" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>