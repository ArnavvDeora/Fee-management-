<UserControl x:Class="SchoolFeeSystem.Presentation.Views.ClassView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2196F3" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="← Back" 
                        Command="{Binding GoBackCommand}"/>

                <TextBlock Grid.Column="1" Text="📚 Manage Classes" 
                          FontSize="24" FontWeight="Bold" Foreground="White"
                          VerticalAlignment="Center" HorizontalAlignment="Center"/>

                <Button Grid.Column="2" Content="💾 Save Changes"
                        Command="{Binding SaveChangesCommand}"
                        Background="#4CAF50" Foreground="White"
                        Padding="15,8" FontWeight="Bold" BorderThickness="0"
                        Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Controls -->
        <Border Grid.Row="1" Background="White" Padding="20" 
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 1: Sheet Selection and Search -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="📋 Select Sheet:" 
                              VerticalAlignment="Center" FontWeight="SemiBold"/>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Search box for sheets -->
                        <TextBox Grid.Row="0" 
                                 Text="{Binding SheetSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,5" FontSize="12"
                                 BorderBrush="#BDBDBD" BorderThickness="1"
                                 Margin="0,0,0,2">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <VisualBrush Stretch="None" AlignmentX="Left">
                                                        <VisualBrush.Visual>
                                                            <TextBlock Text="🔍 Search sheets..." 
                                                                      Foreground="#9E9E9E" 
                                                                      Margin="5,0,0,0"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <ComboBox Grid.Row="1"
                                  ItemsSource="{Binding FilteredSheetNames}"
                                  SelectedItem="{Binding SelectedSheet}"
                                  Padding="8,5" FontSize="14"
                                  BorderBrush="#2196F3" BorderThickness="2"/>
                    </Grid>

                    <TextBlock Grid.Column="3" Text="🔍 Search Data:" 
                              VerticalAlignment="Center" FontWeight="SemiBold"/>

                    <TextBox Grid.Column="4"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,5" FontSize="14"
                             BorderBrush="#2196F3" BorderThickness="2"/>

                    <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="10,0,0,0">
                        <Button Content="🔍 Search" Command="{Binding SearchCommand}"
                               Padding="12,8" Margin="0,0,5,0"
                               Background="#2196F3" Foreground="White"
                               BorderThickness="0" Cursor="Hand"/>
                        <Button Content="✖ Clear" Command="{Binding ClearSearchCommand}"
                               Padding="12,8"
                               Background="#757575" Foreground="White"
                               BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Row Operations -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Content="➕ Add Row" Command="{Binding AddRowCommand}"
                               Padding="12,8" Margin="0,0,5,0"
                               Background="#4CAF50" Foreground="White"
                               BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>

                        <Button Content="🗑 Delete Row" Command="{Binding DeleteSelectedRowCommand}"
                               Padding="12,8"
                               Background="#F44336" Foreground="White"
                               BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Data Grid -->
        <Border Grid.Row="2" Background="White" Margin="20" CornerRadius="8"
               BorderBrush="#E0E0E0" BorderThickness="1">
            <DataGrid ItemsSource="{Binding CsvTableView}"
                     SelectedItem="{Binding SelectedRow}"
                     AutoGenerateColumns="True"
                     IsReadOnly="False"
                     SelectionMode="Single"
                     GridLinesVisibility="All"
                     HeadersVisibility="Column"
                     CanUserAddRows="False"
                     CanUserDeleteRows="False"
                     AlternationCount="2"
                     Margin="10">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="AlternationIndex" Value="0">
                                <Setter Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="AlternationIndex" Value="1">
                                <Setter Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E3F2FD"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#BBDEFB"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Border>

        <!-- Update Cell Panel -->
        <Border Grid.Row="3" Background="White" Padding="20"
               BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="📝 Update Cell -" 
                          VerticalAlignment="Center" FontWeight="SemiBold"/>

                <ComboBox Grid.Column="1"
                         ItemsSource="{Binding Columns}"
                         SelectedItem="{Binding SelectedColumn}"
                         Padding="8,5" FontSize="14"
                         BorderBrush="#FF9800" BorderThickness="2"/>

                <TextBlock Grid.Column="3" Text="New Value:" 
                          VerticalAlignment="Center" FontWeight="SemiBold"/>

                <TextBox Grid.Column="4"
                        Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}"
                        Padding="8,5" FontSize="14"
                        BorderBrush="#FF9800" BorderThickness="2"/>

                <Button Grid.Column="6" Content="✅ Update" 
                       Command="{Binding UpdateCellCommand}"
                       Padding="15,8"
                       Background="#FF9800" Foreground="White"
                       BorderThickness="0" Cursor="Hand" FontWeight="Bold"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>