<UserControl x:Class="SchoolFeeSystem.Presentation.Views.ClassView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:SchoolFeeSystem.Presentation.Converters">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="BackButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="DepartmentCardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style for Year Buttons -->
        <Style x:Key="YearButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F5F5F5">

        <!-- DEPARTMENT SELECTION VIEW -->
        <Grid x:Name="DepartmentView" Visibility="{Binding IsDepartmentViewMode, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#2196F3" Padding="20,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="← Back to Dashboard" 
                            Command="{Binding GoBackCommand}"
                            Style="{StaticResource BackButtonStyle}"/>

                    <TextBlock Grid.Column="1" Text="📚 Manage Classes - Select Department" 
                              FontSize="28" FontWeight="Bold" Foreground="White"
                              VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Department Cards -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <WrapPanel Margin="40,30" HorizontalAlignment="Center">

                    <!-- Mechanical Engineering - 4 Years -->
                    <Border Background="#FF5722" CornerRadius="12" Margin="15" 
                            Width="320" Height="220">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="15" ShadowDepth="3"/>
                        </Border.Effect>
                        <Button Command="{Binding SelectDepartmentCommand}" 
                                CommandParameter="ME"
                                Style="{StaticResource DepartmentCardButton}">
                            <StackPanel>
                                <TextBlock Text="⚙️" FontSize="80" HorizontalAlignment="Center" Margin="0,20,0,10"/>
                                <TextBlock Text="Mechanical Engineering" FontSize="20" FontWeight="Bold" 
                                          Foreground="White" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                <TextBlock Text="4 Years" FontSize="14" Foreground="#FFE0B2" 
                                          HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- Mechatronics Engineering - 3 Years -->
                    <Border Background="#3F51B5" CornerRadius="12" Margin="15" 
                            Width="320" Height="220">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="15" ShadowDepth="3"/>
                        </Border.Effect>
                        <Button Command="{Binding SelectDepartmentCommand}" 
                                CommandParameter="MECHATRONICS"
                                Style="{StaticResource DepartmentCardButton}">
                            <StackPanel>
                                <TextBlock Text="🤖" FontSize="80" HorizontalAlignment="Center" Margin="0,20,0,10"/>
                                <TextBlock Text="Mechatronics Engineering" FontSize="20" FontWeight="Bold" 
                                          Foreground="White" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                <TextBlock Text="3 Years" FontSize="14" Foreground="#C5CAE9" 
                                          HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- Electrical Engineering - 3 Years -->
                    <Border Background="#FFC107" CornerRadius="12" Margin="15" 
                            Width="320" Height="220">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="15" ShadowDepth="3"/>
                        </Border.Effect>
                        <Button Command="{Binding SelectDepartmentCommand}" 
                                CommandParameter="EE"
                                Style="{StaticResource DepartmentCardButton}">
                            <StackPanel>
                                <TextBlock Text="⚡" FontSize="80" HorizontalAlignment="Center" Margin="0,20,0,10"/>
                                <TextBlock Text="Electrical Engineering" FontSize="20" FontWeight="Bold" 
                                          Foreground="White" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                <TextBlock Text="3 Years" FontSize="14" Foreground="#FFF9C4" 
                                          HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- Computer Science - 3 Years -->
                    <Border Background="#4CAF50" CornerRadius="12" Margin="15" 
                            Width="320" Height="220">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="15" ShadowDepth="3"/>
                        </Border.Effect>
                        <Button Command="{Binding SelectDepartmentCommand}" 
                                CommandParameter="CSE"
                                Style="{StaticResource DepartmentCardButton}">
                            <StackPanel>
                                <TextBlock Text="💻" FontSize="80" HorizontalAlignment="Center" Margin="0,20,0,10"/>
                                <TextBlock Text="Computer Science and Engineering" FontSize="18" FontWeight="Bold" 
                                          Foreground="White" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                <TextBlock Text="3 Years" FontSize="14" Foreground="#C8E6C9" 
                                          HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- Miscellaneous -->
                    <Border Background="#9C27B0" CornerRadius="12" Margin="15" 
                            Width="320" Height="220">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="15" ShadowDepth="3"/>
                        </Border.Effect>
                        <Button Command="{Binding SelectDepartmentCommand}" 
                                CommandParameter="MISC"
                                Style="{StaticResource DepartmentCardButton}">
                            <StackPanel>
                                <TextBlock Text="📚" FontSize="80" HorizontalAlignment="Center" Margin="0,20,0,10"/>
                                <TextBlock Text="Miscellaneous Courses" FontSize="20" FontWeight="Bold" 
                                          Foreground="White" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                <TextBlock Text="Other Programs" FontSize="14" Foreground="#E1BEE7" 
                                          HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- Pass-outs -->
                    <Border Background="#607D8B" CornerRadius="12" Margin="15" 
                            Width="320" Height="220">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="15" ShadowDepth="3"/>
                        </Border.Effect>
                        <Button Command="{Binding SelectDepartmentCommand}" 
                                CommandParameter="PASSOUT"
                                Style="{StaticResource DepartmentCardButton}">
                            <StackPanel>
                                <TextBlock Text="🎓" FontSize="80" HorizontalAlignment="Center" Margin="0,20,0,10"/>
                                <TextBlock Text="Pass-outs / Graduates" FontSize="20" FontWeight="Bold" 
                                          Foreground="White" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                <TextBlock Text="Historical Data" FontSize="14" Foreground="#CFD8DC" 
                                          HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Button>
                    </Border>

                </WrapPanel>
            </ScrollViewer>
        </Grid>

        <!-- YEAR & QUARTER SELECTION VIEW - DYNAMICALLY SHOWS YEARS -->
        <Grid x:Name="YearView" Visibility="{Binding IsYearViewMode, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#2196F3" Padding="20,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="← Back to Departments" 
                            Command="{Binding GoBackToDepartmentsCommand}"
                            Style="{StaticResource BackButtonStyle}"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding SelectedDepartment.Icon}" FontSize="32" 
                                  VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding SelectedDepartment.Name}" 
                                  FontSize="28" FontWeight="Bold" Foreground="White"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Year & Quarter Selection -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="40,30">

                    <!-- Year Buttons - DYNAMICALLY GENERATED -->
                    <TextBlock Text="Select Academic Year:" FontSize="22" FontWeight="Bold" 
                              Margin="0,0,0,20" HorizontalAlignment="Center"/>

                    <!-- Use ItemsControl to dynamically show only available years -->
                    <ItemsControl ItemsSource="{Binding AvailableYears}" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#2196F3" CornerRadius="8" Width="200" Height="100" Margin="10">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" Opacity="0.2" BlurRadius="10" ShadowDepth="2"/>
                                    </Border.Effect>
                                    <Button Command="{Binding DataContext.SelectYearCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource YearButtonStyle}">
                                        <TextBlock Text="{Binding}" FontSize="24" FontWeight="Bold" 
                                                  Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Quarter Selection -->
                    <TextBlock Text="Select Fee Quarter:" FontSize="22" FontWeight="Bold" 
                              Margin="0,40,0,20" HorizontalAlignment="Center"/>

                    <WrapPanel HorizontalAlignment="Center">
                        <Border Background="#4CAF50" CornerRadius="8" Margin="10" Width="200" Height="100">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.2" BlurRadius="10" ShadowDepth="2"/>
                            </Border.Effect>
                            <Button Command="{Binding SelectQuarterCommand}" CommandParameter="Aug-Oct"
                                   Style="{StaticResource DepartmentCardButton}">
                                <StackPanel>
                                    <TextBlock Text="🍂" FontSize="32" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Aug - Oct" FontSize="18" FontWeight="Bold" 
                                              Foreground="White" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>

                        <Border Background="#FF9800" CornerRadius="8" Margin="10" Width="200" Height="100">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.2" BlurRadius="10" ShadowDepth="2"/>
                            </Border.Effect>
                            <Button Command="{Binding SelectQuarterCommand}" CommandParameter="Nov-Jan"
                                   Style="{StaticResource DepartmentCardButton}">
                                <StackPanel>
                                    <TextBlock Text="❄️" FontSize="32" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Nov - Jan" FontSize="18" FontWeight="Bold" 
                                              Foreground="White" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>

                        <Border Background="#E91E63" CornerRadius="8" Margin="10" Width="200" Height="100">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.2" BlurRadius="10" ShadowDepth="2"/>
                            </Border.Effect>
                            <Button Command="{Binding SelectQuarterCommand}" CommandParameter="Feb-Apr"
                                   Style="{StaticResource DepartmentCardButton}">
                                <StackPanel>
                                    <TextBlock Text="🌸" FontSize="32" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Feb - Apr" FontSize="18" FontWeight="Bold" 
                                              Foreground="White" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- DATA VIEW (Student List & Edit) - Same as before -->
        <Grid x:Name="DataView" Visibility="{Binding IsDataViewMode, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#2196F3" Padding="20,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="← Back" 
                            Command="{Binding GoBackToYearsCommand}"
                            Style="{StaticResource BackButtonStyle}"/>

                    <TextBlock Grid.Column="1" Text="{Binding CurrentViewTitle}" 
                              FontSize="22" FontWeight="Bold" Foreground="White"
                              VerticalAlignment="Center" HorizontalAlignment="Center"/>

                    <Button Grid.Column="2" Content="💾 Save Changes"
                            Command="{Binding SaveChangesCommand}"
                            Background="#4CAF50" Foreground="White"
                            Padding="15,8" FontWeight="Bold" BorderThickness="0"
                            Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Statistics Bar -->
            <Border Grid.Row="1" Background="White" Padding="20,15" 
                    BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="👥" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel>
                            <TextBlock Text="Total Students" FontSize="12" Foreground="#757575"/>
                            <TextBlock Text="{Binding TotalStudents}" FontSize="24" FontWeight="Bold" Foreground="#2196F3"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="⚠️" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel>
                            <TextBlock Text="Pending Fees" FontSize="12" Foreground="#757575"/>
                            <TextBlock Text="{Binding StudentsWithPendingFees}" FontSize="24" FontWeight="Bold" Foreground="#FF9800"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="💰" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel>
                            <TextBlock Text="Total Pending" FontSize="12" Foreground="#757575"/>
                            <TextBlock Text="{Binding TotalPendingFees, StringFormat=₹{0:N2}}" 
                                      FontSize="24" FontWeight="Bold" Foreground="#F44336"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="3" Content="⬆️ Promote to Next Year"
                            Command="{Binding PromoteStudentsToNextYearCommand}"
                            Background="#9C27B0" Foreground="White"
                            Padding="15,8" FontWeight="Bold" BorderThickness="0"
                            Cursor="Hand" Margin="20,0,0,0"/>
                </Grid>
            </Border>

            <!-- Controls -->
            <Border Grid.Row="2" Background="White" Padding="20" 
                    BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="400"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="🔍 Search:" 
                                  VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,15,0"/>

                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10,8" FontSize="14"
                                 BorderBrush="#2196F3" BorderThickness="2"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                            <Button Content="🔍 Search" Command="{Binding SearchCommand}"
                                   Padding="12,8" Margin="0,0,5,0"
                                   Background="#2196F3" Foreground="White"
                                   BorderThickness="0" Cursor="Hand"/>
                            <Button Content="✖ Clear" Command="{Binding ClearSearchCommand}"
                                   Padding="12,8"
                                   Background="#757575" Foreground="White"
                                   BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="➕ Add Student" Command="{Binding AddRowCommand}"
                               Padding="12,8" Margin="0,0,5,0"
                               Background="#4CAF50" Foreground="White"
                               BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>

                        <Button Content="🗑 Delete Student" Command="{Binding DeleteSelectedRowCommand}"
                               Padding="12,8"
                               Background="#F44336" Foreground="White"
                               BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Data Grid -->
            <Border Grid.Row="3" Background="White" Margin="20" CornerRadius="8"
                   BorderBrush="#E0E0E0" BorderThickness="1">
                <DataGrid ItemsSource="{Binding CsvTableView}"
                         SelectedItem="{Binding SelectedRow}"
                         AutoGenerateColumns="True"
                         IsReadOnly="False"
                         SelectionMode="Single"
                         GridLinesVisibility="All"
                         HeadersVisibility="Column"
                         CanUserAddRows="False"
                         CanUserDeleteRows="False"
                         AlternationCount="2"
                         Margin="10">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="AlternationIndex" Value="0">
                                    <Setter Property="Background" Value="White"/>
                                </Trigger>
                                <Trigger Property="AlternationIndex" Value="1">
                                    <Setter Property="Background" Value="#F5F5F5"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E3F2FD"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#BBDEFB"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </Border>

            <!-- Update Cell Panel -->
            <Border Grid.Row="4" Background="White" Padding="20"
                   BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="📝 Update Cell:" 
                              VerticalAlignment="Center" FontWeight="SemiBold"/>

                    <ComboBox Grid.Column="1"
                             ItemsSource="{Binding Columns}"
                             SelectedItem="{Binding SelectedColumn}"
                             Padding="8,5" FontSize="14"
                             BorderBrush="#FF9800" BorderThickness="2"/>

                    <TextBlock Grid.Column="3" Text="New Value:" 
                              VerticalAlignment="Center" FontWeight="SemiBold"/>

                    <TextBox Grid.Column="4"
                            Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}"
                            Padding="8,5" FontSize="14"
                            BorderBrush="#FF9800" BorderThickness="2"/>

                    <Button Grid.Column="6" Content="✅ Update" 
                           Command="{Binding UpdateCellCommand}"
                           Padding="15,8"
                           Background="#FF9800" Foreground="White"
                           BorderThickness="0" Cursor="Hand" FontWeight="Bold"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
