<UserControl x:Class="SchoolFeeSystem.Presentation.Views.StaffDirectoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1280"
             Background="#F8F9FA">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Shared column header style -->
        <Style x:Key="ColHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F2F6"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <!-- Shared cell style -->
        <Style x:Key="CellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <Button Content="⬅ Back" Command="{Binding GoBackCommand}" HorizontalAlignment="Left"
                    Background="Transparent" BorderThickness="0" Foreground="#7F8C8D" FontWeight="Bold" Cursor="Hand"/>
                <TextBlock Text="Staff Directory" FontSize="28" FontWeight="Bold" Foreground="#2C3E50" Margin="0,10,0,5"/>
                <TextBlock Text="Manage employee records, departments, and contact details." FontSize="14" Foreground="#7F8C8D"/>
            </StackPanel>

            <!-- Search + Buttons -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1" Height="45">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" VerticalAlignment="Center" Margin="15,0,10,0" Opacity="0.5"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent"
                             FontSize="14" Grid.Column="1"/>
                        <Button Content="Search" Command="{Binding PerformSearchCommand}" Grid.Column="2"
                            Margin="5" Background="#3498DB" Foreground="White" BorderThickness="0"
                            FontWeight="Bold" Padding="15,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ImportSsMasterCommand}"
                        Content="📥 Import SS Master" Height="45" Background="#8E44AD" Foreground="White"
                        FontSize="13" FontWeight="Bold" BorderThickness="0" Padding="18,0" Margin="0,0,10,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Command="{Binding AddNewStaffCommand}"
                        Content="+ Add New Staff" Height="45" Background="#27AE60" Foreground="White"
                        FontSize="14" FontWeight="Bold" BorderThickness="0" Padding="20,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Tabs -->
            <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="FontSize" Value="15"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="20,10"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#7F8C8D"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border Name="Border" BorderThickness="0,0,0,3" BorderBrush="Transparent" Margin="0,0,20,0">
                                        <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center"
                                                      HorizontalAlignment="Center" ContentSource="Header" Margin="10,2"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="BorderBrush" Value="#3498DB"/>
                                            <Setter Property="Foreground" Value="#2C3E50"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- ===== TEACHING STAFF TAB ===== -->
                <TabItem Header="Teaching Staff">
                    <DataGrid ItemsSource="{Binding TeachingStaff}" AutoGenerateColumns="False"
                          CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
                          Margin="0,20,0,0" BorderThickness="0" Background="White" RowBackground="White"
                          AlternatingRowBackground="#F8F9FA" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EEEEEE" MaxHeight="500"
                          ColumnHeaderStyle="{StaticResource ColHeaderStyle}"
                          CellStyle="{StaticResource CellStyle}">
                        <DataGrid.Columns>

                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="45"
                                            Foreground="#7F8C8D" FontWeight="Bold"/>

                            <DataGridTemplateColumn Header="Employee" Width="1.6*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="32" Height="32" CornerRadius="16" Background="#3498DB" Margin="0,0,10,0">
                                                <Grid>
                                                    <TextBlock Text="{Binding FirstName[0]}" Foreground="White" FontSize="14"
                                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Ellipse>
                                                        <Ellipse.Fill>
                                                            <ImageBrush ImageSource="{Binding Photo}" Stretch="UniformToFill"/>
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                </Grid>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FullName}" FontWeight="Bold" FontSize="12" Foreground="#2C3E50"/>
                                                <TextBlock Text="{Binding Email}" FontSize="10" Foreground="#7F8C8D"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="SS Code" Binding="{Binding SsCode}" Width="120" Foreground="#8E44AD" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Designation" Binding="{Binding Designation}" Width="*" Foreground="#34495E"/>
                            <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="120" Foreground="#34495E"/>
                            <DataGridTextColumn Header="Phone" Binding="{Binding PhoneNumber}" Width="110" Foreground="#34495E"/>
                            <DataGridTextColumn Header="Biometric ID" Binding="{Binding BiometricId}" Width="100" Foreground="#16A085" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Joined" Binding="{Binding JoiningDate, StringFormat=dd-MMM-yyyy}" Width="100" Foreground="#7F8C8D"/>

                            <DataGridTemplateColumn Header="Action" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="View Details"
                                            Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderBrush="#3498DB" BorderThickness="1"
                                            Foreground="#3498DB" FontWeight="SemiBold" FontSize="12"
                                            Padding="8,5" Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="4"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- ===== NON-TEACHING STAFF TAB ===== -->
                <TabItem Header="Non-Teaching Staff">
                    <DataGrid ItemsSource="{Binding NonTeachingStaff}" AutoGenerateColumns="False"
                          CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
                          Margin="0,20,0,0" BorderThickness="0" Background="White" RowBackground="White"
                          AlternatingRowBackground="#F8F9FA" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EEEEEE" MaxHeight="500"
                          ColumnHeaderStyle="{StaticResource ColHeaderStyle}"
                          CellStyle="{StaticResource CellStyle}">
                        <DataGrid.Columns>

                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="45"
                                            Foreground="#7F8C8D" FontWeight="Bold"/>

                            <DataGridTemplateColumn Header="Employee" Width="1.6*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="32" Height="32" CornerRadius="16" Background="#E67E22" Margin="0,0,10,0">
                                                <Grid>
                                                    <TextBlock Text="{Binding FirstName[0]}" Foreground="White" FontSize="14"
                                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Ellipse>
                                                        <Ellipse.Fill>
                                                            <ImageBrush ImageSource="{Binding Photo}" Stretch="UniformToFill"/>
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                </Grid>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FullName}" FontWeight="Bold" FontSize="12" Foreground="#2C3E50"/>
                                                <TextBlock Text="{Binding Email}" FontSize="10" Foreground="#7F8C8D"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="SS Code" Binding="{Binding SsCode}" Width="120" Foreground="#8E44AD" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Designation" Binding="{Binding Designation}" Width="*" Foreground="#34495E"/>
                            <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="120" Foreground="#34495E"/>
                            <DataGridTextColumn Header="Phone" Binding="{Binding PhoneNumber}" Width="110" Foreground="#34495E"/>
                            <DataGridTextColumn Header="Biometric ID" Binding="{Binding BiometricId}" Width="100" Foreground="#16A085" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Joined" Binding="{Binding JoiningDate, StringFormat=dd-MMM-yyyy}" Width="100" Foreground="#7F8C8D"/>

                            <DataGridTemplateColumn Header="Action" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="View Details"
                                            Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderBrush="#3498DB" BorderThickness="1"
                                            Foreground="#3498DB" FontWeight="SemiBold" FontSize="12"
                                            Padding="8,5" Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="4"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- ===== ADMIN STAFF TAB ===== -->
                <TabItem Header="Admin Staff">
                    <DataGrid ItemsSource="{Binding AdminStaff}" AutoGenerateColumns="False"
                          CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
                          Margin="0,20,0,0" BorderThickness="0" Background="White" RowBackground="White"
                          AlternatingRowBackground="#F8F9FA" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EEEEEE" MaxHeight="500"
                          ColumnHeaderStyle="{StaticResource ColHeaderStyle}"
                          CellStyle="{StaticResource CellStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="45" Foreground="#7F8C8D" FontWeight="Bold"/>
                            <DataGridTemplateColumn Header="Employee" Width="1.6*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="32" Height="32" CornerRadius="16" Background="#2980B9" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding FirstName[0]}" Foreground="White" FontSize="14"
                                                       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FullName}" FontWeight="Bold" FontSize="12" Foreground="#2C3E50"/>
                                                <TextBlock Text="{Binding Email}" FontSize="10" Foreground="#7F8C8D"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="SS Code" Binding="{Binding SsCode}" Width="120" Foreground="#8E44AD" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Designation" Binding="{Binding Designation}" Width="*" Foreground="#34495E"/>
                            <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="120" Foreground="#34495E"/>
                            <DataGridTextColumn Header="Phone" Binding="{Binding PhoneNumber}" Width="110" Foreground="#34495E"/>
                            <DataGridTextColumn Header="Biometric ID" Binding="{Binding BiometricId}" Width="100" Foreground="#16A085" FontWeight="SemiBold"/>
                            <DataGridTemplateColumn Header="Action" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="View Details"
                                            Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderBrush="#3498DB" BorderThickness="1"
                                            Foreground="#3498DB" FontWeight="SemiBold" FontSize="12"
                                            Padding="8,5" Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="4"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- ===== UNMATCHED BIOMETRICS TAB ===== -->
                <TabItem Header="{Binding FlaggedTabHeader}">
                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- banner -->
                            <RowDefinition Height="Auto"/>
                            <!-- search bar -->
                            <RowDefinition Height="Auto"/>
                            <!-- link panel -->
                            <RowDefinition Height="Auto"/>
                            <!-- add panel -->
                            <RowDefinition Height="*"/>
                            <!-- data grid -->
                        </Grid.RowDefinitions>

                        <!-- ── Banner ──────────────────────────────────────────────────── -->
                        <Border Grid.Row="0" Background="#FFF8E1" CornerRadius="8"
                            BorderBrush="#F39C12" BorderThickness="1" Padding="16,12" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠️" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel>
                                    <TextBlock Text="These people were found in an attendance file but could not be matched to any SS Master employee."
                                           FontWeight="SemiBold" FontSize="13" Foreground="#7D5A00"/>
                                    <TextBlock FontSize="12" Foreground="#7D5A00" Margin="0,2,0,0">
                                    <Run Text="Click "/>
                                    <Run Text="Link to Employee" FontWeight="Bold"/>
                                    <Run Text=" to tell the system which person they really are. Or click "/>
                                    <Run Text="Add to DB" FontWeight="Bold"/>
                                    <Run Text=" to register them as a new employee right now. Once linked or added, future imports will match automatically by Biometric ID."/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ── Search bar for Unmatched tab ───────────────────────────── -->
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="380"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="White" CornerRadius="8"
                                BorderBrush="#E0E0E0" BorderThickness="1" Height="40">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🔍" VerticalAlignment="Center" Margin="12,0,8,0" Opacity="0.5"/>
                                    <TextBox Grid.Column="1"
                                         Text="{Binding UnmatchedSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center" BorderThickness="0"
                                         Background="Transparent" FontSize="13"
                                         Padding="0,0,8,0">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding SearchUnmatchedCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                </Grid>
                            </Border>

                            <Button Grid.Column="1" Content="Search" Command="{Binding SearchUnmatchedCommand}"
                                Height="40" Padding="18,0" Margin="8,0,0,0"
                                Background="#3498DB" Foreground="White"
                                BorderThickness="0" FontWeight="Bold" FontSize="13">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Grid.Column="2" Content="✕ Clear" Command="{Binding ClearUnmatchedSearchCommand}"
                                Height="40" Padding="14,0" Margin="8,0,0,0"
                                Background="Transparent" BorderBrush="#BDC3C7" BorderThickness="1"
                                Foreground="#7F8C8D" FontWeight="SemiBold" FontSize="13">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <!-- ── Inline Link Panel ───────────────────────────────────────── -->
                        <Border Grid.Row="2"
                            Visibility="{Binding IsLinkDialogOpen, Converter={StaticResource BoolToVisConverter}}"
                            Background="#EBF5FB" CornerRadius="10" BorderBrush="#2E86C1"
                            BorderThickness="1" Padding="20,16" Margin="0,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="🔗  Link Biometric Entry to Employee" FontSize="15"
                                           FontWeight="Bold" Foreground="#1A5276" VerticalAlignment="Center"/>
                                    <Border Background="#2E86C1" CornerRadius="4" Padding="10,3" Margin="16,0,0,0">
                                        <TextBlock Text="{Binding SelectedFlaggedEntry.DisplayLabel}"
                                               FontSize="12" Foreground="White" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>

                                <!-- Search box + employee list -->
                                <Grid Grid.Row="1" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="320"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="Search employees:" FontSize="12"
                                               Foreground="#1A5276" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <Border Background="White" CornerRadius="6"
                                            BorderBrush="#AED6F1" BorderThickness="1" Height="36">
                                            <TextBox Text="{Binding LinkSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0" Background="Transparent"
                                                 VerticalContentAlignment="Center" Padding="10,0" FontSize="13">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Return" Command="{Binding FilterLinkEmployeesCommand}"/>
                                                </TextBox.InputBindings>
                                            </TextBox>
                                        </Border>
                                        <Button Content="🔍 Filter" Command="{Binding FilterLinkEmployeesCommand}"
                                            Margin="0,6,0,0" Height="32" Background="#2E86C1" Foreground="White"
                                            BorderThickness="0" FontWeight="Bold">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="5"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Select the correct employee:" FontSize="12"
                                               Foreground="#1A5276" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <Border Background="White" CornerRadius="6"
                                            BorderBrush="#AED6F1" BorderThickness="1" MaxHeight="180">
                                            <ListBox ItemsSource="{Binding LinkEmployeeList}"
                                                 SelectedItem="{Binding SelectedLinkTarget}"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 BorderThickness="0" Background="Transparent">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="4,4">
                                                            <Border Width="28" Height="28" CornerRadius="14"
                                                                Background="#2E86C1" Margin="0,0,10,0">
                                                                <TextBlock Text="{Binding FirstName[0]}"
                                                                       Foreground="White" FontWeight="Bold"
                                                                       FontSize="13" HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                            </Border>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding FullName}"
                                                                       FontWeight="SemiBold" FontSize="13" Foreground="#2C3E50"/>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Designation}" FontSize="11" Foreground="#7F8C8D"/>
                                                                    <TextBlock Text=" · " FontSize="11" Foreground="#BDC3C7"/>
                                                                    <TextBlock Text="{Binding SsCode}" FontSize="11" Foreground="#8E44AD"/>
                                                                    <TextBlock Text=" · BioID: " FontSize="11" Foreground="#BDC3C7"/>
                                                                    <TextBlock Text="{Binding BiometricId}" FontSize="11" Foreground="#16A085"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                        <Setter Property="Padding" Value="4,2"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter Property="Background" Value="#D6EAF8"/>
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#EBF5FB"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                            </ListBox>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Confirm / Cancel -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Cancel" Command="{Binding CancelLinkCommand}"
                                        Height="36" Padding="20,0" Margin="0,0,10,0"
                                        Background="White" BorderBrush="#BDC3C7" BorderThickness="1"
                                        Foreground="#7F8C8D" FontWeight="Bold">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                    <Button Content="✅  Confirm Link" Command="{Binding ConfirmLinkCommand}"
                                        Height="36" Padding="20,0"
                                        Background="#27AE60" Foreground="White"
                                        BorderThickness="0" FontWeight="Bold">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ── ★ NEW: Add from Unmatched Panel ────────────────────────── -->
                        <Border Grid.Row="3"
                            Visibility="{Binding IsAddFromUnmatchedOpen, Converter={StaticResource BoolToVisConverter}}"
                            Background="White" CornerRadius="10" BorderBrush="#27AE60"
                            BorderThickness="2" Padding="25" Margin="0,0,0,14">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Color="#27AE60" Opacity="0.15" ShadowDepth="3"/>
                            </Border.Effect>
                            <StackPanel>

                                <!-- Panel header -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="➕ Add New Employee to Database"
                                           FontSize="17" FontWeight="Bold" Foreground="#27AE60"/>
                                    <Border Background="#EAFAF1" CornerRadius="4" Padding="8,3" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding AddSourceEntry.DisplayLabel}"
                                               Foreground="#27AE60" FontWeight="SemiBold" FontSize="13"/>
                                    </Border>
                                </StackPanel>

                                <TextBlock Foreground="#7F8C8D" FontSize="12" Margin="0,0,0,18">
                                Fill in the essential details below. The Biometric ID is pre-filled from the attendance file.
                                You can complete the remaining information (Aadhar, bank details, etc.) later via Staff Details.
                                </TextBlock>

                                <!-- Row 1: Name -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="First Name *" Foreground="#95A5A6" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding NewFirstName, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="9" BorderBrush="#E0E0E0" BorderThickness="1" FontSize="13"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="Last Name" Foreground="#95A5A6" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding NewLastName, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="9" BorderBrush="#E0E0E0" BorderThickness="1" FontSize="13"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Father / Husband Name" Foreground="#95A5A6" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding NewFatherName, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="9" BorderBrush="#E0E0E0" BorderThickness="1" FontSize="13"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 2: Designation / Department / Staff Type -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Designation *" Foreground="#95A5A6" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding NewDesignation, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="9" BorderBrush="#E0E0E0" BorderThickness="1" FontSize="13"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="Department *" Foreground="#95A5A6" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding NewDepartment, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="9" BorderBrush="#E0E0E0" BorderThickness="1" FontSize="13"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Staff Type" Foreground="#95A5A6" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding StaffTypeOptions}"
                                              SelectedItem="{Binding NewStaffType}"
                                              Padding="9,8" FontSize="13" BorderBrush="#E0E0E0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 3: Salary / Phone / Joining Date -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Base Salary (₹)" Foreground="#95A5A6" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding NewBaseSalary, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="9" BorderBrush="#E0E0E0" BorderThickness="1" FontSize="13"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="Mobile Number" Foreground="#95A5A6" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding NewPhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="9" BorderBrush="#E0E0E0" BorderThickness="1" FontSize="13"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Date of Joining" Foreground="#95A5A6" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                        <DatePicker SelectedDate="{Binding NewJoiningDate}"
                                                FontSize="13" BorderBrush="#E0E0E0" IsEnabled="True"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 4: Gender / Category / Biometric ID (read-only) -->
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Gender" Foreground="#95A5A6" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding GenderOptions}"
                                              SelectedItem="{Binding NewGender}"
                                              Padding="9,8" FontSize="13" BorderBrush="#E0E0E0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="Category" Foreground="#95A5A6" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding CategoryOptions}"
                                              SelectedItem="{Binding NewCategory}"
                                              Padding="9,8" FontSize="13" BorderBrush="#E0E0E0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Biometric ID (auto-filled, read-only)"
                                               Foreground="#95A5A6" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding AddSourceEntry.BiometricId}"
                                             Padding="9" FontSize="13" FontWeight="Bold"
                                             Background="#F4F6F7" Foreground="#27AE60"
                                             BorderBrush="#A9DFBF" BorderThickness="1"
                                             IsReadOnly="True"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Buttons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Cancel"
                                        Command="{Binding CancelAddFromUnmatchedCommand}"
                                        Background="#95A5A6" Foreground="White"
                                        BorderThickness="0" Height="40" Padding="22,0"
                                        Margin="0,0,10,0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                    <Button Content="✔ Add Employee"
                                        Command="{Binding ConfirmAddFromUnmatchedCommand}"
                                        Background="#27AE60" Foreground="White"
                                        FontWeight="Bold" BorderThickness="0"
                                        Height="40" Padding="22,0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>

                            </StackPanel>
                        </Border>

                        <!-- ── Main flagged-entries grid ───────────────────────────────── -->
                        <DataGrid Grid.Row="4"
                              ItemsSource="{Binding FlaggedStaff}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" BorderThickness="0"
                              Background="White" RowBackground="White"
                              AlternatingRowBackground="#FDFEFE"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F0F0F0"
                              ColumnHeaderStyle="{StaticResource ColHeaderStyle}"
                              CellStyle="{StaticResource CellStyle}"
                              HorizontalScrollBarVisibility="Disabled"
                              ColumnWidth="*">
                            <DataGrid.Columns>

                                <!-- BioID badge -->
                                <DataGridTemplateColumn Header="Biometric ID" Width="130" MinWidth="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#EAF2FF" CornerRadius="4"
                                                Padding="8,4" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding BiometricId}"
                                                       FontWeight="Bold" FontSize="12" Foreground="#2471A3"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Name as found in file -->
                                <DataGridTemplateColumn Header="Name in Attendance File" Width="2*" MinWidth="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BiometricName}"
                                                       FontWeight="Bold" FontSize="13" Foreground="#2C3E50"/>
                                                <TextBlock Text="{Binding SourceFormat}"
                                                       FontSize="10" Foreground="#95A5A6" Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- First-seen date -->
                                <DataGridTextColumn Header="First Seen"
                                                Binding="{Binding FirstSeenOn, StringFormat=dd-MMM-yyyy}"
                                                Width="110" MinWidth="90" Foreground="#7F8C8D"/>

                                <!-- Status pill -->
                                <DataGridTemplateColumn Header="Status" Width="110" MinWidth="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" Padding="10,3" HorizontalAlignment="Left"
                                                Background="{Binding StatusColor}">
                                                <TextBlock Text="{Binding StatusText}"
                                                       Foreground="White" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Actions — three buttons, fixed width so Dismiss is never cropped -->
                                <DataGridTemplateColumn Header="Actions" Width="Auto" MinWidth="340">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                        Margin="0,2">

                                                <!-- ① Link to Employee -->
                                                <Button Content="🔗 Link to Employee"
                                                    Command="{Binding DataContext.OpenLinkDialogCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#2E86C1" Foreground="White"
                                                    BorderThickness="0" FontWeight="Bold" FontSize="12"
                                                    Padding="10,6" Margin="0,0,6,0" Cursor="Hand">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="4"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>

                                                <!-- ② Add to DB -->
                                                <Button Content="➕ Add to DB"
                                                    Command="{Binding DataContext.OpenAddFromUnmatchedCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#27AE60" Foreground="White"
                                                    BorderThickness="0" FontWeight="Bold" FontSize="12"
                                                    Padding="10,6" Margin="0,0,6,0" Cursor="Hand">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="4"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>

                                                <!-- ③ Dismiss — full text, never cropped -->
                                                <Button Content="✕ Dismiss"
                                                    Command="{Binding DataContext.DismissFlaggedCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" BorderBrush="#E74C3C"
                                                    BorderThickness="1.5" Foreground="#E74C3C"
                                                    FontWeight="Bold" FontSize="12"
                                                    Padding="10,5" Cursor="Hand">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="4"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>

                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>

                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>
    </ScrollViewer>
</UserControl>
