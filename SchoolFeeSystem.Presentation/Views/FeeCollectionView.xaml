<UserControl x:Class="SchoolFeeSystem.Presentation.Views.FeeCollectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <!-- FIX XDG0008: removed custom BoolToVisibilityConverter and NullToVisibilityConverter.
             Using WPF built-in BooleanToVisibilityConverter for HasActiveNote.
             Null-visibility handled via DataTriggers inline. -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="#757575"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin"     Value="0,12,0,6"/>
        </Style>

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CollectButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background"  Value="#1565C0"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="Padding"     Value="12,7"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
        </Style>

    </UserControl.Resources>

    <Grid Background="#F0F2F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ ROW 0 — HEADER ═══ -->
        <Border Grid.Row="0" Background="#1565C0" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="← Back"
                        Command="{Binding GoBackCommand}"
                        Background="#1976D2" Foreground="White"
                        Padding="14,8" BorderThickness="0" Cursor="Hand"
                        FontWeight="Bold"/>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="💰 Fee Collection"
                              FontSize="22" FontWeight="Bold" Foreground="White"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="Select a student card to process payment"
                              FontSize="11" Foreground="#90CAF9" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- FIX XDG0040 / XLS0501: Content is set only once (via child element, not attribute). -->
                <Button Grid.Column="2"
                        Command="{Binding SaveChangesCommand}"
                        Background="#43A047" Foreground="White"
                        Padding="16,8" FontWeight="Bold"
                        BorderThickness="0" Cursor="Hand"
                        Style="{StaticResource FlatButton}">
                    <TextBlock Text="💾 Save Changes" Foreground="White" FontWeight="Bold"/>
                </Button>
            </Grid>
        </Border>

        <!-- ═══ ROW 1 — FILTER BAR + STAT CHIPS + NOTE BAR ═══ -->
        <StackPanel Grid.Row="1">

            <!-- Filter bar + stat chips -->
            <Border Background="White" Padding="16,12"
                    BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="📋 Class / Sheet:"
                               VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox Grid.Row="0"
                                 Text="{Binding SheetSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,5" FontSize="12"
                                 BorderBrush="#BDBDBD" BorderThickness="1" Margin="0,0,0,2">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <VisualBrush Stretch="None" AlignmentX="Left">
                                                        <VisualBrush.Visual>
                                                            <TextBlock Text="🔍 Search sheets..."
                                                                       Foreground="#9E9E9E" Margin="5,0,0,0"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <ComboBox Grid.Row="1"
                                  ItemsSource="{Binding FilteredSheetNames}"
                                  SelectedItem="{Binding SelectedSheet}"
                                  Padding="8,5" FontSize="13"
                                  BorderBrush="#1976D2" BorderThickness="2"/>
                    </Grid>

                    <TextBlock Grid.Column="3" Text="🔍 Filter:"
                               VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <ComboBox Grid.Column="4"
                              ItemsSource="{Binding FeeFilterOptions}"
                              SelectedItem="{Binding SelectedFeeFilter}"
                              Padding="8,5" FontSize="13"
                              VerticalAlignment="Bottom"
                              BorderBrush="#1976D2" BorderThickness="2"/>

                    <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#E3F2FD" CornerRadius="8" Padding="14,8" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="{Binding SummaryTotalStudents}"
                                          FontSize="20" FontWeight="Bold" Foreground="#1565C0"
                                          HorizontalAlignment="Center"/>
                                <TextBlock Text="Total" FontSize="10" Foreground="#607D8B"
                                          HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#E8F5E9" CornerRadius="8" Padding="14,8" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="{Binding SummaryPaidStudents}"
                                          FontSize="20" FontWeight="Bold" Foreground="#388E3C"
                                          HorizontalAlignment="Center"/>
                                <TextBlock Text="Cleared" FontSize="10" Foreground="#607D8B"
                                          HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#FFF3E0" CornerRadius="8" Padding="14,8" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="{Binding SummaryPendingStudents}"
                                          FontSize="20" FontWeight="Bold" Foreground="#E65100"
                                          HorizontalAlignment="Center"/>
                                <TextBlock Text="Pending" FontSize="10" Foreground="#607D8B"
                                          HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#FFEBEE" CornerRadius="8" Padding="14,8">
                            <StackPanel>
                                <TextBlock Text="{Binding SummaryPendingAmount, StringFormat=₹{0:N0}}"
                                          FontSize="20" FontWeight="Bold" Foreground="#C62828"
                                          HorizontalAlignment="Center"/>
                                <TextBlock Text="Total Due" FontSize="10" Foreground="#607D8B"
                                          HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Note / increment bar -->
            <Border Background="#FFF3E0" Padding="15,10"
                    Visibility="{Binding HasActiveNote, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding NoteInformation}"
                               FontSize="13" Foreground="#E65100" VerticalAlignment="Center"/>
                    <DatePicker Grid.Column="1" SelectedDate="{Binding ExtensionDate}"
                                Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <!-- FIX XDG0040/XLS0501: Content set only via child element -->
                        <Button Command="{Binding UpdateExtensionDateCommand}"
                                Padding="10,5" Margin="0,0,5,0" Background="#FF9800"
                                Foreground="White" BorderThickness="0" Cursor="Hand"
                                Style="{StaticResource FlatButton}">
                            <TextBlock Text="Update Date" Foreground="White"/>
                        </Button>
                        <Button Command="{Binding ManualApplyIncrementCommand}"
                                Padding="10,5" Background="#F44336"
                                Foreground="White" BorderThickness="0" Cursor="Hand"
                                Style="{StaticResource FlatButton}">
                            <TextBlock Text="Apply Now" Foreground="White"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ═══ ROW 2 — MAIN CONTENT ═══ -->
        <Grid Grid.Row="2" Margin="16,12,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Student card list -->
            <Border Grid.Column="0" Background="White" CornerRadius="10"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#AAAAAA" Opacity="0.10" BlurRadius="12" ShadowDepth="1"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1565C0" CornerRadius="10,10,0,0" Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📋 Student List"
                                      FontSize="15" FontWeight="Bold" Foreground="White"
                                      VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#0D47A1" CornerRadius="10" Padding="10,3">
                                <TextBlock Text="{Binding SummaryTotalStudents, StringFormat={}{0} students}"
                                          FontSize="12" Foreground="White" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Padding="12,8,12,8" Background="#F8F9FA">
                        <ItemsControl ItemsSource="{Binding FeeStudentCards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" CornerRadius="10"
                                            Background="White"
                                            BorderBrush="{Binding CardBorderColor}"
                                            BorderThickness="1"
                                            Cursor="Hand">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#AAAAAA" Opacity="0.08"
                                                              BlurRadius="8" ShadowDepth="1"/>
                                        </Border.Effect>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#1565C0"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                        <Setter Property="Background" Value="#E3F2FD"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="54"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Background="{Binding StripeColor}"
                                                    CornerRadius="10,0,0,10"/>

                                            <Border Grid.Column="1"
                                                    Width="36" Height="36" CornerRadius="18"
                                                    Background="{Binding AvatarBackground}"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding SerialNumber}"
                                                          FontSize="13" FontWeight="Bold"
                                                          Foreground="{Binding AvatarForeground}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Margin="6,12,6,12">
                                                <TextBlock Text="{Binding Name}"
                                                          FontSize="14" FontWeight="SemiBold"
                                                          Foreground="#1A1A2E"/>
                                                <TextBlock FontSize="12" Foreground="#78909C" Margin="0,2,0,0">
                                                    <Run Text="S/o "/>
                                                    <Run Text="{Binding FatherName}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding PhoneNumber}"
                                                          FontSize="11" Foreground="#90A4AE" Margin="0,1,0,0"/>
                                            </StackPanel>

                                            <Border Grid.Column="3" VerticalAlignment="Center"
                                                    Background="{Binding CategoryBackground}"
                                                    CornerRadius="10" Padding="9,4" Margin="4,0">
                                                <TextBlock Text="{Binding Category}"
                                                          FontSize="11" FontWeight="Bold"
                                                          Foreground="{Binding CategoryForeground}"/>
                                            </Border>

                                            <StackPanel Grid.Column="4" VerticalAlignment="Center"
                                                        Margin="4,0" HorizontalAlignment="Center">
                                                <TextBlock Text="Quarterly Fee" FontSize="10"
                                                          Foreground="#90A4AE" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding QuarterlyFee, StringFormat=₹{0:N0}}"
                                                          FontSize="13" FontWeight="Bold"
                                                          Foreground="#1565C0" HorizontalAlignment="Center"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="5" VerticalAlignment="Center"
                                                        Margin="4,0" HorizontalAlignment="Center">
                                                <TextBlock Text="Prev Pending" FontSize="10"
                                                          Foreground="#90A4AE" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding PreviousPending, StringFormat=₹{0:N0}}"
                                                          FontSize="13" FontWeight="Bold"
                                                          Foreground="{Binding PendingAmountColor}"
                                                          HorizontalAlignment="Center"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="6" VerticalAlignment="Center"
                                                        Margin="4,0" HorizontalAlignment="Center">
                                                <TextBlock Text="Total Due" FontSize="10"
                                                          Foreground="#90A4AE" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding TotalDue, StringFormat=₹{0:N0}}"
                                                          FontSize="14" FontWeight="Bold"
                                                          Foreground="{Binding TotalDueColor}"
                                                          HorizontalAlignment="Center"/>
                                            </StackPanel>

                                            <Border Grid.Column="7" VerticalAlignment="Center"
                                                    Background="{Binding StatusBackground}"
                                                    BorderBrush="{Binding StatusBorderColor}"
                                                    BorderThickness="1"
                                                    CornerRadius="12" Padding="8,5"
                                                    Margin="4,0" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding StatusText}"
                                                          FontSize="11" FontWeight="Bold"
                                                          Foreground="{Binding StatusForeground}"
                                                          HorizontalAlignment="Center"/>
                                            </Border>

                                            <!-- FIX XDG0040/XLS0501: Content set once via child element only -->
                                            <Button Grid.Column="8"
                                                    Command="{Binding DataContext.SelectStudentCardCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource CollectButton}"
                                                    Margin="6,0,10,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="💳 Collect" Foreground="White" FontWeight="SemiBold"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- RIGHT: Payment panel -->
            <Border Grid.Column="2" Background="White" CornerRadius="10"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#AAAAAA" Opacity="0.10" BlurRadius="12" ShadowDepth="1"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#2E7D32" CornerRadius="10,10,0,0" Padding="16,10">
                        <TextBlock Text="💳 Payment Details"
                                  FontSize="15" FontWeight="Bold" Foreground="White"/>
                    </Border>

                    <!-- FIX MC3089: ScrollViewer must have exactly ONE child.
                         Both StackPanels are now wrapped in a single Grid. -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
                        <Grid>

                            <!-- Payment form (visible when a student IS selected) -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedStudentCard}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <TextBlock Text="Student Information" Style="{StaticResource SectionHeader}"/>
                                <Border Background="#F5F7FA" Padding="14" CornerRadius="8"
                                        BorderBrush="#E8ECF0" BorderThickness="1" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding StudentName}"
                                                  FontSize="17" FontWeight="Bold" Foreground="#1A1A2E"/>
                                        <TextBlock FontSize="12" Foreground="#607D8B" Margin="0,3,0,0">
                                            <Run Text="Guardian: "/>
                                            <Run Text="{Binding StudentGuardianName}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="12" Foreground="#607D8B" Margin="0,2,0,0">
                                            <Run Text="Phone: "/>
                                            <Run Text="{Binding StudentPhoneNumber}"/>
                                        </TextBlock>
                                        <Border Background="#E3F2FD" CornerRadius="6" Padding="8,4" Margin="0,6,0,0">
                                            <TextBlock FontSize="12" Foreground="#1565C0" FontWeight="SemiBold">
                                                <Run Text="📅 Quarter: "/>
                                                <Run Text="{Binding CurrentQuarter}"/>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Fee Breakdown" Style="{StaticResource SectionHeader}"/>
                                <Border Background="#F9F9F9" Padding="14" CornerRadius="8"
                                        BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="6"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Previous Pending"
                                                  FontSize="12" Foreground="#555"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                  Text="{Binding PreviousPendingAmount, StringFormat=₹{0:N2}}"
                                                  FontSize="12" Foreground="#C62828" FontWeight="SemiBold"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Quarterly Fees"
                                                  FontSize="12" Foreground="#555"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1"
                                                  Text="{Binding QuarterlyFeeAmount, StringFormat=₹{0:N2}}"
                                                  FontSize="12" Foreground="#555"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Fine (after waiver)"
                                                  FontSize="12" Foreground="#E65100"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1"
                                                  Text="{Binding NetFineAfterWaiver, StringFormat=₹{0:N2}}"
                                                  FontSize="12" Foreground="#E65100" FontWeight="SemiBold"/>

                                        <Separator Grid.Row="6" Grid.ColumnSpan="2"
                                                  Background="#BDBDBD" Margin="0,2"/>

                                        <TextBlock Grid.Row="8" Grid.Column="0"
                                                  Text="TOTAL DUE" FontSize="14" FontWeight="Bold"/>
                                        <TextBlock Grid.Row="8" Grid.Column="1"
                                                  Text="{Binding TotalPendingForSelectedStudent, StringFormat=₹{0:N2}}"
                                                  FontSize="14" FontWeight="Bold" Foreground="#C62828"/>
                                    </Grid>
                                </Border>

                                <Border Background="#FFEBEE" Padding="14" CornerRadius="8"
                                        BorderBrush="#EF9A9A" BorderThickness="2" Margin="0,0,0,12">
                                    <TextBlock FontSize="24" FontWeight="Bold"
                                              Foreground="#C62828" HorizontalAlignment="Center">
                                        <Run Text="₹"/>
                                        <Run Text="{Binding TotalPendingForSelectedStudent, StringFormat=N2}"/>
                                    </TextBlock>
                                </Border>

                                <TextBlock Text="Fine Waiver (Admin Only)" Style="{StaticResource SectionHeader}"
                                          Foreground="#E65100"/>
                                <Border Background="#FFF8E1" Padding="14" CornerRadius="8"
                                        BorderBrush="#FFB300" BorderThickness="1" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Current Fine:" FontSize="12" Foreground="#555"
                                                      VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                      Text="{Binding CurrentFineAmount, StringFormat=₹{0:N2}}"
                                                      FontSize="12" FontWeight="SemiBold" Foreground="#E65100"/>
                                        </Grid>
                                        <TextBlock Text="Waiver Amount" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Text="{Binding FineWaiverAmount, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="10,7" FontSize="14" Margin="0,0,0,8"
                                                 BorderBrush="#FFB300" BorderThickness="2"/>
                                        <Button Command="{Binding ApplyFineWaiverCommand}"
                                                Background="#FF9800" Foreground="White"
                                                Padding="10,8" FontWeight="Bold"
                                                Style="{StaticResource FlatButton}">
                                            <TextBlock Text="✓ Apply Fine Waiver" Foreground="White" FontWeight="Bold"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Payment Amount" Style="{StaticResource SectionHeader}"/>
                                <TextBox Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="12,9" FontSize="17" Margin="0,0,0,12"
                                         BorderBrush="#43A047" BorderThickness="2"/>

                                <TextBlock Text="Payment Mode" Style="{StaticResource SectionHeader}"/>
                                <ComboBox ItemsSource="{Binding PaymentModes}"
                                          SelectedItem="{Binding SelectedPaymentMode}"
                                          Padding="12,8" FontSize="14" Margin="0,0,0,16"
                                          BorderBrush="#43A047" BorderThickness="2"/>

                                <Button Command="{Binding ProcessPaymentCommand}"
                                        Background="#2E7D32" Foreground="White"
                                        Padding="15,13" FontSize="14" FontWeight="Bold"
                                        Margin="0,0,0,8"
                                        Style="{StaticResource FlatButton}">
                                    <TextBlock Text="💰 Submit Payment" Foreground="White" FontWeight="Bold" FontSize="14"/>
                                </Button>

                                <Button Command="{Binding SendWhatsAppReminderCommand}"
                                        Background="#25D366" Foreground="White"
                                        Padding="15,13" FontSize="14" FontWeight="Bold"
                                        Style="{StaticResource FlatButton}">
                                    <TextBlock Text="📱 Send WhatsApp Reminder" Foreground="White" FontWeight="Bold" FontSize="14"/>
                                </Button>
                            </StackPanel>

                            <!-- Empty state (visible when NO student is selected) -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Margin="0,60,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedStudentCard}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="👈" FontSize="40" HorizontalAlignment="Center" Opacity="0.3"/>
                                <TextBlock Text="Click 💳 Collect on any" FontSize="13"
                                          Foreground="#9E9E9E" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Text="student card to begin" FontSize="13"
                                          Foreground="#9E9E9E" HorizontalAlignment="Center"/>
                            </StackPanel>

                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
