<UserControl x:Class="SchoolFeeSystem.Presentation.Views.FeeCollectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1000" Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F8F9FA" Padding="15" CornerRadius="8" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Standard" FontWeight="Bold" FontSize="12" Foreground="Gray"/>
                    <ComboBox ItemsSource="{Binding Standards}" SelectedItem="{Binding SelectedStandard}" 
                              Width="100" Padding="5"/>
                </StackPanel>

                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Section" FontWeight="Bold" FontSize="12" Foreground="Gray"/>
                    <ComboBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" 
                              Width="80" Padding="5"/>
                </StackPanel>

                <Button Content="Load Class List" Command="{Binding LoadClassDataCommand}" 
                        Background="#2C3E50" Foreground="White" FontWeight="Bold" Padding="15,5" Margin="0,16,0,0" Height="32"/>

                <Border Width="1" Background="#DDD" Margin="30,5"/>

                <StackPanel VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="200" Padding="6"/>
                        <Button Content="Search" Command="{Binding SearchCommand}" Background="#3498DB" Foreground="White" Margin="5,0,0,0" Padding="10,5"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,20,0">
                <TextBlock Text="Student List (Red = Pending)" DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,10" Foreground="#7F8C8D"/>

                <ListBox ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedStudent}" 
                         BorderThickness="1" BorderBrush="#DDD" Background="White">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="5"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding FullName}" FontWeight="Bold" FontSize="15" Foreground="#2C3E50"/>
                                    <TextBlock Text="{Binding ContactNumber}" FontSize="12" Foreground="Gray"/>
                                </StackPanel>

                                <Border Grid.Column="1" Background="{Binding DueStatusColor}" CornerRadius="15" Padding="10,2">
                                    <TextBlock Text="{Binding TotalDues, StringFormat={}{0:C}}" 
                                               Foreground="White" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <Grid Grid.Column="1">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedStudent}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Fee Account:" FontSize="14" Foreground="Gray"/>
                        <TextBlock Text="{Binding SelectedStudent.FullName}" FontSize="20" FontWeight="Bold" Foreground="#2C3E50"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Send WhatsApp Reminder" Command="{Binding SendReminderCommand}" 
                            Background="#25D366" Foreground="White" FontWeight="Bold" Padding="15,5" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>

                <DataGrid Grid.Row="1" ItemsSource="{Binding StudentFees}" SelectedItem="{Binding SelectedFeeToPay}" 
                          AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,20" BorderThickness="1" BorderBrush="#EEE">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fee Name" Binding="{Binding FeeStructure.FeeName}" Width="*"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding FeeStructure.Amount, StringFormat={}{0:C}}" Width="100"/>
                        <DataGridTextColumn Header="Paid" Binding="{Binding AmountPaid, StringFormat={}{0:C}}" Width="80"/>
                        <DataGridTextColumn Header="Pending" Binding="{Binding PendingAmount, StringFormat={}{0:C}}" Width="80" FontWeight="Bold" Foreground="Red"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="2" Background="#ECF0F1" Padding="20" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="ACCEPT PAYMENT" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" Foreground="#7F8C8D"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Amount:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1" Text="{Binding PaymentAmount}" Padding="8" Margin="0,0,20,0"/>
                            <TextBlock Grid.Column="2" Text="Mode:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox Grid.Column="3" ItemsSource="{Binding PaymentModes}" SelectedItem="{Binding PaymentMode}" Padding="5" Margin="0,0,20,0"/>
                            <Button Grid.Column="4" Content="CONFIRM" Command="{Binding SubmitPaymentCommand}" 
                                    Background="#27AE60" Foreground="White" Padding="25,8" FontWeight="Bold"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Grid.Column="1" Text="Select a class and student to begin" 
                       VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#BDC3C7" FontSize="18">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedStudent}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>