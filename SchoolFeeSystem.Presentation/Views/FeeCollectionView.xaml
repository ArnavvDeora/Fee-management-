<UserControl x:Class="SchoolFeeSystem.Presentation.Views.FeeCollectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F0F2F5">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" Color="#C0C0C0" Opacity="0.30" ShadowDepth="2"/>

        <!-- Shared flat button — matches ReportsView / PaymentHistoryView -->
        <Style x:Key="FlatBtn" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="#546E7A"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#37474F"/>
            <Setter Property="Margin"     Value="0,10,0,6"/>
        </Style>

        <Style x:Key="CollectBtn" TargetType="Button" BasedOn="{StaticResource FlatBtn}">
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding"    Value="12,7"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- DataGrid column header style -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="#ECEFF1"/>
            <Setter Property="Foreground"      Value="#546E7A"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <!-- header bar -->
            <RowDefinition Height="Auto"/>
            <!-- stat chips + controls -->
            <RowDefinition Height="Auto"/>
            <!-- note bar -->
            <RowDefinition Height="*"/>
            <!-- main content -->
        </Grid.RowDefinitions>

        <!-- ═══ ROW 0 — HEADER BAR ══════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#1565C0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="← Back"
                        Command="{Binding GoBackCommand}"
                        Style="{StaticResource FlatBtn}"
                        Background="Transparent" Foreground="White"
                        FontSize="13" Padding="10,8"/>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="💰 Fee Collection"
                               FontSize="20" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Select a student card to process payment"
                               FontSize="11" Foreground="#90CAF9" HorizontalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Command="{Binding SaveChangesCommand}"
                        Style="{StaticResource FlatBtn}"
                        Background="#43A047" Foreground="White"
                        FontWeight="Bold" FontSize="13" Padding="18,8">
                    <TextBlock Text="💾 Save Changes" Foreground="White" FontWeight="Bold"/>
                </Button>
            </Grid>
        </Border>

        <!-- ═══ ROW 1 — STAT CHIPS + CONTROLS ══════════════════════════ -->
        <Border Grid.Row="1" Background="White"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Sheet label -->
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="220"/>
                    <!-- Sheet search + dropdown -->
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Filter label -->
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="200"/>
                    <!-- Filter dropdown -->
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Stat chips -->
                </Grid.ColumnDefinitions>

                <!-- Sheet selector -->
                <TextBlock Grid.Column="0" Text="📋 Class / Sheet"
                           FontSize="11" FontWeight="SemiBold" Foreground="#546E7A"
                           VerticalAlignment="Bottom" Margin="0,0,0,4"/>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0"
                             Text="{Binding SheetSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,5" FontSize="12"
                             BorderBrush="#90CAF9" BorderThickness="1.5" Margin="0,0,0,3">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush Stretch="None" AlignmentX="Left">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="🔍 Search sheets..."
                                                                   Foreground="#9E9E9E" Margin="7,0,0,0"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <ComboBox Grid.Row="1"
                              ItemsSource="{Binding FilteredSheetNames}"
                              SelectedItem="{Binding SelectedSheet}"
                              Padding="8,5" FontSize="13"
                              BorderBrush="#90CAF9" BorderThickness="1.5"/>
                </Grid>

                <!-- Filter -->
                <TextBlock Grid.Column="4" Text="🔍 Filter"
                           FontSize="11" FontWeight="SemiBold" Foreground="#546E7A"
                           VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                <ComboBox Grid.Column="6"
                          ItemsSource="{Binding FeeFilterOptions}"
                          SelectedItem="{Binding SelectedFeeFilter}"
                          Padding="8,5" FontSize="13" VerticalAlignment="Bottom"
                          BorderBrush="#90CAF9" BorderThickness="1.5"/>

                <!-- Stat chips -->
                <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">

                    <Border Background="#E3F2FD" CornerRadius="10" Padding="16,10"
                            Margin="0,0,10,0" Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <TextBlock Text="{Binding SummaryTotalStudents}"
                                       FontSize="22" FontWeight="Bold" Foreground="#1565C0"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Total" FontSize="11" Foreground="#546E7A"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#E8F5E9" CornerRadius="10" Padding="16,10"
                            Margin="0,0,10,0" Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <TextBlock Text="{Binding SummaryPaidStudents}"
                                       FontSize="22" FontWeight="Bold" Foreground="#2E7D32"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Cleared" FontSize="11" Foreground="#546E7A"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#FFF3E0" CornerRadius="10" Padding="16,10"
                            Margin="0,0,10,0" Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <TextBlock Text="{Binding SummaryPendingStudents}"
                                       FontSize="22" FontWeight="Bold" Foreground="#E65100"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Pending" FontSize="11" Foreground="#546E7A"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#FFEBEE" CornerRadius="10" Padding="16,10"
                            Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <TextBlock Text="{Binding SummaryPendingAmount, StringFormat=₹{0:N0}}"
                                       FontSize="20" FontWeight="Bold" Foreground="#C62828"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Total Due" FontSize="11" Foreground="#546E7A"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ ROW 2 — NOTE / INCREMENT BAR ═══════════════════════════ -->
        <Border Grid.Row="2" Background="#FFF8E1"
                BorderBrush="#FFE082" BorderThickness="0,0,0,1" Padding="20,10"
                Visibility="{Binding HasActiveNote, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding NoteInformation}"
                           FontSize="13" Foreground="#E65100" VerticalAlignment="Center"/>

                <DatePicker Grid.Column="1" SelectedDate="{Binding ExtensionDate}"
                            VerticalAlignment="Center" Width="160"/>

                <Button Grid.Column="3"
                        Command="{Binding UpdateExtensionDateCommand}"
                        Style="{StaticResource FlatBtn}"
                        Background="#FF9800" Foreground="White" Padding="12,7">
                    <TextBlock Text="Update Date" Foreground="White"/>
                </Button>

                <Button Grid.Column="5"
                        Command="{Binding ManualApplyIncrementCommand}"
                        Style="{StaticResource FlatBtn}"
                        Background="#F44336" Foreground="White" Padding="12,7">
                    <TextBlock Text="Apply Now" Foreground="White"/>
                </Button>
            </Grid>
        </Border>

        <!-- ═══ ROW 3 — MAIN CONTENT ════════════════════════════════════ -->
        <Grid Grid.Row="3" Margin="16,12,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <!-- ── LEFT: Student card list ──────────────────────────── -->
            <Border Grid.Column="0" Background="White" CornerRadius="10"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Card list header -->
                    <Border Grid.Row="0" Background="#1565C0" CornerRadius="10,10,0,0" Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📋 Student List"
                                       FontSize="14" FontWeight="Bold" Foreground="White"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#0D47A1" CornerRadius="10" Padding="10,3">
                                <TextBlock Text="{Binding SummaryTotalStudents, StringFormat={}{0} students}"
                                           FontSize="12" Foreground="White" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Student cards -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Padding="12,8" Background="#F8F9FA">
                        <ItemsControl ItemsSource="{Binding FeeStudentCards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" CornerRadius="10"
                                            Background="White" Cursor="Hand"
                                            BorderBrush="{Binding CardBorderColor}"
                                            BorderThickness="1">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#AAAAAA" Opacity="0.08"
                                                              BlurRadius="8" ShadowDepth="1"/>
                                        </Border.Effect>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush"     Value="#1565C0"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                        <Setter Property="Background"      Value="#E3F2FD"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="6"/>
                                                <!-- stripe -->
                                                <ColumnDefinition Width="52"/>
                                                <!-- avatar -->
                                                <ColumnDefinition Width="*"/>
                                                <!-- name -->
                                                <ColumnDefinition Width="Auto"/>
                                                <!-- category -->
                                                <ColumnDefinition Width="110"/>
                                                <!-- quarterly -->
                                                <ColumnDefinition Width="110"/>
                                                <!-- prev pending -->
                                                <ColumnDefinition Width="110"/>
                                                <!-- total due -->
                                                <ColumnDefinition Width="100"/>
                                                <!-- status badge -->
                                                <ColumnDefinition Width="100"/>
                                                <!-- collect button -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Left colour stripe -->
                                            <Border Grid.Column="0"
                                                    Background="{Binding StripeColor}"
                                                    CornerRadius="10,0,0,10"/>

                                            <!-- Avatar circle -->
                                            <Border Grid.Column="1"
                                                    Width="36" Height="36" CornerRadius="18"
                                                    Background="{Binding AvatarBackground}"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding SerialNumber}"
                                                           FontSize="13" FontWeight="Bold"
                                                           Foreground="{Binding AvatarForeground}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Name + S/o + phone -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                        Margin="8,12,8,12">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           Foreground="#1A1A2E"/>
                                                <TextBlock FontSize="12" Foreground="#78909C" Margin="0,2,0,0">
                                                    <Run Text="S/o "/>
                                                    <Run Text="{Binding FatherName, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding PhoneNumber}"
                                                           FontSize="11" Foreground="#90A4AE" Margin="0,1,0,0"/>
                                            </StackPanel>

                                            <!-- Category pill -->
                                            <Border Grid.Column="3" VerticalAlignment="Center"
                                                    Background="{Binding CategoryBackground}"
                                                    CornerRadius="10" Padding="9,4" Margin="4,0">
                                                <TextBlock Text="{Binding Category}"
                                                           FontSize="11" FontWeight="Bold"
                                                           Foreground="{Binding CategoryForeground}"/>
                                            </Border>

                                            <!-- ── Quarterly Fee chip — shows scholarship badge if applicable -->
                                            <StackPanel Grid.Column="4" VerticalAlignment="Center"
                                                        Margin="4,0" HorizontalAlignment="Center">
                                                <TextBlock Text="Quarterly Fee" FontSize="10"
                                                           Foreground="#90A4AE" HorizontalAlignment="Center"/>
                                                <!-- Shows discounted fee when scholarship > 0, raw fee otherwise -->
                                                <TextBlock Text="{Binding QuarterlyFee, StringFormat=₹{0:N0}}"
                                                           FontSize="13" FontWeight="Bold"
                                                           Foreground="#1565C0" HorizontalAlignment="Center"/>
                                                <!-- Green scholarship badge — only visible when HasScholarship = true -->
                                                <Border CornerRadius="6" Padding="5,2" Margin="0,2,0,0"
                                                        Background="#E8F5E9" HorizontalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasScholarship}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="10" FontWeight="Bold" Foreground="#2E7D32">
                                                        <Run Text="🎓 "/>
                                                        <Run Text="{Binding ScholarshipDisplay, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>

                                            <!-- Prev Pending chip -->
                                            <StackPanel Grid.Column="5" VerticalAlignment="Center"
                                                        Margin="4,0" HorizontalAlignment="Center">
                                                <TextBlock Text="Prev Pending" FontSize="10"
                                                           Foreground="#90A4AE" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding PreviousPending, StringFormat=₹{0:N0}}"
                                                           FontSize="13" FontWeight="Bold"
                                                           Foreground="{Binding PendingAmountColor}"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Total Due chip -->
                                            <StackPanel Grid.Column="6" VerticalAlignment="Center"
                                                        Margin="4,0" HorizontalAlignment="Center">
                                                <TextBlock Text="Total Due" FontSize="10"
                                                           Foreground="#90A4AE" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding TotalDue, StringFormat=₹{0:N0}}"
                                                           FontSize="14" FontWeight="Bold"
                                                           Foreground="{Binding TotalDueColor}"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Status badge -->
                                            <Border Grid.Column="7" VerticalAlignment="Center"
                                                    Background="{Binding StatusBackground}"
                                                    BorderBrush="{Binding StatusBorderColor}"
                                                    BorderThickness="1"
                                                    CornerRadius="12" Padding="8,5"
                                                    Margin="4,0" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding StatusText}"
                                                           FontSize="11" FontWeight="Bold"
                                                           Foreground="{Binding StatusForeground}"
                                                           HorizontalAlignment="Center"/>
                                            </Border>

                                            <!-- Collect button -->
                                            <Button Grid.Column="8"
                                                    Command="{Binding DataContext.SelectStudentCardCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource CollectBtn}"
                                                    Margin="6,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="💳 Collect" Foreground="White" FontWeight="SemiBold"/>
                                            </Button>

                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ── RIGHT: Payment panel ──────────────────────────────── -->
            <Border Grid.Column="2" Background="White" CornerRadius="10"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Panel header -->
                    <Border Grid.Row="0" Background="#2E7D32" CornerRadius="10,10,0,0" Padding="16,10">
                        <TextBlock Text="💳 Payment Details"
                                   FontSize="14" FontWeight="Bold" Foreground="White"/>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
                        <Grid>

                            <!-- ── Payment form (student selected) ── -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedStudentCard}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- Student info card -->
                                <TextBlock Text="Student Information" Style="{StaticResource SectionHeader}"/>
                                <Border Background="#F5F7FA" Padding="14" CornerRadius="8"
                                        BorderBrush="#E8ECF0" BorderThickness="1" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding StudentName}"
                                                   FontSize="16" FontWeight="Bold" Foreground="#1A1A2E"/>
                                        <TextBlock FontSize="12" Foreground="#607D8B" Margin="0,4,0,0">
                                            <Run Text="Guardian: "/>
                                            <Run Text="{Binding StudentGuardianName, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="12" Foreground="#607D8B" Margin="0,2,0,0">
                                            <Run Text="Phone: "/>
                                            <Run Text="{Binding StudentPhoneNumber, Mode=OneWay}"/>
                                        </TextBlock>
                                        <Border Background="#E3F2FD" CornerRadius="6"
                                                Padding="8,4" Margin="0,6,0,0">
                                            <TextBlock FontSize="11" Foreground="#1565C0" FontWeight="SemiBold">
                                                <Run Text="📅 "/>
                                                <Run Text="{Binding CurrentQuarter, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- ══ FEE BREAKDOWN ══════════════════════════════════════════ -->
                                <TextBlock Text="Fee Breakdown" Style="{StaticResource SectionHeader}"/>
                                <Border Background="#F9F9F9" Padding="14" CornerRadius="8"
                                        BorderBrush="#ECEFF1" BorderThickness="1" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <!-- Row 0:  Previous Pending -->
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                            <!-- Row 2:  Quarterly Fees (raw) -->
                                            <RowDefinition Height="4"/>
                                            <RowDefinition Height="Auto"/>
                                            <!-- Row 4:  Scholarship discount (hidden when 0) -->
                                            <RowDefinition Height="4"/>
                                            <RowDefinition Height="Auto"/>
                                            <!-- Row 6:  Net Quarterly (hidden when no scholarship) -->
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                            <!-- Row 8:  Fine (after waiver) -->
                                            <RowDefinition Height="6"/>
                                            <RowDefinition Height="Auto"/>
                                            <!-- Row 10: separator -->
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                            <!-- Row 12: TOTAL DUE -->
                                        </Grid.RowDefinitions>

                                        <!-- Row 0 — Previous Pending -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Previous Pending"
                                                   FontSize="12" Foreground="#555"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding PreviousPendingAmount, StringFormat=₹{0:N2}}"
                                                   FontSize="12" Foreground="#C62828" FontWeight="SemiBold"/>

                                        <!-- Row 2 — Quarterly Fees (raw, before scholarship) -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Quarterly Fees"
                                                   FontSize="12" Foreground="#555"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1"
                                                   Text="{Binding QuarterlyFeeRawAmount, StringFormat=₹{0:N2}}"
                                                   FontSize="12" Foreground="#555"/>

                                        <!-- Row 4 — Scholarship discount (collapsed when no scholarship) -->
                                        <TextBlock Grid.Row="4" Grid.Column="0"
                                                   FontSize="12" Foreground="#2E7D32" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedStudentCard.HasScholarship}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <Run Text="🎓 Scholarship ("/>
                                            <Run Text="{Binding ScholarshipPercentage, StringFormat={}{0:N0}%, Mode=OneWay}"/>
                                            <Run Text=")"/>
                                        </TextBlock>
                                        <TextBlock Grid.Row="4" Grid.Column="1"
                                                   Text="{Binding ScholarshipDiscountAmount, StringFormat=-₹{0:N2}}"
                                                   FontSize="12" Foreground="#2E7D32" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedStudentCard.HasScholarship}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Row 6 — Net Quarterly (collapsed when no scholarship) -->
                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Net Quarterly"
                                                   FontSize="12" Foreground="#1565C0" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedStudentCard.HasScholarship}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Row="6" Grid.Column="1"
                                                   Text="{Binding QuarterlyFeeAmount, StringFormat=₹{0:N2}}"
                                                   FontSize="12" Foreground="#1565C0" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedStudentCard.HasScholarship}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Row 8 — Fine (after waiver) -->
                                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Fine (after waiver)"
                                                   FontSize="12" Foreground="#E65100"/>
                                        <TextBlock Grid.Row="8" Grid.Column="1"
                                                   Text="{Binding NetFineAfterWaiver, StringFormat=₹{0:N2}}"
                                                   FontSize="12" Foreground="#E65100" FontWeight="SemiBold"/>

                                        <!-- Row 10 — Separator -->
                                        <Separator Grid.Row="10" Grid.ColumnSpan="2"
                                                   Background="#BDBDBD" Margin="0,2"/>

                                        <!-- Row 12 — TOTAL DUE -->
                                        <TextBlock Grid.Row="12" Grid.Column="0"
                                                   Text="TOTAL DUE" FontSize="13" FontWeight="Bold"/>
                                        <TextBlock Grid.Row="12" Grid.Column="1"
                                                   Text="{Binding TotalPendingForSelectedStudent, StringFormat=₹{0:N2}}"
                                                   FontSize="13" FontWeight="Bold" Foreground="#C62828"/>
                                    </Grid>
                                </Border>

                                <!-- Big total amount -->
                                <Border Background="#FFEBEE" Padding="12" CornerRadius="8"
                                        BorderBrush="#EF9A9A" BorderThickness="2" Margin="0,0,0,12">
                                    <TextBlock FontSize="26" FontWeight="Bold"
                                               Foreground="#C62828" HorizontalAlignment="Center">
                                        <Run Text="₹"/>
                                        <Run Text="{Binding TotalPendingForSelectedStudent, StringFormat=N2, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>

                                <!-- Fine waiver section -->
                                <TextBlock Text="Fine Waiver (Admin Only)" Style="{StaticResource SectionHeader}"
                                           Foreground="#E65100"/>
                                <Border Background="#FFF8E1" Padding="14" CornerRadius="8"
                                        BorderBrush="#FFE082" BorderThickness="1" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Current Fine:" FontSize="12" Foreground="#555"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding CurrentFineAmount, StringFormat=₹{0:N2}}"
                                                       FontSize="12" FontWeight="SemiBold" Foreground="#E65100"/>
                                        </Grid>
                                        <TextBlock Text="Waiver Amount" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Text="{Binding FineWaiverAmount, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="10,7" FontSize="14" Margin="0,0,0,8"
                                                 BorderBrush="#FFB300" BorderThickness="1.5"/>
                                        <Button Command="{Binding ApplyFineWaiverCommand}"
                                                Style="{StaticResource FlatBtn}"
                                                Background="#FF9800" Padding="10,8" FontWeight="Bold">
                                            <TextBlock Text="✓ Apply Fine Waiver" Foreground="White" FontWeight="Bold"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Payment input -->
                                <TextBlock Text="Payment Amount" Style="{StaticResource SectionHeader}"/>
                                <TextBox Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="12,9" FontSize="17" Margin="0,0,0,10"
                                         BorderBrush="#43A047" BorderThickness="1.5"/>

                                <TextBlock Text="Payment Mode" Style="{StaticResource SectionHeader}"/>
                                <ComboBox ItemsSource="{Binding PaymentModes}"
                                          SelectedItem="{Binding SelectedPaymentMode}"
                                          Padding="12,8" FontSize="13" Margin="0,0,0,14"
                                          BorderBrush="#43A047" BorderThickness="1.5"/>

                                <!-- Action buttons -->
                                <Button Command="{Binding ProcessPaymentCommand}"
                                        Style="{StaticResource FlatBtn}"
                                        Background="#2E7D32" Padding="15,13"
                                        FontSize="14" FontWeight="Bold" Margin="0,0,0,8">
                                    <TextBlock Text="💰 Submit Payment" Foreground="White"
                                               FontWeight="Bold" FontSize="14"/>
                                </Button>

                                <Button Command="{Binding SendWhatsAppReminderCommand}"
                                        Style="{StaticResource FlatBtn}"
                                        Background="#25D366" Padding="15,13"
                                        FontSize="14" FontWeight="Bold">
                                    <TextBlock Text="📱 WhatsApp Reminder" Foreground="White"
                                               FontWeight="Bold" FontSize="14"/>
                                </Button>

                            </StackPanel>

                            <!-- ── Empty state (no student selected) ── -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Margin="0,60,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedStudentCard}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="👈" FontSize="48" HorizontalAlignment="Center" Opacity="0.25"/>
                                <TextBlock Text="Click 💳 Collect on any"
                                           FontSize="13" Foreground="#9E9E9E"
                                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                <TextBlock Text="student card to begin"
                                           FontSize="13" Foreground="#9E9E9E"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>
