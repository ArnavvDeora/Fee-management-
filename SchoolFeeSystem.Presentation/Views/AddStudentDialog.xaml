<!--
    AddStudentDialog.xaml
    ─────────────────────
    Modal dialog for manually adding a student to the currently-open batch.
    Every column that can appear in an imported Excel sheet is covered so the
    manually-added row is indistinguishable from an uploaded one.

    Usage (code-behind: AddStudentDialog.xaml.cs):
        var dlg = new AddStudentDialog();
        dlg.Owner = Application.Current.MainWindow;
        if (dlg.ShowDialog() == true)
            // dlg.Result holds the filled-in AddStudentResult
-->
<Window x:Class="SchoolFeeSystem.Presentation.Views.AddStudentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Student"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F7FA"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- ── Rounded text-box style ── -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Padding"        Value="10,7"/>
            <Setter Property="FontSize"       Value="13"/>
            <Setter Property="BorderBrush"    Value="#CFD8DC"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background"     Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#1976D2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Same style for ComboBox ── -->
        <Style x:Key="InputCombo" TargetType="ComboBox">
            <Setter Property="Padding"        Value="8,6"/>
            <Setter Property="FontSize"       Value="13"/>
            <Setter Property="BorderBrush"    Value="#CFD8DC"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background"     Value="White"/>
        </Style>

        <!-- ── Field label ── -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"       Value="12"/>
            <Setter Property="FontWeight"     Value="SemiBold"/>
            <Setter Property="Foreground"     Value="#455A64"/>
            <Setter Property="Margin"         Value="0,0,0,4"/>
        </Style>

        <!-- ── Section heading ── -->
        <Style x:Key="SectionHead" TargetType="TextBlock">
            <Setter Property="FontSize"       Value="12"/>
            <Setter Property="FontWeight"     Value="Bold"/>
            <Setter Property="Foreground"     Value="#1565C0"/>
            <Setter Property="Margin"         Value="0,14,0,6"/>
        </Style>

        <!-- ── Action button base ── -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Padding"          Value="22,10"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Background="White" CornerRadius="12" Margin="12">
        <StackPanel Margin="24,20">

            <!-- ── Header ── -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Border Background="#E3F2FD" CornerRadius="8" Padding="10,8" Margin="0,0,12,0">
                    <TextBlock Text="➕" FontSize="22"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Add New Student"
                               FontSize="18" FontWeight="Bold" Foreground="#1A1A2E"/>
                    <TextBlock Text="All fields with * are required"
                               FontSize="12" Foreground="#90A4AE"/>
                </StackPanel>
            </StackPanel>

            <Separator Background="#ECEFF1" Margin="0,0,0,8"/>

            <!-- ══════════════════════════════════════
                 SECTION 1 — IDENTITY
                 ══════════════════════════════════════ -->
            <TextBlock Style="{StaticResource SectionHead}" Text="👤  Student Identity"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Name -->
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Full Name *"/>
                    <TextBox x:Name="TxtName"
                             Style="{StaticResource InputBox}"
                             ToolTip="Student's full name as it should appear on receipts"/>
                </StackPanel>

                <!-- Father Name -->
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Father's Name *"/>
                    <TextBox x:Name="TxtFather"
                             Style="{StaticResource InputBox}"
                             ToolTip="Father's / guardian's full name"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Phone -->
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Phone / Contact No."/>
                    <TextBox x:Name="TxtPhone"
                             Style="{StaticResource InputBox}"
                             ToolTip="10-digit mobile number"/>
                </StackPanel>

                <!-- Category -->
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Category *"/>
                    <ComboBox x:Name="CmbCategory"
                              Style="{StaticResource InputCombo}"
                              ToolTip="Caste / reservation category">
                        <ComboBoxItem Content="GEN"     IsSelected="True"/>
                        <ComboBoxItem Content="GEN FW"/>
                        <ComboBoxItem Content="OBC"/>
                        <ComboBoxItem Content="OBC FW"/>
                        <ComboBoxItem Content="BC"/>
                        <ComboBoxItem Content="FW BC"/>
                        <ComboBoxItem Content="SC"/>
                        <ComboBoxItem Content="ST"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- ══════════════════════════════════════
                 SECTION 2 — CURRENT QUARTER FEES
                 ══════════════════════════════════════ -->
            <TextBlock Style="{StaticResource SectionHead}" Text="💰  Current Quarter Fees  (leave 0 if not applicable)"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="10"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <!-- Quarterly Fees (main) -->
                <StackPanel Grid.Column="0" Grid.Row="0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Quarterly Fees (₹)"/>
                    <TextBox x:Name="TxtQuarterly" Style="{StaticResource InputBox}" Text="0"
                             ToolTip="Main quarterly tuition / course fee"/>
                </StackPanel>

                <!-- Comprehensive Insurance -->
                <StackPanel Grid.Column="2" Grid.Row="0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Comprehensive Ins. (₹)"/>
                    <TextBox x:Name="TxtInsurance" Style="{StaticResource InputBox}" Text="0"
                             ToolTip="Comprehensive insurance amount"/>
                </StackPanel>

                <!-- Red Cross Fund -->
                <StackPanel Grid.Column="4" Grid.Row="0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Red Cross Fund (₹)"/>
                    <TextBox x:Name="TxtRedCross" Style="{StaticResource InputBox}" Text="0"
                             ToolTip="Red Cross / welfare fund contribution"/>
                </StackPanel>

                <!-- Development & Welfare -->
                <StackPanel Grid.Column="0" Grid.Row="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Development &amp; Welfare (₹)"/>
                    <TextBox x:Name="TxtWelfare" Style="{StaticResource InputBox}" Text="0"
                             ToolTip="Development and welfare fund"/>
                </StackPanel>

                <!-- Student Activities -->
                <StackPanel Grid.Column="2" Grid.Row="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Student Activities (₹)"/>
                    <TextBox x:Name="TxtStudentActivities" Style="{StaticResource InputBox}" Text="0"
                             ToolTip="Student activities / cultural fund"/>
                </StackPanel>

                <!-- Institutional Security / Refundable -->
                <StackPanel Grid.Column="4" Grid.Row="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Inst. Security (₹)"/>
                    <TextBox x:Name="TxtInstitutional" Style="{StaticResource InputBox}" Text="0"
                             ToolTip="Institutional security / refundable deposit"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Stationary -->
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Stationary (₹)"/>
                    <TextBox x:Name="TxtStationary" Style="{StaticResource InputBox}" Text="0"
                             ToolTip="Stationary / stationery charges"/>
                </StackPanel>

                <!-- Hostel -->
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Hostel (₹)"/>
                    <TextBox x:Name="TxtHostel" Style="{StaticResource InputBox}" Text="0"
                             ToolTip="Hostel fee (if applicable)"/>
                </StackPanel>

                <!-- (spare column) -->
                <StackPanel Grid.Column="4"/>

            </Grid>

            <!-- ══════════════════════════════════════
                 SECTION 3 — PREVIOUS ARREARS
                 ══════════════════════════════════════ -->
            <TextBlock Style="{StaticResource SectionHead}" Text="🔴  Previous Quarter Arrears"/>

            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Previous Quarter Pending Fees (₹)"/>
                <TextBox x:Name="TxtPrevPending" Style="{StaticResource InputBox}" Text="0"
                         ToolTip="Any outstanding fee carried forward from a prior quarter"/>
            </StackPanel>

            <!-- ── Validation error message ── -->
            <Border x:Name="ErrorBanner"
                    Background="#FFEBEE" BorderBrush="#EF9A9A" BorderThickness="1"
                    CornerRadius="6" Padding="12,8" Margin="0,14,0,0"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠️ " FontSize="14"/>
                    <TextBlock x:Name="TxtError"
                               FontSize="13" Foreground="#C62828"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- ── Buttons ── -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,4">
                <Button x:Name="BtnCancel"
                        Content="Cancel"
                        Style="{StaticResource ActionBtn}"
                        Background="#ECEFF1" Foreground="#546E7A"
                        Margin="0,0,10,0"
                        Click="BtnCancel_Click"/>
                <Button x:Name="BtnSave"
                        Content="✅  Add Student"
                        Style="{StaticResource ActionBtn}"
                        Background="#1976D2" Foreground="White"
                        Click="BtnSave_Click"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
