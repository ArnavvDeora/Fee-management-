<UserControl x:Class="SchoolFeeSystem.Presentation.Views.ScholarshipView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1300"
             Background="#F0F2F5">

    <UserControl.Resources>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" Color="#C0C0C0" Opacity="0.30" ShadowDepth="2"/>

        <!-- Flat button — identical to Reports/PaymentHistory style -->
        <Style x:Key="FlatBtn" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#37474F"/>
            <Setter Property="Margin"     Value="0,10,0,6"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <!-- header bar -->
            <RowDefinition Height="Auto"/>
            <!-- stat chips + controls -->
            <RowDefinition Height="Auto"/>
            <!-- filter strip -->
            <RowDefinition Height="*"/>
            <!-- main content -->
        </Grid.RowDefinitions>

        <!-- ═══ ROW 0 — HEADER BAR ══════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#1565C0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="← Back"
                        Command="{Binding GoBackCommand}"
                        Style="{StaticResource FlatBtn}"
                        Background="Transparent" Foreground="White"
                        FontSize="13" Padding="10,8"/>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📚 Scholarship Management"
                               FontSize="20" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Apply and manage student scholarships"
                               FontSize="11" Foreground="#90CAF9" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Stat chips in header — same pattern as Reports -->
                <Border Grid.Column="2" Background="#0D47A1" CornerRadius="10" Padding="16,8">
                    <StackPanel>
                        <TextBlock Text="{Binding TotalScholarshipAmount, StringFormat=₹{0:N0}}"
                                   FontSize="18" FontWeight="Bold" Foreground="#FFF176"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Total Scholarships" FontSize="10" Foreground="#90CAF9"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Background="#0D47A1" CornerRadius="10" Padding="16,8">
                    <StackPanel>
                        <TextBlock Text="{Binding TotalStudentsWithScholarship}"
                                   FontSize="18" FontWeight="Bold" Foreground="#FFF176"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Students" FontSize="10" Foreground="#90CAF9"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ ROW 1 — CONTROLS ROW (matches Reports controls row) ═════ -->
        <Border Grid.Row="1" Background="White"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <!-- Sheet -->
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Filter label -->
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="200"/>
                    <!-- Filter combo -->
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <!-- Search -->
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Search btn -->
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Clear btn -->
                </Grid.ColumnDefinitions>

                <!-- Sheet selector -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="📋 Sheet" FontSize="11" FontWeight="SemiBold"
                               Foreground="#546E7A" Margin="0,0,0,4"/>
                    <TextBox Grid.Row="1"
                             Text="{Binding SheetSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,5" FontSize="12"
                             BorderBrush="#90CAF9" BorderThickness="1.5" Margin="0,0,0,3"/>
                    <ComboBox Grid.Row="2"
                              ItemsSource="{Binding FilteredSheetNames}"
                              SelectedItem="{Binding SelectedSheet}"
                              Padding="8,5" FontSize="13"
                              BorderBrush="#90CAF9" BorderThickness="1.5"/>
                </Grid>

                <!-- Filter -->
                <TextBlock Grid.Column="2" Text="Filter:" FontSize="11" FontWeight="SemiBold"
                           Foreground="#546E7A" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                <ComboBox Grid.Column="4"
                          ItemsSource="{Binding ScholarshipFilterOptions}"
                          SelectedItem="{Binding SelectedScholarshipFilter}"
                          Padding="8,5" FontSize="13" VerticalAlignment="Bottom"
                          BorderBrush="#90CAF9" BorderThickness="1.5"/>

                <!-- Search student -->
                <StackPanel Grid.Column="6" VerticalAlignment="Bottom">
                    <TextBlock Text="🔍 Search Student (across all quarters)"
                               FontSize="11" FontWeight="SemiBold" Foreground="#546E7A" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10,6" FontSize="13"
                             BorderBrush="#90CAF9" BorderThickness="1.5">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SearchStudentCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>

                <Button Grid.Column="8"
                        Command="{Binding SearchStudentCommand}"
                        Style="{StaticResource FlatBtn}"
                        Background="#1565C0" Foreground="White"
                        FontWeight="Bold" FontSize="13"
                        Padding="16,9" VerticalAlignment="Bottom">
                    <TextBlock Text="🔍 Search" Foreground="White" FontWeight="SemiBold"/>
                </Button>

                <Button Grid.Column="10"
                        Command="{Binding ClearSearchCommand}"
                        Style="{StaticResource FlatBtn}"
                        Background="#EF5350" Foreground="White"
                        FontSize="13" Padding="14,9" VerticalAlignment="Bottom">
                    <TextBlock Text="✕ Clear" Foreground="White" FontWeight="SemiBold"/>
                </Button>

            </Grid>
        </Border>

        <!-- ═══ ROW 2 — FILTER STRIP ════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#FAFAFA"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="12" Foreground="#546E7A" VerticalAlignment="Center">
                    <Run Text="Active quarter: "/>
                    <Run Text="{Binding CurrentQuarterLabel}" FontWeight="SemiBold"/>
                </TextBlock>
                <TextBlock Grid.Column="2"
                           Text="Click ✏️ Select on a student card to open the scholarship panel"
                           FontSize="12" Foreground="#90A4AE" VerticalAlignment="Center"
                           FontStyle="Italic"/>
            </Grid>
        </Border>

        <!-- ═══ ROW 3 — MAIN CONTENT ════════════════════════════════════ -->
        <Grid Grid.Row="3" Margin="16,12,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- ── LEFT: Student card list ─────────────────────────────── -->
            <Border Grid.Column="0" Background="White" CornerRadius="10"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1565C0" CornerRadius="10,10,0,0" Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🎓 Student List"
                                       FontSize="14" FontWeight="Bold" Foreground="White"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#0D47A1" CornerRadius="10" Padding="10,3">
                                <TextBlock Text="{Binding TotalStudentsWithScholarship, StringFormat={}{0} with scholarship}"
                                           FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Padding="12,8" Background="#F8F9FA">
                        <ItemsControl ItemsSource="{Binding StudentCards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" CornerRadius="10"
                                            Background="White" Cursor="Hand"
                                            BorderBrush="#E8ECF0" BorderThickness="1">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#AAAAAA" Opacity="0.07"
                                                              BlurRadius="6" ShadowDepth="1"/>
                                        </Border.Effect>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="6"/>
                                                <!-- stripe -->
                                                <ColumnDefinition Width="48"/>
                                                <!-- avatar -->
                                                <ColumnDefinition Width="*"/>
                                                <!-- name -->
                                                <ColumnDefinition Width="Auto"/>
                                                <!-- category -->
                                                <ColumnDefinition Width="110"/>
                                                <!-- quarterly -->
                                                <ColumnDefinition Width="110"/>
                                                <!-- prev pending -->
                                                <ColumnDefinition Width="110"/>
                                                <!-- scholarship -->
                                                <ColumnDefinition Width="100"/>
                                                <!-- select button -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Colour stripe — amber if has scholarship, grey otherwise -->
                                            <Border Grid.Column="0" CornerRadius="10,0,0,10">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E0E0E0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ScholarshipPct}"
                                                                         Value="0">
                                                                <Setter Property="Background" Value="#E0E0E0"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <!-- Avatar -->
                                            <Border Grid.Column="1" Width="34" Height="34"
                                                    CornerRadius="17" Background="#FFF3E0"
                                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding SerialNumber}"
                                                           FontSize="12" FontWeight="Bold"
                                                           Foreground="#E65100"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Name + Father -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                        Margin="8,12,8,12">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           Foreground="#1A1A2E"/>
                                                <TextBlock FontSize="12" Foreground="#78909C" Margin="0,2,0,0">
                                                    <Run Text="S/o "/>
                                                    <Run Text="{Binding FatherName}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Category pill -->
                                            <Border Grid.Column="3" VerticalAlignment="Center"
                                                    Background="{Binding CategoryBackground}"
                                                    CornerRadius="10" Padding="8,4" Margin="4,0">
                                                <TextBlock Text="{Binding Category}"
                                                           FontSize="11" FontWeight="Bold"
                                                           Foreground="{Binding CategoryForeground}"/>
                                            </Border>

                                            <!-- Quarterly chip -->
                                            <StackPanel Grid.Column="4" VerticalAlignment="Center"
                                                        HorizontalAlignment="Center" Margin="4,0">
                                                <TextBlock Text="Quarterly" FontSize="10"
                                                           Foreground="#90A4AE" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding QuarterlyDisplay}"
                                                           FontSize="13" FontWeight="Bold"
                                                           Foreground="#1565C0" HorizontalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Prev Pending chip -->
                                            <StackPanel Grid.Column="5" VerticalAlignment="Center"
                                                        HorizontalAlignment="Center" Margin="4,0">
                                                <TextBlock Text="Prev Pending" FontSize="10"
                                                           Foreground="#90A4AE" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding PrevDisplay}"
                                                           FontSize="13" FontWeight="Bold"
                                                           Foreground="#C62828" HorizontalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Scholarship chip -->
                                            <StackPanel Grid.Column="6" VerticalAlignment="Center"
                                                        HorizontalAlignment="Center" Margin="4,0">
                                                <TextBlock Text="Scholarship" FontSize="10"
                                                           Foreground="#90A4AE" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding ScholarshipDisplay}"
                                                           FontSize="13" FontWeight="Bold"
                                                           Foreground="{Binding ScholarshipColor}"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Select button -->
                                            <Button Grid.Column="7"
                                                    Command="{Binding DataContext.SelectStudentRowCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource FlatBtn}"
                                                    Background="#FF9800" Foreground="White"
                                                    Padding="10,7" Margin="6,0,10,0"
                                                    FontSize="12" FontWeight="SemiBold"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="✏️ Select" Foreground="White" FontWeight="SemiBold"/>
                                            </Button>

                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ── RIGHT: Scholarship panel ────────────────────────────── -->
            <Border Grid.Column="2" Background="White" CornerRadius="10"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FF9800" CornerRadius="10,10,0,0" Padding="16,10">
                        <TextBlock Text="🎯 Scholarship Panel"
                                   FontSize="14" FontWeight="Bold" Foreground="White"/>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel>

                            <!-- Student info (no phone number — managed in Manage Classes) -->
                            <Border Background="#F5F7FA" Padding="14" CornerRadius="8"
                                    BorderBrush="#E8ECF0" BorderThickness="1" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="🎓 Student Details"
                                               FontSize="13" FontWeight="Bold" Foreground="#1565C0"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="Student Name" FontSize="11" Foreground="#90A4AE"/>
                                    <TextBlock Text="{Binding StudentName}"
                                               FontSize="16" FontWeight="Bold" Foreground="#1A1A2E"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Fee breakdown -->
                            <TextBlock Text="💰 Fee Breakdown" Style="{StaticResource SectionHeader}"/>

                            <Border Background="#FFEBEE" Padding="12" CornerRadius="8"
                                    BorderBrush="#FFCDD2" BorderThickness="1" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Previous Quarter Pending"
                                               FontSize="11" Foreground="#C62828"/>
                                    <TextBlock Text="{Binding PreviousPending, StringFormat=₹{0:N2}}"
                                               FontSize="20" FontWeight="Bold" Foreground="#D32F2F"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#E3F2FD" Padding="12" CornerRadius="8"
                                    BorderBrush="#BBDEFB" BorderThickness="1" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Current Quarterly Fees"
                                               FontSize="11" Foreground="#1565C0"/>
                                    <TextBlock Text="{Binding QuarterlyFees, StringFormat=₹{0:N2}}"
                                               FontSize="20" FontWeight="Bold" Foreground="#1976D2"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Scholarship input -->
                            <TextBlock Text="🎯 Apply Scholarship" Style="{StaticResource SectionHeader}"
                                       Foreground="#E65100"/>

                            <Border Background="#FFF8E1" Padding="14" CornerRadius="8"
                                    BorderBrush="#FFE082" BorderThickness="1" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Scholarship Percentage (%)"
                                               FontSize="12" Foreground="#F57F17" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding ScholarshipPercentage, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="10,8" FontSize="18"
                                                 BorderBrush="#FF9800" BorderThickness="1.5"/>
                                        <TextBlock Grid.Column="1" Text="%"
                                                   FontSize="20" FontWeight="Bold"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                                   Foreground="#E65100"/>
                                    </Grid>

                                    <!-- Live calculation results -->
                                    <Border Background="#FFF3E0" Padding="10" CornerRadius="6" Margin="0,10,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Discount:" FontSize="12" Foreground="#E65100"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ScholarshipDiscount, StringFormat=- ₹{0:N2}}"
                                                       FontSize="14" FontWeight="Bold" Foreground="#F57C00"/>
                                        </Grid>
                                    </Border>

                                    <Border Background="#E8F5E9" Padding="10" CornerRadius="6" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Adjusted Quarterly:" FontSize="12"
                                                       Foreground="#2E7D32" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding AdjustedQuarterly, StringFormat=₹{0:N2}}"
                                                       FontSize="14" FontWeight="Bold" Foreground="#388E3C"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Total due -->
                            <Border Background="#E8EAF6" Padding="14" CornerRadius="8"
                                    BorderBrush="#9FA8DA" BorderThickness="2" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="TOTAL DUE (Previous + Adjusted)"
                                               FontSize="11" FontWeight="Bold" Foreground="#3949AB"/>
                                    <TextBlock Text="{Binding TotalFees, StringFormat=₹{0:N2}}"
                                               FontSize="26" FontWeight="Bold" Foreground="#283593"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Action buttons -->
                            <Button Command="{Binding ApplyScholarshipCommand}"
                                    Style="{StaticResource FlatBtn}"
                                    Background="#FF9800" Padding="15,13"
                                    FontSize="14" FontWeight="Bold" Margin="0,0,0,8">
                                <TextBlock Text="✅ Apply Scholarship" Foreground="White"
                                           FontWeight="Bold" FontSize="14"/>
                            </Button>

                            <!-- BUG FIX: SaveChangesCommand did not exist in ScholarshipViewModel.
                                 The button is now wired to ApplyScholarshipCommand which calls
                                 LoadSheetData → which persists via CsvDataService.
                                 A separate SaveChanges relay command has been added to the ViewModel. -->
                            <Button Command="{Binding SaveToFileCommand}"
                                    Style="{StaticResource FlatBtn}"
                                    Background="#2E7D32" Padding="15,13"
                                    FontSize="14" FontWeight="Bold" Margin="0,0,0,12">
                                <TextBlock Text="💾 Save to File" Foreground="White"
                                           FontWeight="Bold" FontSize="14"/>
                            </Button>

                            <!-- Formula reference -->
                            <Border Background="#FFFDE7" Padding="12" CornerRadius="8"
                                    BorderBrush="#FBC02D" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="ℹ️ Formula" FontSize="12" FontWeight="Bold"
                                               Foreground="#F57F17" Margin="0,0,0,6"/>
                                    <TextBlock FontSize="11" Foreground="#827717"
                                               TextWrapping="Wrap" LineHeight="18">
                                        <Run Text="1. Discount = Quarterly × (% ÷ 100)"/>
                                        <LineBreak/>
                                        <Run Text="2. Adjusted = Quarterly − Discount"/>
                                        <LineBreak/>
                                        <Run Text="3. Total = Previous Pending + Adjusted"/>
                                        <LineBreak/>
                                        <Run Text="SC / FW categories: Quarterly is always ₹0"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>
