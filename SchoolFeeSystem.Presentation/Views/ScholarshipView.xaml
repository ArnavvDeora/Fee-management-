<UserControl x:Class="SchoolFeeSystem.Presentation.Views.ScholarshipView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.Resources>
        <DropShadowEffect x:Key="DropShadow"
                          Color="Black" Opacity="0.2"
                          BlurRadius="10" ShadowDepth="2"/>
    </UserControl.Resources>

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2196F3" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="← Back"
                        Command="{Binding GoBackCommand}"
                        Padding="15,8" Margin="0,0,20,0"
                        Background="#1976D2" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        FontSize="14" FontWeight="SemiBold"/>

                <TextBlock Grid.Column="1" Text="📚 Scholarship Management"
                           FontSize="28" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="💰 Total Scholarship Amount: "
                               FontSize="14" Foreground="White"
                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding TotalScholarshipAmount, StringFormat='₹{0:N2}'}"
                               FontSize="16" FontWeight="Bold"
                               Foreground="#FFF176" VerticalAlignment="Center"/>
                    <TextBlock Text=" | 👥 Students: "
                               FontSize="14" Foreground="White"
                               VerticalAlignment="Center" Margin="15,0,5,0"/>
                    <TextBlock Text="{Binding TotalStudentsWithScholarship}"
                               FontSize="16" FontWeight="Bold"
                               Foreground="#FFF176" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Student List -->
            <Border Grid.Column="0" Background="White"
                    CornerRadius="8" Padding="20"
                    Effect="{StaticResource DropShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Sheet Selection -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="📋 Select Sheet:" FontSize="14"
                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <TextBox Text="{Binding SheetSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Width="150" Height="32" Margin="0,0,10,0"
                                 VerticalContentAlignment="Center"
                                 FontSize="12" Padding="8,5"
                                 BorderBrush="#BDBDBD" BorderThickness="1"/>
                        <ComboBox ItemsSource="{Binding FilteredSheetNames}"
                                  SelectedItem="{Binding SelectedSheet}"
                                  Width="250" Height="32"
                                  FontSize="12" Padding="8,5"
                                  BorderBrush="#BDBDBD" BorderThickness="1"/>
                    </StackPanel>

                    <!-- Filter Options -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="🔍 Filter:" FontSize="14"
                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <ComboBox ItemsSource="{Binding ScholarshipFilterOptions}"
                                  SelectedItem="{Binding SelectedScholarshipFilter}"
                                  Width="200" Height="32"
                                  FontSize="12" Padding="8,5"
                                  BorderBrush="#BDBDBD" BorderThickness="1"/>
                    </StackPanel>

                    <!-- Search Bar -->
                    <Grid Grid.Row="2" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="36" Padding="10,8"
                                 FontSize="13" VerticalContentAlignment="Center"
                                 BorderBrush="#BDBDBD" BorderThickness="1"
                                 Background="White">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SearchStudentCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <Button Grid.Column="1" Content="🔍 Search"
                                Command="{Binding SearchStudentCommand}"
                                Width="100" Height="36" Margin="10,0,0,0"
                                Background="#4CAF50" Foreground="White"
                                BorderThickness="0" Cursor="Hand"
                                FontSize="13" FontWeight="SemiBold"/>

                        <Button Grid.Column="2" Content="✕ Clear"
                                Command="{Binding ClearSearchCommand}"
                                Width="80" Height="36" Margin="10,0,0,0"
                                Background="#F44336" Foreground="White"
                                BorderThickness="0" Cursor="Hand"
                                FontSize="13" FontWeight="SemiBold"/>
                    </Grid>

                    <!-- Student DataGrid -->
                    <DataGrid Grid.Row="3"
                              ItemsSource="{Binding StudentView}"
                              SelectedItem="{Binding SelectedRow}"
                              AutoGenerateColumns="True"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              GridLinesVisibility="All"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              AlternatingRowBackground="#F5F5F5"
                              RowBackground="White"
                              BorderBrush="#BDBDBD" BorderThickness="1">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#2196F3"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="BorderBrush" Value="White"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Right Panel: Scholarship Management -->
            <Border Grid.Column="2" Background="White"
                    CornerRadius="8" Padding="20"
                    Effect="{StaticResource DropShadow}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="🎓 Student Details"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="#2196F3" Margin="0,0,0,20"/>

                        <!-- Student Name -->
                        <TextBlock Text="Student Name:" FontSize="12"
                                   Foreground="#757575" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding StudentName}"
                                 IsReadOnly="True" Height="32"
                                 Padding="8,5" Margin="0,0,0,15"
                                 Background="#F5F5F5"
                                 BorderBrush="#BDBDBD" BorderThickness="1"/>

                        <!-- Phone Number -->
                        <TextBlock Text="📱 Phone Number:" FontSize="12"
                                   Foreground="#757575" Margin="0,0,0,5"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                     Height="32" Padding="8,5"
                                     BorderBrush="#BDBDBD" BorderThickness="1"/>
                            <Button Grid.Column="1" Content="💾"
                                    Command="{Binding UpdatePhoneNumberCommand}"
                                    Width="40" Height="32" Margin="5,0,0,0"
                                    Background="#4CAF50" Foreground="White"
                                    BorderThickness="0" Cursor="Hand"
                                    ToolTip="Update Phone Number"/>
                        </Grid>

                        <Separator Margin="0,10,0,20" Background="#E0E0E0"/>

                        <!-- Fee Breakdown -->
                        <TextBlock Text="💰 Fee Breakdown"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="#2196F3" Margin="0,0,0,15"/>

                        <!-- Previous Pending -->
                        <Border Background="#FFEBEE" Padding="10"
                                Margin="0,0,0,10" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="Previous Quarter Pending:"
                                           FontSize="11" Foreground="#C62828"/>
                                <TextBlock Text="{Binding PreviousPending, StringFormat='₹{0:N2}'}"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="#D32F2F"/>
                            </StackPanel>
                        </Border>

                        <!-- Quarterly Fees -->
                        <Border Background="#E3F2FD" Padding="10"
                                Margin="0,0,0,10" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="Current Quarterly Fees:"
                                           FontSize="11" Foreground="#1565C0"/>
                                <TextBlock Text="{Binding QuarterlyFees, StringFormat='₹{0:N2}'}"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="#1976D2"/>
                            </StackPanel>
                        </Border>

                        <Separator Margin="0,10,0,15" Background="#E0E0E0"/>

                        <!-- Scholarship Section -->
                        <TextBlock Text="🎯 Scholarship Application"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="#FF9800" Margin="0,0,0,10"/>

                        <TextBlock Text="Scholarship Percentage (%):"
                                   FontSize="12" Foreground="#757575"
                                   Margin="0,0,0,5"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding ScholarshipPercentage, UpdateSourceTrigger=PropertyChanged}"
                                     Height="36" Padding="10,8" FontSize="14"
                                     BorderBrush="#FF9800" BorderThickness="2"/>
                            <TextBlock Grid.Column="1" Text="%"
                                       FontSize="18" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>

                        <!-- Scholarship Discount -->
                        <Border Background="#FFF3E0" Padding="10"
                                Margin="0,0,0,10" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="Scholarship Discount:"
                                           FontSize="11" Foreground="#E65100"/>
                                <TextBlock Text="{Binding ScholarshipDiscount, StringFormat='- ₹{0:N2}'}"
                                           FontSize="15" FontWeight="Bold"
                                           Foreground="#F57C00"/>
                            </StackPanel>
                        </Border>

                        <!-- Adjusted Quarterly -->
                        <Border Background="#E8F5E9" Padding="10"
                                Margin="0,0,0,10" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="Adjusted Quarterly (After Scholarship):"
                                           FontSize="11" Foreground="#2E7D32"/>
                                <TextBlock Text="{Binding AdjustedQuarterly, StringFormat='₹{0:N2}'}"
                                           FontSize="15" FontWeight="Bold"
                                           Foreground="#388E3C"/>
                            </StackPanel>
                        </Border>

                        <!-- Total Fees -->
                        <Border Background="#C5CAE9" Padding="12"
                                Margin="0,0,0,15" CornerRadius="4"
                                BorderBrush="#3F51B5" BorderThickness="2">
                            <StackPanel>
                                <TextBlock Text="Total Fees (Previous + Adjusted):"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="#1A237E"/>
                                <TextBlock Text="{Binding TotalFees, StringFormat='₹{0:N2}'}"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="#303F9F"/>
                            </StackPanel>
                        </Border>

                        <!-- Apply Button -->
                        <Button Content="✅ Apply Scholarship"
                                Command="{Binding ApplyScholarshipCommand}"
                                Height="45" Margin="0,0,0,10"
                                Background="#FF9800" Foreground="White"
                                BorderThickness="0" Cursor="Hand"
                                FontSize="15" FontWeight="Bold"/>

                        <!-- Save Button -->
                        <Button Content="💾 Save All Changes"
                                Command="{Binding SaveChangesCommand}"
                                Height="45" Margin="0,0,0,10"
                                Background="#4CAF50" Foreground="White"
                                BorderThickness="0" Cursor="Hand"
                                FontSize="15" FontWeight="Bold"/>

                        <!-- Formula Info -->
                        <Border Background="#FFFDE7" Padding="10"
                                Margin="0,10,0,0" CornerRadius="4"
                                BorderBrush="#FBC02D" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="ℹ️ Calculation Formula:"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="#F57F17" Margin="0,0,0,5"/>
                                <TextBlock TextWrapping="Wrap" FontSize="10"
                                           Foreground="#827717">
									<Run Text="1. Scholarship Discount = Quarterly × (Scholarship % ÷ 100)"/>
									<LineBreak/>
									<Run Text="2. Adjusted Quarterly = Quarterly - Discount"/>
									<LineBreak/>
									<Run Text="3. Total = Previous Pending + Adjusted Quarterly"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>