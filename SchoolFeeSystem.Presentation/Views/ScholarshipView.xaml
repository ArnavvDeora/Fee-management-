<UserControl x:Class="SchoolFeeSystem.Presentation.Views.ScholarshipView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1300"
             Background="#F0F2F5">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" Color="#C0C0C0" Opacity="0.30" ShadowDepth="2"/>

        <!-- Flat button — identical to Reports/PaymentHistory style -->
        <Style x:Key="FlatBtn" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#37474F"/>
            <Setter Property="Margin"     Value="0,10,0,6"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <!-- header bar -->
            <RowDefinition Height="Auto"/>
            <!-- stat chips + controls -->
            <RowDefinition Height="Auto"/>
            <!-- filter strip -->
            <RowDefinition Height="*"/>
            <!-- main content -->
        </Grid.RowDefinitions>

        <!-- ═══ ROW 0 — HEADER BAR ══════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#1565C0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="← Back"
                        Command="{Binding GoBackCommand}"
                        Style="{StaticResource FlatBtn}"
                        Background="Transparent" Foreground="White"
                        FontSize="13" Padding="10,8"/>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📚 Scholarship Management"
                               FontSize="20" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Apply and manage student scholarships"
                               FontSize="11" Foreground="#90CAF9" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Stat chips in header — same pattern as Reports -->
                <Border Grid.Column="2" Background="#0D47A1" CornerRadius="10" Padding="16,8">
                    <StackPanel>
                        <TextBlock Text="{Binding TotalScholarshipAmount, StringFormat=₹{0:N0}}"
                                   FontSize="18" FontWeight="Bold" Foreground="#FFF176"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Total Scholarships" FontSize="10" Foreground="#90CAF9"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Background="#0D47A1" CornerRadius="10" Padding="16,8">
                    <StackPanel>
                        <TextBlock Text="{Binding TotalStudentsWithScholarship}"
                                   FontSize="18" FontWeight="Bold" Foreground="#FFF176"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Students" FontSize="10" Foreground="#90CAF9"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ ROW 1 — COURSE CONTEXT BAR + SEARCH ═══════════════════════
             Replaces the old sheet-search-box + dropdown clutter. Shows the
             current class as a clean human label and lets the admin switch
             via a popup picker (overlay defined at bottom of this file). ─ -->
        <Border Grid.Row="1" Background="White"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <!-- Course context bar -->
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Filter label -->
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="180"/>
                    <!-- Filter combo -->
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="280"/>
                    <!-- Search box -->
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Search btn -->
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Clear btn -->
                </Grid.ColumnDefinitions>

                <!-- ── Course context bar ────────────────────────────── -->
                <Border Grid.Column="0" Background="#F8FAFC"
                        BorderBrush="#CFD8DC" BorderThickness="1"
                        CornerRadius="8" Padding="12,8" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="44" Height="44"
                                CornerRadius="22"
                                Background="{Binding CurrentCourseAvatarBg}">
                            <TextBlock Text="{Binding CurrentCourseInitials}"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="{Binding CurrentCourseAvatarFg}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentCourseTitle}"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="#212121" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding CurrentCourseSubtitle}"
                                       FontSize="11" Foreground="#607D8B"
                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Switch class: opens a small anchored popup below this button.
                             StaysOpen="False" → clicking anywhere outside auto-closes.
                             No modal, no full-screen overlay, no blocking. -->
                        <Grid Grid.Column="3">
                            <Button x:Name="SwitchClassBtn"
                                    Command="{Binding OpenClassPickerCommand}"
                                    Style="{StaticResource FlatBtn}"
                                    Background="#1565C0" Foreground="White"
                                    Padding="14,8" FontSize="12" FontWeight="SemiBold"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⇄ " FontSize="13" Foreground="White"/>
                                    <TextBlock Text="Switch class" Foreground="White" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Popup PlacementTarget="{Binding ElementName=SwitchClassBtn}"
                                   Placement="Bottom"
                                   HorizontalOffset="-380"
                                   VerticalOffset="6"
                                   IsOpen="{Binding IsClassPickerOpen, Mode=TwoWay}"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade">
                                <Border Background="White" CornerRadius="10"
                                        BorderBrush="#CFD8DC" BorderThickness="1"
                                        Width="500" MaxHeight="420"
                                        Effect="{StaticResource CardShadow}">
                                    <Grid Margin="16">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header -->
                                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                            <TextBlock Text="Switch Class" FontSize="15"
                                                       FontWeight="Bold" Foreground="#212121"/>
                                            <TextBlock Text="Pick a course to manage scholarships for"
                                                       FontSize="11" Foreground="#607D8B" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Search -->
                                        <Border Grid.Row="1" Background="#F5F7FA"
                                                BorderBrush="#CFD8DC" BorderThickness="1"
                                                CornerRadius="6" Padding="10,5" Margin="0,0,0,10">
                                            <TextBox Text="{Binding ClassPickerSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="Transparent" BorderThickness="0"
                                                     FontSize="12" Padding="0">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Style.Triggers>
                                                            <Trigger Property="Text" Value="">
                                                                <Setter Property="Background">
                                                                    <Setter.Value>
                                                                        <VisualBrush Stretch="None" AlignmentX="Left">
                                                                            <VisualBrush.Visual>
                                                                                <TextBlock Text="🔍 Search by name, department, or semester..."
                                                                                           Foreground="#9E9E9E" FontSize="12"/>
                                                                            </VisualBrush.Visual>
                                                                        </VisualBrush>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </Border>

                                        <!-- Course list (vertical, scrollable) -->
                                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding FilteredCourses}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.PickCourseCommand,
                                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Margin="0,0,0,6"
                                                                Background="Transparent" BorderThickness="0"
                                                                Cursor="Hand"
                                                                HorizontalContentAlignment="Stretch">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="CardBorder"
                                                                            Background="White"
                                                                            BorderBrush="#E0E0E0"
                                                                            BorderThickness="1"
                                                                            CornerRadius="6" Padding="10,8">
                                                                        <ContentPresenter/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#1565C0"/>
                                                                            <Setter TargetName="CardBorder" Property="Background" Value="#F5FAFF"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>

                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="10"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" Width="34" Height="34"
                                                                        CornerRadius="17"
                                                                        Background="{Binding AccentBg}"
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Initials}"
                                                                               FontSize="11" FontWeight="Bold"
                                                                               Foreground="{Binding AccentFg}"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>
                                                                </Border>
                                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Title}"
                                                                               FontSize="13" FontWeight="SemiBold"
                                                                               Foreground="#212121"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding Subtitle}"
                                                                               FontSize="10" Foreground="#607D8B"
                                                                               Margin="0,2,0,0"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <!-- Empty-state fallback (visible when popup opens but no courses parsed) -->
                                        <TextBlock Grid.Row="2"
                                                   Text="No courses available. Upload a class file first."
                                                   FontSize="12" Foreground="#90A4AE"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontStyle="Italic">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding FilteredCourses.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ── Filter ────────────────────────────────────────── -->
                <TextBlock Grid.Column="2" Text="Filter:" FontSize="11" FontWeight="SemiBold"
                           Foreground="#546E7A" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="4"
                          ItemsSource="{Binding ScholarshipFilterOptions}"
                          SelectedItem="{Binding SelectedScholarshipFilter}"
                          Padding="8,5" FontSize="13" VerticalAlignment="Center"
                          BorderBrush="#90CAF9" BorderThickness="1.5"/>

                <!-- ── Search (live as you type) ─────────────────────── -->
                <TextBox Grid.Column="6"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10,6" FontSize="13" VerticalAlignment="Center"
                         BorderBrush="#90CAF9" BorderThickness="1.5">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SearchStudentCommand}"/>
                    </TextBox.InputBindings>
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush Stretch="None" AlignmentX="Left">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="🔍 Type a name, father, or category..."
                                                               Foreground="#9E9E9E" Margin="8,0,0,0"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <Button Grid.Column="8"
                        Command="{Binding SearchStudentCommand}"
                        Style="{StaticResource FlatBtn}"
                        Background="#1565C0" Foreground="White"
                        FontWeight="Bold" FontSize="12"
                        Padding="12,7" VerticalAlignment="Center">
                    <TextBlock Text="🔍 Search" Foreground="White" FontWeight="SemiBold"/>
                </Button>

                <Button Grid.Column="10"
                        Command="{Binding ClearSearchCommand}"
                        Style="{StaticResource FlatBtn}"
                        Background="#EF5350" Foreground="White"
                        FontSize="12" Padding="10,7" VerticalAlignment="Center">
                    <TextBlock Text="✕ Clear" Foreground="White" FontWeight="SemiBold"/>
                </Button>

            </Grid>
        </Border>

        <!-- ═══ ROW 2 — FILTER STRIP ════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#FAFAFA"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="12" Foreground="#546E7A" VerticalAlignment="Center">
                    <Run Text="Active quarter: "/>
                    <Run Text="{Binding CurrentQuarterLabel, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>
                <TextBlock Grid.Column="2"
                           Text="Click ✏️ Select on a student card to open the scholarship panel"
                           FontSize="12" Foreground="#90A4AE" VerticalAlignment="Center"
                           FontStyle="Italic"/>
            </Grid>
        </Border>

        <!-- ═══ ROW 3 — MAIN CONTENT ════════════════════════════════════ -->
        <Grid Grid.Row="3" Margin="16,12,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- ── LEFT: Student card list ─────────────────────────────── -->
            <Border Grid.Column="0" Background="White" CornerRadius="10"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1565C0" CornerRadius="10,10,0,0" Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🎓 Student List"
                                       FontSize="14" FontWeight="Bold" Foreground="White"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#0D47A1" CornerRadius="10" Padding="10,3">
                                <TextBlock Text="{Binding TotalStudentsWithScholarship, StringFormat={}{0} with scholarship}"
                                           FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Padding="12,8" Background="#F8F9FA">
                        <ItemsControl ItemsSource="{Binding StudentCards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" CornerRadius="10"
                                            Background="White" Cursor="Hand"
                                            BorderBrush="#E8ECF0" BorderThickness="1">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#AAAAAA" Opacity="0.07"
                                                              BlurRadius="6" ShadowDepth="1"/>
                                        </Border.Effect>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="6"/>
                                                <!-- stripe -->
                                                <ColumnDefinition Width="48"/>
                                                <!-- avatar -->
                                                <ColumnDefinition Width="*"/>
                                                <!-- name -->
                                                <ColumnDefinition Width="Auto"/>
                                                <!-- category -->
                                                <ColumnDefinition Width="110"/>
                                                <!-- quarterly -->
                                                <ColumnDefinition Width="110"/>
                                                <!-- prev pending -->
                                                <ColumnDefinition Width="110"/>
                                                <!-- scholarship -->
                                                <ColumnDefinition Width="100"/>
                                                <!-- select button -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Colour stripe — amber if has scholarship, grey otherwise -->
                                            <Border Grid.Column="0" CornerRadius="10,0,0,10">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E0E0E0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ScholarshipPct}"
                                                                         Value="0">
                                                                <Setter Property="Background" Value="#E0E0E0"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <!-- Avatar -->
                                            <Border Grid.Column="1" Width="34" Height="34"
                                                    CornerRadius="17" Background="#FFF3E0"
                                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding SerialNumber}"
                                                           FontSize="12" FontWeight="Bold"
                                                           Foreground="#E65100"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Name + Father -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                        Margin="8,12,8,12">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           Foreground="#1A1A2E"/>
                                                <TextBlock FontSize="12" Foreground="#78909C" Margin="0,2,0,0">
                                                    <Run Text="S/o "/>
                                                    <Run Text="{Binding FatherName, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Category pill -->
                                            <Border Grid.Column="3" VerticalAlignment="Center"
                                                    Background="{Binding CategoryBackground}"
                                                    CornerRadius="10" Padding="8,4" Margin="4,0">
                                                <TextBlock Text="{Binding Category}"
                                                           FontSize="11" FontWeight="Bold"
                                                           Foreground="{Binding CategoryForeground}"/>
                                            </Border>

                                            <!-- Quarterly chip -->
                                            <StackPanel Grid.Column="4" VerticalAlignment="Center"
                                                        HorizontalAlignment="Center" Margin="4,0">
                                                <TextBlock Text="Quarterly" FontSize="10"
                                                           Foreground="#90A4AE" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding QuarterlyDisplay}"
                                                           FontSize="13" FontWeight="Bold"
                                                           Foreground="#1565C0" HorizontalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Prev Pending chip -->
                                            <StackPanel Grid.Column="5" VerticalAlignment="Center"
                                                        HorizontalAlignment="Center" Margin="4,0">
                                                <TextBlock Text="Prev Pending" FontSize="10"
                                                           Foreground="#90A4AE" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding PrevDisplay}"
                                                           FontSize="13" FontWeight="Bold"
                                                           Foreground="#C62828" HorizontalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Scholarship chip -->
                                            <StackPanel Grid.Column="6" VerticalAlignment="Center"
                                                        HorizontalAlignment="Center" Margin="4,0">
                                                <TextBlock Text="Scholarship" FontSize="10"
                                                           Foreground="#90A4AE" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding ScholarshipDisplay}"
                                                           FontSize="13" FontWeight="Bold"
                                                           Foreground="{Binding ScholarshipColor}"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Select button -->
                                            <Button Grid.Column="7"
                                                    Command="{Binding DataContext.SelectStudentRowCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource FlatBtn}"
                                                    Background="#FF9800" Foreground="White"
                                                    Padding="10,7" Margin="6,0,10,0"
                                                    FontSize="12" FontWeight="SemiBold"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="✏️ Select" Foreground="White" FontWeight="SemiBold"/>
                                            </Button>

                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ═══ RIGHT: Scholarship panel — clean single-card design ═══
                 Replaces the old stack of 7+ competing colored boxes with
                 one unified panel. Layout sections (top→bottom):
                   1. Student header (avatar + name + category + father)
                   2. Fee row (previous pending  ·  quarterly fees)
                   3. Preset chips (0 / 10 / 25 / 50 / 100)
                   4. Custom % input + reason free-text
                   5. Live discount / adjusted / total
                   6. Single primary action button
                   7. Per-quarter reminder banner
                 ─────────────────────────────────────────────────────────── -->
            <Border Grid.Column="2" Background="White" CornerRadius="10"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Panel header -->
                    <Border Grid.Row="0" Background="#1565C0" CornerRadius="10,10,0,0" Padding="16,10">
                        <TextBlock Text="🎯 Scholarship Panel"
                                   FontSize="14" FontWeight="Bold" Foreground="White"/>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel>

                            <!-- ── Per-quarter reminder banner ────────────── -->
                            <Border Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1"
                                    CornerRadius="6" Padding="10,8" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="ℹ️" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#827717">
                                        <Run Text="Scholarships reset each quarter." FontWeight="SemiBold"/>
                                        <LineBreak/>
                                        <Run Text="Reapply for every new quarter."/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- ── Student header (compact) ───────────────── -->
                            <Border Padding="0,0,0,12" Margin="0,0,0,12"
                                    BorderBrush="#ECEFF1" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <TextBlock Text="STUDENT"
                                               FontSize="10" Foreground="#90A4AE"
                                               FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding StudentName, FallbackValue='No student selected'}"
                                               FontSize="16" FontWeight="Bold" Foreground="#1A1A2E"/>
                                </StackPanel>
                            </Border>

                            <!-- ── Fee summary (previous + quarterly side by side) ─ -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Previous pending" FontSize="10" Foreground="#90A4AE"/>
                                    <TextBlock Text="{Binding PreviousPending, StringFormat=₹{0:N0}}"
                                               FontSize="15" FontWeight="SemiBold" Foreground="#455A64"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Quarterly fees" FontSize="10" Foreground="#90A4AE"/>
                                    <TextBlock Text="{Binding QuarterlyFees, StringFormat=₹{0:N0}}"
                                               FontSize="15" FontWeight="SemiBold" Foreground="#455A64"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- ── Preset percentage chips ────────────────── -->
                            <TextBlock Text="SCHOLARSHIP %  ·  this quarter only"
                                       FontSize="10" Foreground="#90A4AE"
                                       FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Margin="0,0,4,0"
                                        Command="{Binding SetQuickPercentageCommand}"
                                        CommandParameter="0"
                                        Style="{StaticResource FlatBtn}"
                                        Background="#ECEFF1" Foreground="#37474F"
                                        Padding="0,8" FontSize="12">
                                    <TextBlock Text="0%" Foreground="#37474F" FontWeight="SemiBold"/>
                                </Button>
                                <Button Grid.Column="1" Margin="2,0,2,0"
                                        Command="{Binding SetQuickPercentageCommand}"
                                        CommandParameter="10"
                                        Style="{StaticResource FlatBtn}"
                                        Background="#E3F2FD" Foreground="#1565C0"
                                        Padding="0,8" FontSize="12">
                                    <TextBlock Text="10%" Foreground="#1565C0" FontWeight="SemiBold"/>
                                </Button>
                                <Button Grid.Column="2" Margin="2,0,2,0"
                                        Command="{Binding SetQuickPercentageCommand}"
                                        CommandParameter="25"
                                        Style="{StaticResource FlatBtn}"
                                        Background="#E3F2FD" Foreground="#1565C0"
                                        Padding="0,8" FontSize="12">
                                    <TextBlock Text="25%" Foreground="#1565C0" FontWeight="SemiBold"/>
                                </Button>
                                <Button Grid.Column="3" Margin="2,0,2,0"
                                        Command="{Binding SetQuickPercentageCommand}"
                                        CommandParameter="50"
                                        Style="{StaticResource FlatBtn}"
                                        Background="#E3F2FD" Foreground="#1565C0"
                                        Padding="0,8" FontSize="12">
                                    <TextBlock Text="50%" Foreground="#1565C0" FontWeight="SemiBold"/>
                                </Button>
                                <Button Grid.Column="4" Margin="4,0,0,0"
                                        Command="{Binding SetQuickPercentageCommand}"
                                        CommandParameter="100"
                                        Style="{StaticResource FlatBtn}"
                                        Background="#E8F5E9" Foreground="#2E7D32"
                                        Padding="0,8" FontSize="12">
                                    <TextBlock Text="100%" Foreground="#2E7D32" FontWeight="SemiBold"/>
                                </Button>
                            </Grid>

                            <!-- Custom % input -->
                            <Border BorderBrush="#90CAF9" BorderThickness="1.5" CornerRadius="6"
                                    Padding="10,6" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding ScholarshipPercentage, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" FontSize="16" FontWeight="SemiBold"
                                             Foreground="#1565C0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="% custom"
                                               FontSize="12" Foreground="#90A4AE"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- ── Reason free-text ───────────────────────── -->
                            <TextBlock Text="REASON  (optional)"
                                       FontSize="10" Foreground="#90A4AE"
                                       FontWeight="SemiBold" Margin="0,4,0,6"/>
                            <Border BorderBrush="#CFD8DC" BorderThickness="1" CornerRadius="6"
                                    Padding="10,7" Margin="0,0,0,16">
                                <TextBox Text="{Binding ScholarshipReason, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0" FontSize="13"
                                         Foreground="#37474F">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <VisualBrush Stretch="None" AlignmentX="Left">
                                                                <VisualBrush.Visual>
                                                                    <TextBlock Text="e.g. Merit, Sports, SC quota, Sibling discount…"
                                                                               Foreground="#B0BEC5" FontSize="12"/>
                                                                </VisualBrush.Visual>
                                                            </VisualBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Border>

                            <!-- ── Computed breakdown (single block) ──────── -->
                            <Border BorderBrush="#ECEFF1" BorderThickness="0,1,0,0"
                                    Padding="0,12,0,0" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Discount" FontSize="12" Foreground="#607D8B"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ScholarshipDiscount, StringFormat=−₹{0:N0}}"
                                                   FontSize="12" Foreground="#E65100" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Adjusted quarterly" FontSize="12" Foreground="#607D8B"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding AdjustedQuarterly, StringFormat=₹{0:N0}}"
                                                   FontSize="12" Foreground="#37474F" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Border BorderBrush="#ECEFF1" BorderThickness="0,1,0,0"
                                            Margin="0,6,0,0" Padding="0,8,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Total due" FontSize="14" FontWeight="Bold"
                                                       Foreground="#212121" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding TotalFees, StringFormat=₹{0:N0}}"
                                                       FontSize="20" FontWeight="Bold" Foreground="#1565C0"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- ── Single primary action ──────────────────── -->
                            <Button Command="{Binding ApplyScholarshipCommand}"
                                    Style="{StaticResource FlatBtn}"
                                    Background="#1565C0" Padding="0,12"
                                    FontSize="14" FontWeight="Bold" Margin="0,0,0,8">
                                <TextBlock Text="✅ Apply scholarship" Foreground="White"
                                           FontWeight="Bold" FontSize="14"/>
                            </Button>

                            <!-- Save to file (kept, but secondary) -->
                            <Button Command="{Binding SaveToFileCommand}"
                                    Style="{StaticResource FlatBtn}"
                                    Background="Transparent"
                                    Padding="0,8"
                                    FontSize="12" FontWeight="SemiBold">
                                <TextBlock Text="💾 Save all changes to file"
                                           Foreground="#1565C0" FontWeight="SemiBold" FontSize="12"/>
                            </Button>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

        </Grid>

    </Grid>
</UserControl>
