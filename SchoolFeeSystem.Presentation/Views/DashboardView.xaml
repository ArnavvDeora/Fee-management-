<UserControl x:Class="SchoolFeeSystem.Presentation.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1100"
             Background="#F8F9FA">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════════ HEADER ══════════════ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,40">

            <!-- Back button — identical template to PayrollDashboardView -->
            <Button Content="⬅ Back to Main Menu"
                    Command="{Binding GoBackToMainCommand}"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#7F8C8D"
                    FontWeight="Bold"
                    FontSize="14"
                    Cursor="Hand"
                    Margin="0,0,0,15"
                    Padding="5">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}"
                                            CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#3498DB"/>
                                <Setter Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <TextBlock Text="School Fee Management"
                       FontSize="32" FontWeight="Bold" Foreground="#2C3E50"/>
            <TextBlock Text="Manage students, fees, fines, scholarships, and reports."
                       FontSize="16" Foreground="#7F8C8D" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- ══════════════ CARDS + UPLOAD + LOGOUT ══════════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" BorderThickness="0">
            <StackPanel>

                <!-- Upload strip — slim, inline, same feel as payroll cards -->
                <Border Background="White" CornerRadius="12" Padding="20,16"
                        Margin="0,0,0,28" BorderThickness="0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Color="#E0E0E0" Opacity="0.6" ShadowDepth="3"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="📂  Upload Student Fee Data"
                                       FontSize="16" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="Upload an Excel file containing the current semester's student fee records."
                                       FontSize="12" Foreground="#95A5A6" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Upload Excel File"
                                Command="{Binding UploadCsvCommand}"
                                Width="180" Height="40"
                                Background="#2563EB" Foreground="White"
                                BorderThickness="0" Cursor="Hand"
                                FontSize="13" FontWeight="SemiBold">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="8"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1E3A8A"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <!-- ── Navigation cards — exact same template as PayrollDashboardView ── -->
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">

                    <!-- Manage Classes -->
                    <Button Command="{Binding ShowClassesCommand}"
                            Width="220" Height="140" Margin="0,0,20,20"
                            Background="White" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="12"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="15" Color="#E0E0E0"
                                                          Opacity="0.6" ShadowDepth="3"/>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Resources>
                        <StackPanel>
                            <TextBlock Text="📚" FontSize="36"
                                       HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Manage Classes"
                                       FontWeight="Bold" FontSize="16"
                                       Foreground="#2C3E50" HorizontalAlignment="Center"/>
                            <TextBlock Text="View &amp; edit class data"
                                       FontSize="12" Foreground="#95A5A6"
                                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Collect Fees -->
                    <Button Command="{Binding ShowFeeCollectionCommand}"
                            Width="220" Height="140" Margin="0,0,20,20"
                            Background="White" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="12"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="15" Color="#E0E0E0"
                                                          Opacity="0.6" ShadowDepth="3"/>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Resources>
                        <StackPanel>
                            <TextBlock Text="💰" FontSize="36"
                                       HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Collect Fees"
                                       FontWeight="Bold" FontSize="16"
                                       Foreground="#2C3E50" HorizontalAlignment="Center"/>
                            <TextBlock Text="Process payments &amp; pending fees"
                                       FontSize="12" Foreground="#95A5A6"
                                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Scholarships -->
                    <Button Command="{Binding ShowScholarshipsCommand}"
                            Width="220" Height="140" Margin="0,0,20,20"
                            Background="White" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="12"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="15" Color="#E0E0E0"
                                                          Opacity="0.6" ShadowDepth="3"/>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Resources>
                        <StackPanel>
                            <TextBlock Text="🎓" FontSize="36"
                                       HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Scholarships"
                                       FontWeight="Bold" FontSize="16"
                                       Foreground="#2C3E50" HorizontalAlignment="Center"/>
                            <TextBlock Text="Manage fee concessions"
                                       FontSize="12" Foreground="#95A5A6"
                                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Generate Reports -->
                    <Button Command="{Binding ShowReportsCommand}"
                            Width="220" Height="140" Margin="0,0,20,20"
                            Background="White" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="12"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="15" Color="#E0E0E0"
                                                          Opacity="0.6" ShadowDepth="3"/>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Resources>
                        <StackPanel>
                            <TextBlock Text="📊" FontSize="36"
                                       HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Generate Reports"
                                       FontWeight="Bold" FontSize="16"
                                       Foreground="#2C3E50" HorizontalAlignment="Center"/>
                            <TextBlock Text="Create PDF reports"
                                       FontSize="12" Foreground="#95A5A6"
                                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Payment History -->
                    <Button Command="{Binding ShowPaymentHistoryCommand}"
                            Width="220" Height="140" Margin="0,0,20,20"
                            Background="White" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="12"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="15" Color="#E0E0E0"
                                                          Opacity="0.6" ShadowDepth="3"/>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Resources>
                        <StackPanel>
                            <TextBlock Text="🧾" FontSize="36"
                                       HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Payment History"
                                       FontWeight="Bold" FontSize="16"
                                       Foreground="#2C3E50" HorizontalAlignment="Center"/>
                            <TextBlock Text="View student transactions"
                                       FontSize="12" Foreground="#95A5A6"
                                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Fine Management -->
                    <Button Command="{Binding ShowFineManagementCommand}"
                            Width="220" Height="140" Margin="0,0,20,20"
                            Background="White" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="12"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="15" Color="#E0E0E0"
                                                          Opacity="0.6" ShadowDepth="3"/>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Resources>
                        <StackPanel>
                            <TextBlock Text="⚠️" FontSize="36"
                                       HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Fine Management"
                                       FontWeight="Bold" FontSize="16"
                                       Foreground="#2C3E50" HorizontalAlignment="Center"/>
                            <TextBlock Text="Manage late payment fines"
                                       FontSize="12" Foreground="#95A5A6"
                                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Button>

                </WrapPanel>

                <!-- ── Logout — slim link at the bottom, same quiet style ── -->
                <Button Content="🚪  Logout"
                        Command="{Binding LogoutCommand}"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#E74C3C"
                        FontWeight="Bold"
                        FontSize="14"
                        Cursor="Hand"
                        Margin="0,10,0,0"
                        Padding="5">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}"
                                                CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#C0392B"/>
                                    <Setter Property="Background" Value="#FEE2E2"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>
