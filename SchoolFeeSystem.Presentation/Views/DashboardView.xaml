<UserControl x:Class="SchoolFeeSystem.Presentation.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <!-- COLORS -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="#64748B"/>

        <!-- MODERN CARD STYLE -->
        <Style x:Key="ModernCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="30"/>
            <Setter Property="Margin" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18"
                                      ShadowDepth="0"
                                      Opacity="0.15"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.03" ScaleY="1.03"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="25"
                                              ShadowDepth="0"
                                              Opacity="0.25"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="46"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>

        <Style x:Key="CardSubTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

    </UserControl.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <Border Grid.Row="0" Padding="40,35">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1E3A8A" Offset="0"/>
                    <GradientStop Color="#2563EB" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- BACK BUTTON -->
                <Border Grid.Column="0"
                        Padding="12"
                        CornerRadius="12"
                        Background="White"
                        BorderBrush="{StaticResource PrimaryBrush}"
                        BorderThickness="2"
                        Cursor="Hand"
                        VerticalAlignment="Center">

                    <Border.InputBindings>
                        <MouseBinding Command="{Binding GoBackToMainCommand}" MouseAction="LeftClick"/>
                    </Border.InputBindings>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🏠" FontSize="20" Margin="0,0,6,0"/>
                        <TextBlock Text="Back"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- TITLE -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="🏫 School Fee Management System"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Dashboard"
                               FontSize="18"
                               Foreground="#E0E7FF"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- ================= MAIN CONTENT ================= -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="50">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Upload Section -->
                <Border Grid.Row="0"
                        CornerRadius="20"
                        Padding="40"
                        Background="White">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25"
                                          ShadowDepth="0"
                                          Opacity="0.12"/>
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock Text="Upload Student Fee Data"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"/>

                        <TextBlock Text="Upload your Excel file containing complete student fee records."
                                   Margin="0,10,0,25"
                                   Foreground="{StaticResource SubTextBrush}"
                                   FontSize="14"
                                   TextWrapping="Wrap"/>

                        <Button Content="Upload Excel File"
                                Command="{Binding UploadCsvCommand}"
                                Padding="22,14"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Background="{StaticResource PrimaryBrush}"
                                Foreground="White"
                                BorderThickness="0"
                                Width="240"
                                HorizontalAlignment="Center"
                                Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <!-- MENU GRID -->
                <UniformGrid Grid.Row="2" Columns="3" Margin="0,20,0,20">

                    <!-- Manage Classes -->
                    <Border Style="{StaticResource ModernCardStyle}">
                        <Border.InputBindings>
                            <MouseBinding Command="{Binding ShowClassesCommand}" MouseAction="LeftClick"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="📚" Style="{StaticResource IconStyle}"/>
                            <TextBlock Text="Manage Classes" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="View and edit class data"
                                       Style="{StaticResource CardSubTextStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Collect Fees -->
                    <Border Style="{StaticResource ModernCardStyle}">
                        <Border.InputBindings>
                            <MouseBinding Command="{Binding ShowFeeCollectionCommand}" MouseAction="LeftClick"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="💰" Style="{StaticResource IconStyle}"/>
                            <TextBlock Text="Collect Fees" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Process payments and manage pending fees"
                                       Style="{StaticResource CardSubTextStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Scholarships -->
                    <Border Style="{StaticResource ModernCardStyle}">
                        <Border.InputBindings>
                            <MouseBinding Command="{Binding ShowScholarshipsCommand}" MouseAction="LeftClick"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="🎓" Style="{StaticResource IconStyle}"/>
                            <TextBlock Text="Scholarships" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Manage fee concessions"
                                       Style="{StaticResource CardSubTextStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Reports -->
                    <Border Style="{StaticResource ModernCardStyle}">
                        <Border.InputBindings>
                            <MouseBinding Command="{Binding ShowReportsCommand}" MouseAction="LeftClick"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="📊" Style="{StaticResource IconStyle}"/>
                            <TextBlock Text="Generate Reports" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Create PDF reports"
                                       Style="{StaticResource CardSubTextStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Payment History -->
                    <Border Style="{StaticResource ModernCardStyle}">
                        <Border.InputBindings>
                            <MouseBinding Command="{Binding ShowPaymentHistoryCommand}" MouseAction="LeftClick"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="🧾" Style="{StaticResource IconStyle}"/>
                            <TextBlock Text="Payment History" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="View student transactions"
                                       Style="{StaticResource CardSubTextStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Fine Management -->
                    <Border Style="{StaticResource ModernCardStyle}">
                        <Border.InputBindings>
                            <MouseBinding Command="{Binding ShowFineManagementCommand}" MouseAction="LeftClick"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="⚠️" Style="{StaticResource IconStyle}"/>
                            <TextBlock Text="Fine Management" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Manage late payment fines"
                                       Style="{StaticResource CardSubTextStyle}"/>
                        </StackPanel>
                    </Border>

                </UniformGrid>

            </Grid>
        </ScrollViewer>

        <!-- LOGOUT -->
        <Grid Grid.Row="2" Margin="30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="1"
                    Padding="15"
                    CornerRadius="12"
                    Background="White"
                    BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="2"
                    Cursor="Hand">

                <Border.InputBindings>
                    <MouseBinding Command="{Binding LogoutCommand}" MouseAction="LeftClick"/>
                </Border.InputBindings>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🚪" FontSize="20" Margin="0,0,6,0"/>
                    <TextBlock Text="Logout"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource DangerBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>