<UserControl x:Class="SchoolFeeSystem.Presentation.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#2C3E50">
            <StackPanel Margin="10">
                <TextBlock Text="ADMIN PANEL" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,30" HorizontalAlignment="Center"/>
                <Button Content="Manage Classes" Command="{Binding ShowClassesCommand}" Height="40" Margin="0,5" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" FontSize="14" Padding="10,0"/>
                <Button Content="Manage Students" Command="{Binding ShowStudentsCommand}" Height="40" Margin="0,5" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" FontSize="14" Padding="10,0"/>
                <Button Content="Fee Structure Setup" Command="{Binding ShowFeesCommand}" Height="40" Margin="0,5" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" FontSize="14" Padding="10,0"/>
                <Button Content="Collect Fees" Command="{Binding ShowFeeCollectionCommand}" Height="40" Margin="0,5" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" FontSize="14" Padding="10,0"/>
                <Button Content="Reports" Command="{Binding ShowReportsCommand}" Height="40" Margin="0,5" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" FontSize="14" Padding="10,0"/>
                <Button Content="Customer Help" Command="{Binding ShowHelpCommand}" Height="40" Margin="0,5" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" FontSize="14" Padding="10,0"/>
                <Button Content="⬅ Back to Hub" Command="{Binding GoBackCommand}" Height="40" Margin="0,40,0,5" Background="#34495E" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
                <Button Content="Logout" Command="{Binding LogoutCommand}" Height="40" Margin="0,50,0,0" Background="#E74C3C" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </Border>
        <Border Grid.Column="1" Background="#ECF0F1">
            <ContentControl Content="{Binding CurrentView}" Margin="20" FontSize="16"/>
        </Border>
    </Grid>
</UserControl>