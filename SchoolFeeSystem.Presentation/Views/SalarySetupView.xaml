<UserControl x:Class="SchoolFeeSystem.Presentation.Views.SalarySetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1200" Background="#0F172A">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="IconBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,15,15"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Command="{Binding GoBackCommand}" Style="{StaticResource IconBtnStyle}" VerticalAlignment="Center" Margin="0,0,15,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⬅" FontSize="20" FontWeight="Bold" Margin="0,0,5,0"/>
                    <TextBlock Text="Back to Dashboard" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock Text="Salary Setup &amp; Configuration" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                <TextBlock Text="Manage allowances, deductions, and pay grades" Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#1E293B" CornerRadius="10" Padding="15" Margin="0,0,20,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Height="35"/>
                        <Button Grid.Column="1" Content="🔍" Command="{Binding SearchStaffCommand}" Width="40" Background="#3B82F6" Foreground="White" BorderThickness="0" Margin="5,0,0,0"/>
                    </Grid>

                    <ListBox Grid.Row="1" ItemsSource="{Binding EmployeeList}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Name="Border" Padding="10" Margin="0,0,0,5" CornerRadius="6" Background="Transparent" Cursor="Hand">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#334155"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#3B82F6"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="18" Background="#475569" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding FirstName[0]}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FullName}" Foreground="White" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Designation}" Foreground="#94A3B8" FontSize="11"/>
                                    </StackPanel>
                                    <Button Grid.ColumnSpan="2" Command="{Binding DataContext.SelectEmployeeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" Opacity="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                        <Button Content="◀" Command="{Binding PreviousPageCommand}" Style="{StaticResource IconBtnStyle}" FontSize="16" Margin="0,0,15,0"/>
                        <TextBlock Text="{Binding PaginationDisplay}" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <Button Content="▶" Command="{Binding NextPageCommand}" Style="{StaticResource IconBtnStyle}" FontSize="16" Margin="15,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsEmployeeSelected, Converter={StaticResource BoolToVis}, ConverterParameter=Inverted}">
                    <TextBlock Text="👆" FontSize="40" HorizontalAlignment="Center" Foreground="#475569"/>
                    <TextBlock Text="Select an employee from the list" FontSize="18" Foreground="#64748B" Margin="0,10,0,0"/>
                    <TextBlock Text="to configure their salary structure." FontSize="14" Foreground="#475569"/>
                </StackPanel>

                <ScrollViewer Visibility="{Binding IsEmployeeSelected, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}" BorderBrush="#3B82F6" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedEmployee.FullName}" FontSize="22" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="{Binding SelectedEmployee.Email}" Foreground="#94A3B8"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Base Salary" Foreground="#94A3B8" FontSize="11"/>
                                        <TextBox Text="{Binding BaseSalary, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                    </StackPanel>

                                    <Button Content="⚡ Auto-Calc Structure" Command="{Binding ApplyGlobalRulesCommand}" 
                                            VerticalAlignment="Bottom" Height="32" Margin="0,0,20,1"
                                            Background="#8B5CF6" Foreground="White" BorderThickness="0" Padding="12,0" FontWeight="Bold">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <StackPanel>
                                        <TextBlock Text="Pay Grade" Foreground="#94A3B8" FontSize="11"/>
                                        <ComboBox Text="{Binding PayGrade}" Width="120" Padding="5"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="➕ Allowances" Foreground="#22C55E" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <ItemsControl ItemsSource="{Binding AllowancesList}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" Foreground="White"/>
                                                    <TextBlock Text="{Binding Amount, StringFormat={}{0:C0}}" Foreground="#22C55E" FontWeight="Bold" Grid.Column="1" Margin="10,0"/>
                                                    <Button Grid.Column="2" Content="❌" Command="{Binding DataContext.RemoveAllowanceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                            CommandParameter="{Binding}" Foreground="#EF4444" Background="Transparent" BorderThickness="0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Separator Background="#334155" Margin="0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding NewAllowanceName}" Margin="0,0,5,0"/>
                                        <TextBox Text="{Binding NewAllowanceAmount}" Grid.Column="1" Margin="0,0,5,0"/>
                                        <Button Grid.Column="2" Content="+" Command="{Binding AddAllowanceCommand}" Background="#22C55E" Foreground="White" BorderThickness="0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="➖ Deductions" Foreground="#EF4444" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <ItemsControl ItemsSource="{Binding DeductionsList}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" Foreground="White"/>
                                                    <TextBlock Text="{Binding Amount, StringFormat={}{0:C0}}" Foreground="#EF4444" FontWeight="Bold" Grid.Column="1" Margin="10,0"/>
                                                    <Button Grid.Column="2" Content="❌" Command="{Binding DataContext.RemoveDeductionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                            CommandParameter="{Binding}" Foreground="#EF4444" Background="Transparent" BorderThickness="0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Separator Background="#334155" Margin="0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding NewDeductionName}" Margin="0,0,5,0"/>
                                        <TextBox Text="{Binding NewDeductionAmount}" Grid.Column="1" Margin="0,0,5,0"/>
                                        <Button Grid.Column="2" Content="+" Command="{Binding AddDeductionCommand}" Background="#EF4444" Foreground="White" BorderThickness="0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Net Pay: " Foreground="#94A3B8" FontSize="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding NetPay, StringFormat={}{0:C0}}" Foreground="#3B82F6" FontWeight="Bold" FontSize="24" Margin="5,0,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="💾 Save Changes" Command="{Binding SaveChangesCommand}" Background="#3B82F6" Foreground="White" Padding="20,10" BorderThickness="0" FontWeight="Bold">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>