<UserControl x:Class="SchoolFeeSystem.Presentation.Views.SalarySetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1400" 
             Background="#0F172A">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Card Style -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <!-- Input Style -->
        <Style x:Key="ModernInput" TargetType="TextBox">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Label Style -->
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================================ -->
        <!-- HEADER -->
        <!-- ============================================ -->
        <Grid Grid.Row="0" Margin="0,0,0,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" 
                    Command="{Binding GoBackCommand}" 
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    VerticalAlignment="Center" 
                    Margin="0,0,20,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⬅" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               Margin="0,0,8,0" 
                               Foreground="White"/>
                    <TextBlock Text="Back to Dashboard" 
                               FontSize="16" 
                               VerticalAlignment="Center" 
                               Foreground="White"/>
                </StackPanel>
            </Button>

            <StackPanel Grid.Column="1" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center">
                <TextBlock Text="💰 Incentives &amp; Deductions Manager" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="White" 
                           HorizontalAlignment="Right"/>
                <TextBlock Text="Manage monthly incentives and deductions for employees" 
                           Foreground="#94A3B8" 
                           FontSize="13" 
                           HorizontalAlignment="Right" 
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ============================================ -->
        <!-- MAIN CONTENT -->
        <!-- ============================================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============================================ -->
            <!-- LEFT SIDEBAR: Employee List -->
            <!-- ============================================ -->
            <Border Grid.Column="0" 
                    Style="{StaticResource Card}" 
                    Margin="0,0,20,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Search Header -->
                    <TextBlock Grid.Row="0" 
                               Text="👥 Select Employee" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Foreground="White" 
                               Margin="0,0,0,15"/>

                    <!-- Search Box -->
                    <Grid Grid.Row="1" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Style="{StaticResource ModernInput}"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"
                                 Height="42"/>

                        <Button Grid.Column="1" 
                                Content="🔍" 
                                Command="{Binding SearchStaffCommand}" 
                                Width="42" 
                                Height="42"
                                Background="#3B82F6" 
                                Foreground="White" 
                                BorderThickness="0" 
                                Margin="8,0,0,0"
                                Cursor="Hand"
                                FontSize="16">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Employee List -->
                    <ScrollViewer Grid.Row="2" 
                                  VerticalScrollBarVisibility="Auto" 
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding EmployeeList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent" 
                                            Margin="0,0,0,8" 
                                            CornerRadius="8" 
                                            Cursor="Hand"
                                            MouseLeftButtonDown="EmployeeCard_Click"
                                            Tag="{Binding}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#334155"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#475569"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid Margin="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Avatar -->
                                            <Border Grid.Column="0" 
                                                    Width="45" 
                                                    Height="45" 
                                                    CornerRadius="23" 
                                                    Background="#3B82F6" 
                                                    Margin="0,0,12,0">
                                                <TextBlock Text="{Binding FirstName, StringFormat={}{0:1}}" 
                                                          FontSize="18" 
                                                          FontWeight="Bold" 
                                                          Foreground="White" 
                                                          HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FullName}" 
                                                          FontWeight="SemiBold" 
                                                          FontSize="14" 
                                                          Foreground="White"/>
                                                <TextBlock Text="{Binding Department}" 
                                                          FontSize="12" 
                                                          Foreground="#94A3B8" 
                                                          Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Pagination -->
                    <Grid Grid.Row="3" Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" 
                                Content="◀ Prev" 
                                Command="{Binding PreviousPageCommand}" 
                                Background="#475569" 
                                Foreground="White" 
                                BorderThickness="0" 
                                Padding="12,8" 
                                Cursor="Hand"
                                FontSize="12">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="6" 
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <TextBlock Grid.Column="1" 
                                   Text="{Binding PaginationDisplay}" 
                                   FontSize="12" 
                                   Foreground="#94A3B8" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="2" 
                                Content="Next ▶" 
                                Command="{Binding NextPageCommand}" 
                                Background="#475569" 
                                Foreground="White" 
                                BorderThickness="0" 
                                Padding="12,8" 
                                Cursor="Hand"
                                FontSize="12">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="6" 
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- ============================================ -->
            <!-- RIGHT PANEL: Employee Details & Management -->
            <!-- ============================================ -->
            <Border Grid.Column="1" 
                    Style="{StaticResource Card}"
                    Visibility="{Binding IsEmployeeSelected, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Employee Header Card -->
                        <Border Background="#334155" 
                                CornerRadius="10" 
                                Padding="20" 
                                Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Avatar -->
                                <Border Grid.Column="0" 
                                        Width="70" 
                                        Height="70" 
                                        CornerRadius="35" 
                                        Background="#3B82F6" 
                                        Margin="0,0,20,0">
                                    <TextBlock Text="{Binding SelectedEmployee.FirstName, StringFormat={}{0:1}}" 
                                              FontSize="28" 
                                              FontWeight="Bold" 
                                              Foreground="White" 
                                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                                </Border>

                                <!-- Employee Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedEmployee.FullName}" 
                                              FontSize="22" 
                                              FontWeight="Bold" 
                                              Foreground="White"/>
                                    <TextBlock FontSize="14" 
                                              Foreground="#94A3B8" 
                                              Margin="0,4,0,0">
                                        <Run Text="{Binding SelectedEmployee.Department}"/>
                                        <Run Text=" • "/>
                                        <Run Text="{Binding SelectedEmployee.BiometricId}"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Basic Salary Display (Read-Only) -->
                                <Border Grid.Column="2" 
                                        Background="#1E293B" 
                                        CornerRadius="8" 
                                        Padding="15"
                                        VerticalAlignment="Center">
                                    <StackPanel>
                                        <TextBlock Text="Basic Salary" 
                                                  FontSize="11" 
                                                  Foreground="#94A3B8" 
                                                  TextAlignment="Center"/>
                                        <TextBlock FontSize="20" 
                                                  FontWeight="Bold" 
                                                  Foreground="#10B981" 
                                                  TextAlignment="Center"
                                                  Margin="0,4,0,0">
                                            <Run Text="₹"/>
                                            <Run Text="{Binding BaseSalary, StringFormat=N0}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Incentives & Deductions Section -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- INCENTIVES (Left) -->
                            <Border Grid.Column="0" 
                                    Background="#334155" 
                                    CornerRadius="10" 
                                    Padding="20">
                                <StackPanel>
                                    <!-- Header -->
                                    <Grid Margin="0,0,0,15">
                                        <TextBlock Text="➕ Monthly Incentives" 
                                                  FontSize="16" 
                                                  FontWeight="Bold" 
                                                  Foreground="#10B981" 
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"/>
                                        <Border Background="#10B981" 
                                                CornerRadius="6" 
                                                Padding="10,5"
                                                HorizontalAlignment="Right">
                                            <TextBlock FontSize="14" 
                                                      FontWeight="Bold" 
                                                      Foreground="White">
                                                <Run Text="₹"/>
                                                <Run Text="{Binding TotalAllowances, StringFormat=N2}"/>
                                            </TextBlock>
                                        </Border>
                                    </Grid>

                                    <!-- Add Incentive Form -->
                                    <Border Background="#1E293B" 
                                            CornerRadius="8" 
                                            Padding="15" 
                                            Margin="0,0,0,15">
                                        <StackPanel>
                                            <TextBlock Text="Incentive Name" 
                                                      Style="{StaticResource Label}"/>
                                            <TextBox Style="{StaticResource ModernInput}" 
                                                    Text="{Binding NewAllowanceName, UpdateSourceTrigger=PropertyChanged}" 
                                                    Margin="0,0,0,10"/>

                                            <TextBlock Text="Amount (₹)" 
                                                      Style="{StaticResource Label}"/>
                                            <TextBox Style="{StaticResource ModernInput}" 
                                                    Text="{Binding NewAllowanceAmount, UpdateSourceTrigger=PropertyChanged}" 
                                                    Margin="0,0,0,12"/>

                                            <Button Content="➕ Add Incentive" 
                                                   Command="{Binding AddAllowanceCommand}" 
                                                   Style="{StaticResource ModernButton}"
                                                   Background="#10B981"
                                                   HorizontalAlignment="Stretch"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Incentives List -->
                                    <ScrollViewer MaxHeight="300" 
                                                 VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding AllowancesList}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#1E293B" 
                                                           CornerRadius="6" 
                                                           Padding="12" 
                                                           Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0" 
                                                                      Text="{Binding Name}" 
                                                                      Foreground="White" 
                                                                      FontSize="13" 
                                                                      VerticalAlignment="Center"/>

                                                            <TextBlock Grid.Column="1" 
                                                                      FontSize="14" 
                                                                      FontWeight="Bold" 
                                                                      Foreground="#10B981" 
                                                                      VerticalAlignment="Center"
                                                                      Margin="0,0,10,0">
                                                                <Run Text="₹"/>
                                                                <Run Text="{Binding Amount, StringFormat=N2}"/>
                                                            </TextBlock>

                                                            <Button Grid.Column="2" 
                                                                   Content="🗑" 
                                                                   Command="{Binding DataContext.RemoveAllowanceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                                                   CommandParameter="{Binding}" 
                                                                   Background="#EF4444" 
                                                                   Foreground="White" 
                                                                   BorderThickness="0" 
                                                                   Padding="8,4" 
                                                                   Cursor="Hand"
                                                                   FontSize="12">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}" 
                                                                               CornerRadius="4" 
                                                                               Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            <!-- DEDUCTIONS (Right) -->
                            <Border Grid.Column="2" 
                                    Background="#334155" 
                                    CornerRadius="10" 
                                    Padding="20">
                                <StackPanel>
                                    <!-- Header -->
                                    <Grid Margin="0,0,0,15">
                                        <TextBlock Text="➖ Monthly Deductions" 
                                                  FontSize="16" 
                                                  FontWeight="Bold" 
                                                  Foreground="#EF4444" 
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"/>
                                        <Border Background="#EF4444" 
                                                CornerRadius="6" 
                                                Padding="10,5"
                                                HorizontalAlignment="Right">
                                            <TextBlock FontSize="14" 
                                                      FontWeight="Bold" 
                                                      Foreground="White">
                                                <Run Text="₹"/>
                                                <Run Text="{Binding TotalDeductions, StringFormat=N2}"/>
                                            </TextBlock>
                                        </Border>
                                    </Grid>

                                    <!-- Add Deduction Form -->
                                    <Border Background="#1E293B" 
                                            CornerRadius="8" 
                                            Padding="15" 
                                            Margin="0,0,0,15">
                                        <StackPanel>
                                            <TextBlock Text="Deduction Name" 
                                                      Style="{StaticResource Label}"/>
                                            <TextBox Style="{StaticResource ModernInput}" 
                                                    Text="{Binding NewDeductionName, UpdateSourceTrigger=PropertyChanged}" 
                                                    Margin="0,0,0,10"/>

                                            <TextBlock Text="Amount (₹)" 
                                                      Style="{StaticResource Label}"/>
                                            <TextBox Style="{StaticResource ModernInput}" 
                                                    Text="{Binding NewDeductionAmount, UpdateSourceTrigger=PropertyChanged}" 
                                                    Margin="0,0,0,12"/>

                                            <Button Content="➖ Add Deduction" 
                                                   Command="{Binding AddDeductionCommand}" 
                                                   Style="{StaticResource ModernButton}"
                                                   Background="#EF4444"
                                                   HorizontalAlignment="Stretch"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Deductions List -->
                                    <ScrollViewer MaxHeight="300" 
                                                 VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding DeductionsList}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#1E293B" 
                                                           CornerRadius="6" 
                                                           Padding="12" 
                                                           Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0" 
                                                                      Text="{Binding Name}" 
                                                                      Foreground="White" 
                                                                      FontSize="13" 
                                                                      VerticalAlignment="Center"/>

                                                            <TextBlock Grid.Column="1" 
                                                                      FontSize="14" 
                                                                      FontWeight="Bold" 
                                                                      Foreground="#EF4444" 
                                                                      VerticalAlignment="Center"
                                                                      Margin="0,0,10,0">
                                                                <Run Text="₹"/>
                                                                <Run Text="{Binding Amount, StringFormat=N2}"/>
                                                            </TextBlock>

                                                            <Button Grid.Column="2" 
                                                                   Content="🗑" 
                                                                   Command="{Binding DataContext.RemoveDeductionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                                                   CommandParameter="{Binding}" 
                                                                   Background="#EF4444" 
                                                                   Foreground="White" 
                                                                   BorderThickness="0" 
                                                                   Padding="8,4" 
                                                                   Cursor="Hand"
                                                                   FontSize="12">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}" 
                                                                               CornerRadius="4" 
                                                                               Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Summary & Save -->
                        <Border Background="#334155" 
                                CornerRadius="10" 
                                Padding="20" 
                                Margin="0,20,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Summary -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="📊 Monthly Summary" 
                                              FontSize="16" 
                                              FontWeight="Bold" 
                                              Foreground="White" 
                                              Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" 
                                                  Text="Basic:" 
                                                  Foreground="#94A3B8" 
                                                  FontSize="14" 
                                                  Margin="0,0,5,0"/>
                                        <TextBlock Grid.Column="1" 
                                                  FontSize="14" 
                                                  FontWeight="SemiBold" 
                                                  Foreground="White" 
                                                  Margin="0,0,15,0">
                                            <Run Text="₹"/>
                                            <Run Text="{Binding BaseSalary, StringFormat=N0}"/>
                                        </TextBlock>

                                        <TextBlock Grid.Column="2" 
                                                  Text="+ Incentives:" 
                                                  Foreground="#10B981" 
                                                  FontSize="14" 
                                                  Margin="0,0,5,0"/>
                                        <TextBlock Grid.Column="3" 
                                                  FontSize="14" 
                                                  FontWeight="SemiBold" 
                                                  Foreground="#10B981" 
                                                  Margin="0,0,15,0">
                                            <Run Text="₹"/>
                                            <Run Text="{Binding TotalAllowances, StringFormat=N2}"/>
                                        </TextBlock>

                                        <TextBlock Grid.Column="4" 
                                                  Text="- Deductions:" 
                                                  Foreground="#EF4444" 
                                                  FontSize="14" 
                                                  Margin="0,0,5,0"/>
                                        <TextBlock Grid.Column="5" 
                                                  FontSize="14" 
                                                  FontWeight="SemiBold" 
                                                  Foreground="#EF4444">
                                            <Run Text="₹"/>
                                            <Run Text="{Binding TotalDeductions, StringFormat=N2}"/>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>

                                <!-- Save Button -->
                                <Button Grid.Column="1" 
                                       Content="💾 Save Changes" 
                                       Command="{Binding SaveChangesCommand}" 
                                       Style="{StaticResource ModernButton}"
                                       Background="#10B981"
                                       FontSize="15"
                                       Padding="25,12"/>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Empty State -->
            <Border Grid.Column="1" 
                    Style="{StaticResource Card}"
                    Visibility="{Binding IsEmployeeSelected, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                <StackPanel HorizontalAlignment="Center" 
                           VerticalAlignment="Center">
                    <TextBlock Text="👈" 
                              FontSize="60" 
                              HorizontalAlignment="Center" 
                              Margin="0,0,0,20"/>
                    <TextBlock Text="Select an employee from the list" 
                              FontSize="18" 
                              FontWeight="SemiBold" 
                              Foreground="White" 
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="to configure their monthly incentives &amp; deductions" 
                              FontSize="14" 
                              Foreground="#94A3B8" 
                              HorizontalAlignment="Center" 
                              Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

        </Grid>
    </Grid>
</UserControl>
