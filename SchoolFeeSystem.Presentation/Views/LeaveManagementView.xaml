<UserControl x:Class="SchoolFeeSystem.Presentation.Views.LeaveManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Button Content="← Back" 
                    Command="{Binding GoBackCommand}"
                    Background="#2C3E50" 
                    Foreground="White"
                    Padding="15,8"
                    Margin="0,0,20,0"
                    BorderThickness="0"
                    Cursor="Hand"/>

            <TextBlock Text="Leave Management" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="#2C3E50"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: Grant Leave Form -->
            <Border Grid.Column="0" 
                    Background="White" 
                    BorderBrush="#BDC3C7" 
                    BorderThickness="1" 
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,10,0">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Grant Leave" 
                                   FontSize="20" 
                                   FontWeight="SemiBold" 
                                   Foreground="#34495E"
                                   Margin="0,0,0,20"/>

                        <!-- ✅ NEW: Employee Search Section -->
                        <Border Background="#ECF0F1" 
                                BorderBrush="#95A5A6" 
                                BorderThickness="1" 
                                CornerRadius="5" 
                                Padding="12"
                                Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="🔍 Search Employee" 
                                           FontWeight="SemiBold" 
                                           FontSize="13"
                                           Foreground="#34495E"
                                           Margin="0,0,0,8"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Height="32"
                                             VerticalContentAlignment="Center"
                                             Padding="8,0"
                                             Margin="0,0,5,0">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding SearchEmployeeCommand}"/>
                                        </TextBox.InputBindings>
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Background" Value="#FAFAFA"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>

                                    <Button Grid.Column="1"
                                            Content="🔍"
                                            Command="{Binding SearchEmployeeCommand}"
                                            Background="#3498DB"
                                            Foreground="White"
                                            FontSize="14"
                                            Width="45"
                                            Height="32"
                                            Margin="0,0,5,0"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            ToolTip="Search by name or ID"/>

                                    <Button Grid.Column="2"
                                            Content="✕"
                                            Command="{Binding ClearSearchCommand}"
                                            Background="#95A5A6"
                                            Foreground="White"
                                            FontSize="14"
                                            Width="45"
                                            Height="32"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            ToolTip="Clear search"/>
                                </Grid>

                                <TextBlock Text="Press Enter or click 🔍 to search"
                                           FontSize="10"
                                           FontStyle="Italic"
                                           Foreground="#7F8C8D"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Employee Selection -->
                        <TextBlock Text="Select Employee" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding Employees}"
                                  SelectedItem="{Binding SelectedEmployee}"
                                  DisplayMemberPath="FullName"
                                  Height="35"
                                  Margin="0,0,0,15"/>

                        <!-- Company Gate Pass Info -->
                        <Border Background="#FFF3E0" 
                                BorderBrush="#F57C00" 
                                BorderThickness="2" 
                                CornerRadius="8" 
                                Padding="12"
                                Margin="0,0,0,15"
                                Visibility="{Binding HasGatePassAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="🎫 Company Gate Pass" 
                                           FontWeight="Bold" 
                                           FontSize="14"
                                           Foreground="#E65100"
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding GatePassStatus}" 
                                           FontWeight="SemiBold" 
                                           FontSize="16"
                                           Foreground="#F57C00"/>
                                <TextBlock Text="Priority: Used FIRST before personal allowance" 
                                           FontSize="11"
                                           FontStyle="Italic"
                                           Foreground="#666"
                                           Margin="0,3,0,0"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="⚠️ Max 2 uses per month"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#D84315"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Personal Allowance Time Info -->
                        <Border Background="#E8F5E9" 
                                BorderBrush="#4CAF50" 
                                BorderThickness="1" 
                                CornerRadius="5" 
                                Padding="10"
                                Margin="0,0,0,15"
                                Visibility="{Binding HasAllowanceTime, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="💰 Personal Allowance Time" 
                                           FontWeight="SemiBold" 
                                           Foreground="#2E7D32"/>
                                <TextBlock>
                                    <Run Text="Available: "/>
                                    <Run Text="{Binding AvailableAllowanceHours, StringFormat='{}{0:F2} hours'}" 
                                         FontWeight="Bold" 
                                         Foreground="#2E7D32"/>
                                </TextBlock>
                                <TextBlock Text="Used after Company Gate Pass"
                                           FontSize="10"
                                           FontStyle="Italic"
                                           Foreground="#666"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Leave Date -->
                        <TextBlock Text="Leave Date" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding LeaveDate}"
                                    Height="35"
                                    Margin="0,0,0,15"/>

                        <!-- Leave Type -->
                        <TextBlock Text="Leave Type" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding LeaveTypes}"
                                  SelectedItem="{Binding SelectedLeaveType}"
                                  DisplayMemberPath="Label"
                                  Height="35"
                                  Margin="0,0,0,15"/>

                        <!-- Custom Hours Section -->
                        <Border BorderBrush="#3498DB" 
                                BorderThickness="1" 
                                CornerRadius="5" 
                                Padding="10"
                                Margin="0,0,0,15">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedLeaveType.Key}" Value="Custom Hours">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="Custom Hours" 
                                           FontWeight="SemiBold" 
                                           Margin="0,0,0,10"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Start Time" FontSize="11" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding StartTime}"
                                                 Height="32"
                                                 VerticalContentAlignment="Center"
                                                 Padding="5,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" 
                                               Text="→" 
                                               FontSize="16" 
                                               VerticalAlignment="Center"
                                               Margin="10,15,10,0"/>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="End Time" FontSize="11" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding EndTime}"
                                                 Height="32"
                                                 VerticalContentAlignment="Center"
                                                 Padding="5,0"/>
                                    </StackPanel>
                                </Grid>

                                <Button Content="Calculate Hours"
                                        Click="CalculateCustomHours_Click"
                                        Background="#3498DB"
                                        Foreground="White"
                                        Height="30"
                                        Margin="0,10,0,10"
                                        BorderThickness="0"
                                        Cursor="Hand"/>

                                <Border Background="#E3F2FD" 
                                        BorderBrush="#2196F3" 
                                        BorderThickness="1" 
                                        CornerRadius="3" 
                                        Padding="8">
                                    <TextBlock>
                                        <Run Text="Total Hours: " FontWeight="SemiBold"/>
                                        <Run Text="{Binding CustomHours, StringFormat='{}{0:F2}'}" 
                                             FontWeight="Bold" 
                                             Foreground="#1976D2"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Leave Source Preview -->
                        <Border Background="#FFF9C4" 
                                BorderBrush="#FBC02D" 
                                BorderThickness="1" 
                                CornerRadius="5" 
                                Padding="10"
                                Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="💡 Leave Source Breakdown" 
                                           FontWeight="SemiBold" 
                                           FontSize="12"
                                           Foreground="#F57F17"
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding LeaveSourcePreview}" 
                                           FontSize="13"
                                           Foreground="#E65100"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Reason -->
                        <TextBlock Text="Reason *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Reason}"
                                 Height="60"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,15"/>

                        <!-- Remarks (Optional) -->
                        <TextBlock Text="Remarks (Optional)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Remarks}"
                                 Height="60"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,20"/>

                        <!-- Grant Leave Button -->
                        <Button Content="✓ Grant Leave"
                                Command="{Binding GrantLeaveCommand}"
                                Background="#27AE60"
                                Foreground="White"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Height="45"
                                BorderThickness="0"
                                Cursor="Hand"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RIGHT PANEL: Leave History -->
            <Border Grid.Column="1" 
                    Background="White" 
                    BorderBrush="#BDC3C7" 
                    BorderThickness="1" 
                    CornerRadius="8"
                    Padding="20"
                    Margin="10,0,0,0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Leave History" 
                                   FontSize="20" 
                                   FontWeight="SemiBold" 
                                   Foreground="#34495E"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="(Current Year)" 
                                       FontSize="12" 
                                       Foreground="#7F8C8D"
                                       VerticalAlignment="Center"
                                       Margin="0,0,15,0"/>

                            <Button Content="🔄 Refresh"
                                    Command="{Binding RefreshDataCommand}"
                                    Background="#3498DB"
                                    Foreground="White"
                                    Padding="10,5"
                                    Margin="0,0,5,0"
                                    BorderThickness="0"
                                    Cursor="Hand"/>

                            <Button Content="📊 Statistics"
                                    Command="{Binding ShowStatisticsCommand}"
                                    Background="#9B59B6"
                                    Foreground="White"
                                    Padding="10,5"
                                    Margin="0,0,5,0"
                                    BorderThickness="0"
                                    Cursor="Hand"/>

                            <Button Content="📄 Export"
                                    Command="{Binding ExportReportCommand}"
                                    Background="#16A085"
                                    Foreground="White"
                                    Padding="10,5"
                                    BorderThickness="0"
                                    Cursor="Hand"/>
                        </StackPanel>
                    </Grid>

                    <!-- Leave History DataGrid -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding LeaveHistory}"
                              SelectedItem="{Binding SelectedLeaveRecord}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              RowHeight="40"
                              Background="White"
                              BorderThickness="0">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" 
                                                Binding="{Binding LeaveDate, StringFormat='dd-MM-yyyy'}" 
                                                Width="100"/>
                            <DataGridTextColumn Header="Type" 
                                                Binding="{Binding LeaveType}" 
                                                Width="90"/>
                            <DataGridTextColumn Header="Hours" 
                                                Binding="{Binding LeaveHours, StringFormat='{}{0:F1}'}" 
                                                Width="60"/>
                            <DataGridTextColumn Header="Time" 
                                                Binding="{Binding StartTime}" 
                                                Width="80"/>
                            <DataGridTextColumn Header="Source" 
                                                Binding="{Binding LeaveSource}" 
                                                Width="*"/>
                            <DataGridTextColumn Header="Reason" 
                                                Binding="{Binding Reason}" 
                                                Width="*"/>
                            <DataGridTextColumn Header="Status" 
                                                Binding="{Binding Status}" 
                                                Width="80"/>
                        </DataGrid.Columns>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                        <Setter Property="Background" Value="#FFEBEE"/>
                                        <Setter Property="Foreground" Value="#C62828"/>
                                    </DataTrigger>
                                </Style.Triggers>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>

                    <!-- Cancel Button -->
                    <Button Grid.Row="2"
                            Content="✕ Cancel Selected Leave"
                            Command="{Binding CancelSelectedLeaveCommand}"
                            Background="#E74C3C"
                            Foreground="White"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Height="40"
                            Margin="0,15,0,0"
                            BorderThickness="0"
                            Cursor="Hand"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
