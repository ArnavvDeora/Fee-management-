<Window x:Class="SchoolFeeSystem.Presentation.Views.EditAttendanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Attendance Record" Height="450" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F8F9FA">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50" Padding="20">
            <StackPanel>
                <TextBlock Text="Edit Attendance" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="{Binding DateDisplay}" Foreground="#BDC3C7"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>

                <TextBlock Text="Employee Name" FontWeight="SemiBold" Foreground="Gray" Margin="0,0,0,5"/>
                <TextBox Text="{Binding EmployeeName}" IsReadOnly="True" Background="#EFEFEF" Padding="10" BorderThickness="0" Margin="0,0,0,15"/>

                <TextBlock Text="Attendance Status" FontWeight="SemiBold" Foreground="Gray" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding EditStatus}" 
                          Padding="10" Margin="0,0,0,15" Height="40" VerticalContentAlignment="Center"/>

                <TextBlock Text="In Time (HH:MM)" FontWeight="SemiBold" Foreground="Gray" Margin="0,0,0,5"/>
                <TextBox Text="{Binding EditInTime}" Padding="10" BorderBrush="#CCC" Margin="0,0,0,15"/>

                <TextBlock Text="Out Time (HH:MM)" FontWeight="SemiBold" Foreground="Gray" Margin="0,0,0,5"/>
                <TextBox Text="{Binding EditOutTime}" Padding="10" BorderBrush="#CCC" Margin="0,0,0,15"/>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                <Button Content="Cancel" 
                        Command="{Binding CancelCommand}" 
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Background="Transparent" Foreground="Gray" FontWeight="Bold" 
                        BorderThickness="0" Margin="0,0,10,0" Padding="10,5"/>

                <Button Content="💾 Save Changes" 
                        Command="{Binding SaveChangesCommand}" 
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Background="#27AE60" Foreground="White" FontWeight="Bold" 
                        Padding="15,8" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

    </Grid>
</Window>